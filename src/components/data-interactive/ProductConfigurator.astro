---
---

<section id="product-configurator" class="section config" data-variant="stepper" data-base-product="gid://shopify/Product/8812" data-base-price="189">
  <!-- kit: product-configurator -->
  <div class="container">
    <div class="config__grid">
      <div class="config__visual">
        <img src="https://picsum.photos/seed/cable-fold-kit/1600/1000" alt="The Cable Fold Grill folded flat beside its canvas sleeve" width="3200" height="2000" loading="lazy" />
      </div>

      <form class="config__form" action="/cart" method="post">
        <h2>Build your Cable Fold kit.</h2>
        <p class="lead">Start with the grate, add legs, then the pans you'll actually cook in. Everything packs flat into one sleeve.</p>

        <fieldset class="config__step" data-key="grate" data-selection="single">
          <legend><span class="config__num">1</span> Choose your grate</legend>
          <div class="config__cards">
            <label class="config__card" data-key="standard">
              <input type="radio" name="grate" value="standard" data-delta="0" checked required />
              <img src="https://picsum.photos/seed/grate-16/1600/1000" alt="The 16 inch Cable Fold grate over coals" width="3200" height="2000" loading="lazy" />
              <span class="config__card-body">
                <strong>Cable Fold 16"</strong>
                <span>Feeds four. Folds to 2 cm.</span>
                <span class="config__delta">Included</span>
              </span>
            </label>
            <label class="config__card" data-key="xl">
              <input type="radio" name="grate" value="xl" data-delta="60" data-variant-id="gid://shopify/Product/8812" />
              <img src="https://picsum.photos/seed/grate-22/1600/1000" alt="The 22 inch XL grate with two pans on it" width="3200" height="2000" loading="lazy" />
              <span class="config__card-body">
                <strong>Cable Fold XL 22"</strong>
                <span>Feeds eight. Takes the griddle plate.</span>
                <span class="config__delta">+$60</span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="config__step" data-key="legs" data-selection="single">
          <legend><span class="config__num">2</span> Pick the legs</legend>
          <div class="config__swatches">
            <label class="config__swatch">
              <input type="radio" name="legs" value="steel" data-delta="0" checked required />
              <span class="config__dot" style="background:#4B5563"></span>
              <span><strong>Folding steel</strong> <span class="config__delta">Included</span></span>
            </label>
            <label class="config__swatch is-soldout">
              <input type="radio" name="legs" value="titanium" data-delta="85" disabled />
              <span class="config__dot" style="background:#9CA3AF"></span>
              <span><strong>Titanium</strong> Saves 480 g · <span class="config__delta">+$85</span> <em>Sold out</em></span>
            </label>
          </div>
        </fieldset>

        <fieldset class="config__step" data-key="pans" data-selection="multiple" data-max-picks="3">
          <legend><span class="config__num">3</span> Add pans</legend>
          <p class="config__help">Pick up to three. Bundles save 15%.</p>
          <div class="config__cards config__cards--three">
            <label class="config__card" data-key="skillet">
              <input type="checkbox" name="pans" value="skillet" data-delta="55" data-variant-id="gid://shopify/Product/8814" />
              <img src="https://picsum.photos/seed/ridge-skillet/1600/1000" alt="Ridge Skillet with two fried eggs" width="3200" height="2000" loading="lazy" />
              <span class="config__card-body">
                <strong>Ridge Skillet 10"</strong>
                <span class="config__delta">+$55</span>
              </span>
            </label>
            <label class="config__card" data-key="griddle" data-requires="grate.xl">
              <input type="checkbox" name="pans" value="griddle" data-delta="45" disabled />
              <img src="https://picsum.photos/seed/griddle-plate/1600/1000" alt="Flatbreads blistering on the griddle plate" width="3200" height="2000" loading="lazy" />
              <span class="config__card-body">
                <strong>Griddle plate</strong>
                <span>Smash burgers, flatbreads, pancakes</span>
                <span class="config__delta">+$45</span>
                <span class="config__unavailable">Fits the XL grate only</span>
              </span>
            </label>
            <label class="config__card" data-key="kettle">
              <input type="checkbox" name="pans" value="kettle" data-delta="39" data-variant-id="gid://shopify/Product/8815" />
              <img src="https://picsum.photos/seed/trail-kettle/1600/1000" alt="Trail Kettle steaming on the grate" width="3200" height="2000" loading="lazy" />
              <span class="config__card-body">
                <strong>Trail Kettle 1L</strong>
                <span class="config__delta">+$39</span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="config__total">
          <p>Kit total <strong class="config__price" aria-live="polite">$189</strong></p>
          <button class="btn btn-primary" type="submit" formaction="/cart">
            Add kit to cart
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <p class="config__ship">Free shipping over $150 · Lifetime warranty</p>
      </form>
    </div>
  </div>
</section>

<style>
  .config__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .config__visual {
    position: sticky;
    top: 1.5rem;
  }

  .config__visual img {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .config__form .lead {
    margin-bottom: 1.5rem;
  }

  .config__step {
    margin: 0 0 1.75rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .config__step legend {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.875rem;
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .config__num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.8125rem;
  }

  .config__help {
    margin: -0.5rem 0 0.875rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .config__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .config__cards--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .config__card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    font-size: 0.875rem;
  }

  .config__card input {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    accent-color: var(--brand);
  }

  .config__card img {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .config__card-body {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem;
    color: var(--ink-2);
  }

  .config__card-body strong {
    color: var(--ink);
  }

  .config__card:has(input:checked) {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .config__card:has(input:disabled),
  .config__swatch:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .config__unavailable {
    color: var(--warning);
    font-weight: 600;
  }

  .config__card:has(input:not(:disabled)) .config__unavailable {
    display: none;
  }

  .config__delta {
    font-weight: 600;
    color: var(--ink);
  }

  .config__swatches {
    display: grid;
    gap: 0.5rem;
  }

  .config__swatch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .config__swatch:has(input:checked) {
    border-color: var(--brand);
  }

  .config__swatch em {
    font-style: normal;
    font-weight: 700;
    color: var(--brand);
    margin-left: 0.25rem;
  }

  .config__dot {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px var(--line);
  }

  .config__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .config__total p {
    margin: 0;
    font-weight: 600;
  }

  .config__price {
    margin-left: 0.5rem;
    font-size: 1.5rem;
  }

  .config__ship {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .config__grid {
      grid-template-columns: 1fr;
    }

    .config__visual {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .config__cards,
    .config__cards--three {
      grid-template-columns: 1fr;
    }

    .config__card {
      flex-direction: row;
    }

    .config__card img {
      width: 96px;
      aspect-ratio: 1;
      flex: none;
    }

    .config__card input {
      top: 0.4rem;
      left: 0.4rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("product-configurator");
    if (!root) return;
    const form = root.querySelector("form");
    const price = root.querySelector(".config__price");
    const base = Number(root.dataset.basePrice);
    const griddle = root.querySelector('input[value="griddle"]');
    const pans = [...root.querySelectorAll('input[name="pans"]')];
    const update = () => {
      const xl = form.querySelector('input[name="grate"]:checked').value === "xl";
      griddle.disabled = !xl;
      if (!xl) griddle.checked = false;
      const picked = pans.filter((p) => p.checked).length;
      pans.forEach((p) => {
        if (p === griddle && !xl) return;
        p.disabled = !p.checked && picked >= 3;
      });
      let total = base;
      form.querySelectorAll("input:checked").forEach((i) => (total += Number(i.dataset.delta || 0)));
      price.textContent = "$" + total.toLocaleString("en-US");
    };
    form.addEventListener("change", update);
    form.addEventListener("submit", (e) => e.preventDefault());
    update();
  })();
</script>
