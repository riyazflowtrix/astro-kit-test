---
---

<section id="roi-calculator" class="section section--muted roi" data-variant="split">
  <!-- kit: roi-calculator -->
  <div class="container">
    <div class="section-head">
      <h2>See how many hours payroll gives back.</h2>
      <p class="lead">Move the sliders to match your team. Results update as you go and assume the average Betterwork customer's time savings.</p>
    </div>

    <div class="roi__grid">
      <form class="roi__inputs card" action="#" aria-label="Your payroll today">
        <div class="field">
          <label for="roi-employees">How many people do you pay? <output class="roi__val" for="roi-employees" data-for="employees">120 people</output></label>
          <input id="roi-employees" name="employees" type="range" min="10" max="2000" step="10" value="120" data-unit="people" />
          <div class="roi__range"><span>10</span><span>2,000</span></div>
        </div>
        <div class="field">
          <label for="roi-runs">How often do you run payroll?</label>
          <select id="roi-runs" name="runs">
            <option value="12">Monthly</option>
            <option value="24">Twice a month</option>
            <option value="26" selected>Every two weeks</option>
            <option value="52">Weekly</option>
          </select>
        </div>
        <div class="field">
          <label for="roi-hours">Hours spent on each run today</label>
          <div class="roi__unit-input">
            <input id="roi-hours" name="hoursPerRun" type="number" min="1" max="40" step="0.5" value="6" aria-describedby="roi-hours-help" />
            <span>hours</span>
          </div>
          <p id="roi-hours-help" class="roi__help">Include approvals, fixes and the bank file.</p>
        </div>
        <div class="field">
          <label for="roi-cost">Loaded hourly cost of your payroll lead</label>
          <div class="roi__unit-input">
            <input id="roi-cost" name="hourlyCost" type="number" min="15" max="250" step="1" value="48" />
            <span>USD</span>
          </div>
        </div>
      </form>

      <div class="roi__outputs" aria-live="polite">
        <div class="roi__out roi__out--main" data-key="hoursSaved" data-formula="runs * hoursPerRun * 0.72">
          <p class="roi__out-label">Hours back each year</p>
          <p class="roi__out-value" data-output="hoursSaved">112 hours</p>
        </div>
        <div class="roi__pair">
          <div class="roi__out" data-key="costSaved" data-formula="hoursSaved * hourlyCost">
            <p class="roi__out-label">Saved each year</p>
            <p class="roi__out-value" data-output="costSaved">$5,391</p>
          </div>
          <div class="roi__out" data-key="perEmployee" data-formula="costSaved / employees">
            <p class="roi__out-label">Saved per employee</p>
            <p class="roi__out-value" data-output="perEmployee">$44.93</p>
          </div>
        </div>

        <div class="roi__assumptions">
          <p>We use a <strong>72% reduction</strong> in time per payroll run, the median across 1,240 Betterwork customers in 2025. Hourly cost should include benefits and overhead, usually 1.3× salary.</p>
        </div>

        <a class="btn btn-primary" href="/demo?topic=payroll" title="Book a demo">
          Book a payroll demo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>

        <form class="roi__email" action="#" method="post" data-form="form_contact">
          <label for="roi-email">Email me these results</label>
          <div class="roi__email-row">
            <input id="roi-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
            <button class="btn btn-secondary" type="submit">Send</button>
          </div>
          <p class="roi__email-done" role="status" hidden>Sent — check your inbox for a copy of your estimate.</p>
        </form>

        <p class="roi__disclaimer">Estimates only. Your results depend on pay complexity, number of states and approval steps.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .roi [hidden] {
    display: none !important;
  }

  .roi__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .roi__inputs {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .roi__inputs label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .roi__val {
    color: var(--accent);
  }

  .roi__inputs input[type="range"] {
    min-height: auto;
    padding: 0;
    border: 0;
    accent-color: var(--accent);
  }

  .roi__range {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .roi__unit-input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .roi__unit-input span {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .roi__help {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .roi__outputs {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .roi__out {
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .roi__out p {
    margin: 0;
  }

  .roi__out--main {
    background: var(--dark);
    color: var(--dark-ink);
    border-color: var(--dark);
  }

  .roi__out-label {
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .roi__out-value {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .roi__out--main .roi__out-value {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
  }

  .roi__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .roi__assumptions {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .roi__assumptions p {
    margin: 0;
  }

  .roi__email {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .roi__email label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .roi__email-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .roi__email-row input {
    flex: 1 1 200px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .roi__email-done {
    margin: 0;
    color: var(--success);
    font-size: 0.875rem;
  }

  .roi__disclaimer {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .roi__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("roi-calculator");
    if (!root) return;
    const form = root.querySelector(".roi__inputs");
    const out = (k) => root.querySelector('[data-output="' + k + '"]');
    const money = (n, d) => n.toLocaleString("en-US", { style: "currency", currency: "USD", minimumFractionDigits: d, maximumFractionDigits: d });
    const calc = () => {
      const employees = Number(form.employees.value);
      const runs = Number(form.runs.value);
      const hoursPerRun = Number(form.hoursPerRun.value) || 0;
      const hourlyCost = Number(form.hourlyCost.value) || 0;
      const hoursSaved = runs * hoursPerRun * 0.72;
      const costSaved = hoursSaved * hourlyCost;
      const perEmployee = employees ? costSaved / employees : 0;
      root.querySelector('[data-for="employees"]').textContent = employees.toLocaleString("en-US") + " people";
      out("hoursSaved").textContent = Math.round(hoursSaved).toLocaleString("en-US") + " hours";
      out("costSaved").textContent = money(costSaved, 0);
      out("perEmployee").textContent = money(perEmployee, 2);
    };
    form.addEventListener("input", calc);
    form.addEventListener("submit", (e) => e.preventDefault());
    calc();
    const email = root.querySelector(".roi__email");
    email.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!email.reportValidity()) return;
      email.querySelector(".roi__email-row").hidden = true;
      email.querySelector(".roi__email-done").hidden = false;
    });
  })();
</script>
