---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="roi-calculator" class="section section--muted roi" data-variant="split">
  <!-- kit: roi-calculator -->
  <div class="container">
    <div class="section-head">
      <h2>See how many hours payroll gives back.</h2>
      <p class="lead">Move the sliders to match your team. Results update as you go and assume the average Betterwork customer's time savings.</p>
    </div>

    <div class="roi__grid">
      <form class="roi__inputs card" action={bcmsFormAction("Your payroll today")} aria-label="Your payroll today" method={bcmsFormMethod("Your payroll today")} data-bcms-form={bcmsFormId("Your payroll today")} data-bcms-form-success="Thank you for your submission!">
        <div class="field" data-bcms-form-field="employees">
          <label for="roi-employees" data-bcms-form-part="label">How many people do you pay? <output class="roi__val" for="roi-employees" data-for="employees">120 people</output></label>
          <input id="roi-employees" name="employees" type="range" min="10" max="2000" step="10" value="120" data-unit="people" />
          <div class="roi__range"><span>10</span><span>2,000</span></div>
        </div>
        <div class="field" data-bcms-form-field="runs">
          <label for="roi-runs" data-bcms-form-part="label">How often do you run payroll?</label>
          <select id="roi-runs" name="runs">
            <option value="12">Monthly</option>
            <option value="24">Twice a month</option>
            <option value="26" selected>Every two weeks</option>
            <option value="52">Weekly</option>
          </select>
        </div>
        <div class="field">
          <label for="roi-hours" data-bcms-form-part="label">Hours spent on each run today</label>
          <div class="roi__unit-input" data-bcms-form-field="hoursPerRun">
            <input id="roi-hours" name="hoursPerRun" type="number" min="1" max="40" step="0.5" value="6" aria-describedby="roi-hours-help" />
            <span>hours</span>
          </div>
          <p id="roi-hours-help" class="roi__help">Include approvals, fixes and the bank file.</p>
        </div>
        <div class="field">
          <label for="roi-cost" data-bcms-form-part="label">Loaded hourly cost of your payroll lead</label>
          <div class="roi__unit-input" data-bcms-form-field="hourlyCost">
            <input id="roi-cost" name="hourlyCost" type="number" min="15" max="250" step="1" value="48" />
            <span>USD</span>
          </div>
        </div>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

      <div class="roi__outputs" aria-live="polite">
        <div class="roi__out roi__out--main" data-key="hoursSaved" data-formula="runs * hoursPerRun * 0.72">
          <p class="roi__out-label">Hours back each year</p>
          <p class="roi__out-value" data-output="hoursSaved">112 hours</p>
        </div>
        <div class="roi__pair">
          <div class="roi__out" data-key="costSaved" data-formula="hoursSaved * hourlyCost">
            <p class="roi__out-label">Saved each year</p>
            <p class="roi__out-value" data-output="costSaved">$5,391</p>
          </div>
          <div class="roi__out" data-key="perEmployee" data-formula="costSaved / employees">
            <p class="roi__out-label">Saved per employee</p>
            <p class="roi__out-value" data-output="perEmployee">$44.93</p>
          </div>
        </div>

        <div class="roi__assumptions">
          <p>We use a <strong>72% reduction</strong> in time per payroll run, the median across 1,240 Betterwork customers in 2025. Hourly cost should include benefits and overhead, usually 1.3× salary.</p>
        </div>

        <a class="btn btn-primary" href="/demo?topic=payroll" title="Book a demo">
          Book a payroll demo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>

        <form class="roi__email" action="#" method="post" data-form="form_contact">
          <label for="roi-email">Email me these results</label>
          <div class="roi__email-row">
            <input id="roi-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
            <button class="btn btn-secondary" type="submit">Send</button>
          </div>
          <p class="roi__email-done" role="status" hidden>Sent — check your inbox for a copy of your estimate.</p>
        </form>

        <p class="roi__disclaimer">Estimates only. Your results depend on pay complexity, number of states and approval steps.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .roi [hidden] {
    display: none !important;
  }

  .roi__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .roi__inputs {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .roi__inputs label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .roi__val {
    color: var(--accent);
  }

  .roi__inputs input[type="range"] {
    min-height: auto;
    padding: 0;
    border: 0;
    accent-color: var(--accent);
  }

  .roi__range {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .roi__unit-input {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .roi__unit-input span {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .roi__help {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .roi__outputs {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .roi__out {
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .roi__out p {
    margin: 0;
  }

  .roi__out--main {
    background: var(--dark);
    color: var(--dark-ink);
    border-color: var(--dark);
  }

  .roi__out-label {
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .roi__out-value {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .roi__out--main .roi__out-value {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
  }

  .roi__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .roi__assumptions {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .roi__assumptions p {
    margin: 0;
  }

  .roi__email {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .roi__email label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .roi__email-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .roi__email-row input {
    flex: 1 1 200px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .roi__email-done {
    margin: 0;
    color: var(--success);
    font-size: 0.875rem;
  }

  .roi__disclaimer {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .roi__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("roi-calculator");
    if (!root) return;
    const form = root.querySelector(".roi__inputs");
    const out = (k) => root.querySelector('[data-output="' + k + '"]');
    const money = (n, d) => n.toLocaleString("en-US", { style: "currency", currency: "USD", minimumFractionDigits: d, maximumFractionDigits: d });
    const calc = () => {
      const employees = Number(form.employees.value);
      const runs = Number(form.runs.value);
      const hoursPerRun = Number(form.hoursPerRun.value) || 0;
      const hourlyCost = Number(form.hourlyCost.value) || 0;
      const hoursSaved = runs * hoursPerRun * 0.72;
      const costSaved = hoursSaved * hourlyCost;
      const perEmployee = employees ? costSaved / employees : 0;
      root.querySelector('[data-for="employees"]').textContent = employees.toLocaleString("en-US") + " people";
      out("hoursSaved").textContent = Math.round(hoursSaved).toLocaleString("en-US") + " hours";
      out("costSaved").textContent = money(costSaved, 0);
      out("perEmployee").textContent = money(perEmployee, 2);
    };
    form.addEventListener("input", calc);
    form.addEventListener("submit", (e) => e.preventDefault());
    calc();
    const email = root.querySelector(".roi__email");
    email.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!email.reportValidity()) return;
      email.querySelector(".roi__email-row").hidden = true;
      email.querySelector(".roi__email-done").hidden = false;
    });
  })();
</script>
