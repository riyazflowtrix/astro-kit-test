---
---

<section id="data-table-specs" class="section specs" data-variant="cards" data-source="manual" data-default-sort="diameter:asc">
  <!-- kit: data-table-specs -->
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Sizing</span>
      <h2>Find the skillet that fits your fire.</h2>
    </div>

    <div class="specs__scroll">
      <table class="specs__table" id="tbl_skillet_sizes" data-responsive="cards" data-sticky="true">
        <caption class="visually-hidden">Caldera skillets and grates compared by diameter, weight, material, induction support and price.</caption>
        <thead>
          <tr>
            <th scope="col" data-type="text">Model</th>
            <th scope="col" data-type="number" aria-sort="ascending"><button type="button" data-sort="diameter">Diameter <span class="specs__unit">(in)</span><span class="specs__arrow" aria-hidden="true"></span></button></th>
            <th scope="col" data-type="number" aria-sort="none"><button type="button" data-sort="weight" title="Without the lid">Weight <span class="specs__unit">(lb)</span><span class="specs__arrow" aria-hidden="true"></span></button></th>
            <th scope="col" data-type="text" aria-sort="none"><button type="button" data-sort="material">Material<span class="specs__arrow" aria-hidden="true"></span></button></th>
            <th scope="col" data-type="boolean">Induction</th>
            <th scope="col" data-type="money" aria-sort="none"><button type="button" data-sort="price">Price<span class="specs__arrow" aria-hidden="true"></span></button></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-label="Model">Ridge Skillet 8"</th>
            <td data-label="Diameter" data-value="8">8 in</td>
            <td data-label="Weight" data-value="3.9">3.9 lb</td>
            <td data-label="Material" data-value="Cast iron">Cast iron</td>
            <td data-label="Induction"><span class="specs__yes">Works on induction</span></td>
            <td data-label="Price" data-value="55">$55</td>
          </tr>
          <tr class="is-highlight">
            <th scope="row" data-label="Model">Ridge Skillet 10" <span class="badge">Bestseller</span></th>
            <td data-label="Diameter" data-value="10">10 in</td>
            <td data-label="Weight" data-value="5.2">5.2 lb</td>
            <td data-label="Material" data-value="Cast iron">Cast iron</td>
            <td data-label="Induction"><span class="specs__yes">Works on induction</span></td>
            <td data-label="Price" data-value="65">$65<sup><a href="#specs-fn-1" aria-describedby="specs-fn-label">1</a></sup></td>
          </tr>
          <tr>
            <th scope="row" data-label="Model">Carbon Pan 11"</th>
            <td data-label="Diameter" data-value="11">11 in</td>
            <td data-label="Weight" data-value="3.1">3.1 lb</td>
            <td data-label="Material" data-value="Carbon steel">Carbon steel</td>
            <td data-label="Induction"><span class="specs__yes">Works on induction</span></td>
            <td data-label="Price" data-value="79">$79</td>
          </tr>
          <tr>
            <th scope="row" data-label="Model">Ridge Skillet 12"</th>
            <td data-label="Diameter" data-value="12">12 in</td>
            <td data-label="Weight" data-value="7.4">7.4 lb</td>
            <td data-label="Material" data-value="Cast iron">Cast iron</td>
            <td data-label="Induction"><span class="specs__yes">Works on induction</span></td>
            <td data-label="Price" data-value="85">$85</td>
          </tr>
          <tr>
            <th scope="row" data-label="Model">Cable Fold Grate</th>
            <td data-label="Diameter" data-value="16">16 in</td>
            <td data-label="Weight" data-value="4.6">4.6 lb</td>
            <td data-label="Material" data-value="Stainless steel">Stainless steel</td>
            <td data-label="Induction"><span class="specs__no">Not for induction</span><sup><a href="#specs-fn-2" aria-describedby="specs-fn-label">2</a></sup></td>
            <td data-label="Price" data-value="189">$189</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="specs__notes">
      <p>Weights are without the lid. Every piece ships pre-seasoned and carries the lifetime warranty.</p>
      <h3 id="specs-fn-label" class="visually-hidden">Footnotes</h3>
      <ol>
        <li id="specs-fn-1">Our bestseller.</li>
        <li id="specs-fn-2">Open fire and gas only.</li>
      </ol>
    </div>
  </div>

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Caldera skillets and grates compared",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ridge Skillet 8\"" },
        { "@type": "ListItem", "position": 2, "name": "Ridge Skillet 10\"" },
        { "@type": "ListItem", "position": 3, "name": "Carbon Pan 11\"" },
        { "@type": "ListItem", "position": 4, "name": "Ridge Skillet 12\"" },
        { "@type": "ListItem", "position": 5, "name": "Cable Fold Grate" }
      ]
    }
  </script>
</section>

<style>
  .specs__scroll {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: auto;
    max-height: 560px;
  }

  .specs__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .specs__table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--surface);
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .specs__table th,
  .specs__table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .specs__table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .specs__table tbody th {
    font-weight: 600;
  }

  .specs__table thead button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .specs__unit {
    font-weight: 500;
    color: var(--ink-3);
  }

  .specs__arrow::after {
    content: "↕";
    color: var(--ink-3);
    margin-left: 0.25rem;
  }

  th[aria-sort="ascending"] .specs__arrow::after {
    content: "↑";
    color: var(--brand);
  }

  th[aria-sort="descending"] .specs__arrow::after {
    content: "↓";
    color: var(--brand);
  }

  .is-highlight {
    background: var(--brand-soft);
  }

  .specs__yes {
    color: var(--success);
    font-weight: 500;
  }

  .specs__no {
    color: var(--ink-3);
  }

  sup a {
    margin-left: 2px;
    color: var(--brand);
    text-decoration: none;
    font-weight: 700;
  }

  .specs__notes {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .specs__notes ol {
    margin: 0;
    padding-left: 1.25rem;
  }

  @media (max-width: 720px) {
    .specs__scroll {
      border: 0;
      max-height: none;
      overflow: visible;
    }

    .specs__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .specs__table,
    .specs__table tbody,
    .specs__table tr,
    .specs__table th,
    .specs__table td {
      display: block;
    }

    .specs__table tbody {
      display: grid;
      gap: 1rem;
    }

    .specs__table tbody tr {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .specs__table tbody th {
      font-size: 1.0625rem;
      background: var(--surface);
    }

    .is-highlight th {
      background: var(--brand-soft) !important;
    }

    .specs__table tbody td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.6rem 1rem;
      text-align: right;
    }

    .specs__table tbody td::before {
      content: attr(data-label);
      font-weight: 600;
      color: var(--ink-2);
      text-align: left;
    }

    .specs__table tbody tr > :last-child {
      border-bottom: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("data-table-specs");
    if (!root) return;
    const table = root.querySelector("table");
    const tbody = table.querySelector("tbody");
    const heads = [...table.querySelectorAll("thead th")];
    heads.forEach((th, col) => {
      const btn = th.querySelector("button");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const dir = th.getAttribute("aria-sort") === "ascending" ? "descending" : "ascending";
        heads.forEach((h) => h.hasAttribute("aria-sort") && h.setAttribute("aria-sort", "none"));
        th.setAttribute("aria-sort", dir);
        const numeric = th.dataset.type !== "text";
        const rows = [...tbody.rows];
        rows.sort((a, b) => {
          const av = a.cells[col].dataset.value;
          const bv = b.cells[col].dataset.value;
          const cmp = numeric ? Number(av) - Number(bv) : av.localeCompare(bv);
          return dir === "ascending" ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  })();
</script>
