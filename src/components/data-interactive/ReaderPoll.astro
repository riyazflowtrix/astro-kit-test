---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section
  id="reader-poll"
  class="section section--muted poll"
  data-variant="inline"
  data-type="single"
  data-show-results="afterVote"
  data-closes-at="2026-11-01T23:59:00-04:00"
  data-one-vote="true"
>
  <!-- kit: reader-poll -->
  <div class="container poll__wrap">
    <div class="poll__card card">
      <span class="eyebrow">Reader poll</span>
      <form class="poll__form" action={bcmsFormAction("How do you read Atlas most days?")} method={bcmsFormMethod("How do you read Atlas most days?")} data-bcms-form={bcmsFormId("How do you read Atlas most days?")} data-bcms-form-success="Thank you for your submission!">
        <fieldset>
          <legend><h2>How do you read Atlas most days?</h2></legend>
          <p class="poll__context">We're redesigning the morning edition. Your answer decides what we build first.</p>
          <div class="poll__options">
            <label class="poll__option" data-bcms-form-field="answer"><input type="radio" name="answer" value="newsletter" required /> The morning newsletter</label>
            <label class="poll__option"><input type="radio" name="answer" value="app" /> The app, on the commute</label>
            <label class="poll__option"><input type="radio" name="answer" value="website" /> The website, at my desk</label>
            <label class="poll__option"><input type="radio" name="answer" value="print" /> The weekend print edition</label>
            <label class="poll__option"><input type="radio" name="answer" value="other" /> Something else</label>
            <div class="field poll__other" hidden data-bcms-form-field="other">
              <label for="poll-other" data-bcms-form-part="label">Tell us how</label>
              <input id="poll-other" name="other" type="text" maxlength="140" />
            </div>
          </div>
        </fieldset>
        <div class="poll__actions">
          <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Vote</button>
          <p class="poll__closes">Poll closes November 1 at 11:59pm ET · One vote per reader</p>
        </div>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

      <div class="poll__results" role="status" hidden>
        <h2>How do you read Atlas most days?</h2>
        <ul>
          <li><span class="poll__res-label">The morning newsletter</span><span class="poll__bar"><span style="width:41%"></span></span><span class="poll__pct">41%</span></li>
          <li><span class="poll__res-label">The app, on the commute</span><span class="poll__bar"><span style="width:27%"></span></span><span class="poll__pct">27%</span></li>
          <li><span class="poll__res-label">The website, at my desk</span><span class="poll__bar"><span style="width:22%"></span></span><span class="poll__pct">22%</span></li>
          <li><span class="poll__res-label">The weekend print edition</span><span class="poll__bar"><span style="width:7%"></span></span><span class="poll__pct">7%</span></li>
          <li><span class="poll__res-label">Something else</span><span class="poll__bar"><span style="width:3%"></span></span><span class="poll__pct">3%</span></li>
        </ul>
        <p class="poll__votes">3,906 votes</p>
        <p class="poll__thanks">Thanks. We'll publish what we learn on November 4.</p>
      </div>

      <p class="poll__related">Related: <a href="/stories/redesigning-the-morning-edition">Why we're rebuilding the morning edition</a></p>
    </div>
  </div>
</section>

<style>
  .poll [hidden] {
    display: none !important;
  }

  .poll__wrap {
    max-width: 720px;
  }

  .poll__card {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .poll fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .poll legend h2,
  .poll__results h2 {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
  }

  .poll__context {
    color: var(--ink-2);
  }

  .poll__options {
    display: grid;
    gap: 0.5rem;
  }

  .poll__option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }

  .poll__option:has(input:checked) {
    border-color: var(--brand);
    background: var(--brand-soft);
  }

  .poll__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .poll__closes {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .poll__results ul {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .poll__results li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
    font-size: 0.9375rem;
  }

  .poll__bar {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 10px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .poll__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--brand);
  }

  .poll__pct {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .poll__votes {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .poll__thanks {
    font-weight: 600;
  }

  .poll__related {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }

  .poll__related a {
    font-weight: 600;
    color: var(--brand);
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("reader-poll");
    if (!root) return;
    const form = root.querySelector(".poll__form");
    const results = root.querySelector(".poll__results");
    const other = root.querySelector(".poll__other");
    const KEY = "atlas-poll-morning-edition";
    const showResults = () => {
      form.hidden = true;
      results.hidden = false;
    };
    try {
      if (localStorage.getItem(KEY)) showResults();
    } catch (e) {}
    form.addEventListener("change", () => {
      const picked = form.querySelector('input[name="answer"]:checked');
      const isOther = !!picked && picked.value === "other";
      other.hidden = !isOther;
      other.querySelector("input").required = isOther;
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      try {
        localStorage.setItem(KEY, "1");
      } catch (err) {}
      showResults();
    });
  })();
</script>
