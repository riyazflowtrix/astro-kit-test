<script is:inline>
  (function () {
    var root = document.getElementById("hero-slider");
    if (!root) return;
    var slides = Array.prototype.slice.call(root.querySelectorAll(".hsl__slide"));
    var dots = Array.prototype.slice.call(root.querySelectorAll(".hsl__dots button"));
    var playBtn = root.querySelector(".hsl__play");
    var current = 0;
    var interval = (Number(root.getAttribute("data-interval")) || 6) * 1000;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var playing = !reduce;
    var hovering = false;
    var timer = null;

    function go(i) {
      current = (i + slides.length) % slides.length;
      slides.forEach(function (s, n) {
        var on = n === current;
        s.classList.toggle("is-active", on);
        s.setAttribute("aria-hidden", String(!on));
        s.querySelectorAll("a").forEach(function (a) {
          if (on) a.removeAttribute("tabindex"); else a.setAttribute("tabindex", "-1");
        });
      });
      dots.forEach(function (d, n) {
        if (n === current) d.setAttribute("aria-current", "true"); else d.removeAttribute("aria-current");
      });
    }
    function schedule() {
      clearInterval(timer);
      if (playing) timer = setInterval(function () { if (!hovering) go(current + 1); }, interval);
    }
    function setPlaying(on) {
      playing = on;
      root.classList.toggle("is-paused", !on);
      playBtn.setAttribute("aria-label", on ? "Pause slideshow" : "Play slideshow");
      schedule();
    }
    dots.forEach(function (d, n) { d.addEventListener("click", function () { go(n); schedule(); }); });
    root.querySelector(".hsl__prev").addEventListener("click", function () { go(current - 1); schedule(); });
    root.querySelector(".hsl__next").addEventListener("click", function () { go(current + 1); schedule(); });
    playBtn.addEventListener("click", function () { setPlaying(!playing); });
    root.addEventListener("mouseenter", function () { hovering = true; });
    root.addEventListener("mouseleave", function () { hovering = false; });
    root.addEventListener("focusin", function () { hovering = true; });
    root.addEventListener("focusout", function () { hovering = false; });
    setPlaying(playing);
  })();
</script>

<style>
  .hsl {
    position: relative;
    padding: 0;
    background: var(--dark);
    color: #fff;
    overflow: hidden;
  }

  .hsl__track {
    display: grid;
  }

  .hsl__slide {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 75vh, 720px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms ease, visibility 600ms;
  }

  .hsl__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hsl__slide > img,
  .hsl__slide picture,
  .hsl__slide picture img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hsl__slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1));
  }

  .hsl__slide[data-position="center"]::after {
    background: radial-gradient(circle at center, rgb(255 255 255 / 0.8), rgb(255 255 255 / 0.35));
  }

  .hsl__slide[data-position="right"]::after {
    background: linear-gradient(270deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1));
  }

  .hsl__content {
    position: relative;
    z-index: 1;
    display: flex;
    padding-block: 4rem 6rem;
  }

  .hsl__slide[data-position="center"] .hsl__content {
    justify-content: center;
    text-align: center;
  }

  .hsl__slide[data-position="right"] .hsl__content {
    justify-content: flex-end;
  }

  .hsl__copy {
    max-width: 520px;
  }

  .hsl__slide[data-tone="dark"] .hsl__copy {
    color: var(--ink);
  }

  .hsl__slide[data-tone="light"] .eyebrow {
    color: #ffc9a8;
  }

  .hsl__title {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
  }

  .hsl__body {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 1.75rem;
  }

  .hsl__outline {
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }

  .hsl__controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.5rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hsl__play,
  .hsl__arrows button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    cursor: pointer;
  }

  .hsl__icon-play,
  .is-paused .hsl__icon-pause {
    display: none;
  }

  .is-paused .hsl__icon-play {
    display: block;
  }

  .hsl__dots {
    display: flex;
    gap: 0.25rem;
  }

  .hsl__dots button {
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hsl__dots button::before {
    content: "";
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.45);
  }

  .hsl__dots button[aria-current="true"]::before {
    background: #fff;
  }

  .hsl__arrows {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .hsl__slide {
      transition: none;
    }
  }
</style>
