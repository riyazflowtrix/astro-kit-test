<script is:inline>
  (function () {
    var root = document.getElementById("hero-event");
    if (!root) return;
    var box = root.querySelector(".hev__countdown");
    var start = new Date(box.getAttribute("data-starts")).getTime();
    function pad(n) { return n < 10 ? "0" + n : String(n); }
    function tick() {
      var left = Math.max(0, start - Date.now());
      var m = Math.floor(left / 60000);
      box.querySelector('[data-unit="d"]').textContent = String(Math.floor(m / 1440));
      box.querySelector('[data-unit="h"]').textContent = pad(Math.floor((m % 1440) / 60));
      box.querySelector('[data-unit="m"]').textContent = pad(m % 60);
      if (left === 0) box.hidden = true;
    }
    tick();
    setInterval(tick, 30000);
  })();
</script>

