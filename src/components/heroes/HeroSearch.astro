<section id="hero-search" class="section section--dark hs" data-scope="recipes" data-alignment="center">
  <!-- kit: hero-search -->
  <img class="hs__bg" src="https://picsum.photos/seed/caldera-recipes-hero/2400/1200" alt="Overhead view of a camp table with chili, cornbread and a cast iron pan" width="2400" height="1200" />
  <div class="hs__overlay" aria-hidden="true"></div>

  <div class="container hs__inner">
    <span class="eyebrow hs__eyebrow">400+ tested recipes</span>
    <h2 class="hs__title">What are you cooking tonight?</h2>
    <p class="lead hs__lead">Every recipe is tested over coals and on a stovetop, with notes for both.</p>

    <form class="hs__form" role="search" action="#">
      <label class="visually-hidden" for="hero-search-q">Search recipes</label>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M20 20l-4-4"/></svg>
      <input id="hero-search-q" type="search" name="q" placeholder="Try “dutch oven bread”" list="hero-search-suggestions" />
      <input type="hidden" name="scope" value="recipes" />
      <button class="btn btn-primary" type="submit">Search</button>
      <datalist id="hero-search-suggestions">
        <option value="dutch oven bread"></option>
        <option value="skillet cornbread"></option>
        <option value="one-pot chili"></option>
        <option value="campfire breakfast"></option>
      </datalist>
    </form>

    <div class="hs__suggest">
      <span>Popular:</span>
      <ul>
        <li><button type="button">dutch oven bread</button></li>
        <li><button type="button">skillet cornbread</button></li>
        <li><button type="button">one-pot chili</button></li>
        <li><button type="button">campfire breakfast</button></li>
      </ul>
    </div>

    <nav class="hs__topics" aria-label="Browse by topic">
      <ul>
        <li><a href="/topics/camp">Camp cooking</a></li>
        <li><a href="/topics/recipes">Recipes</a></li>
        <li><a href="/topics/cast-iron">Cast iron</a></li>
        <li><a href="/topics/care">Care &amp; seasoning</a></li>
      </ul>
    </nav>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("hero-search");
    if (!root) return;
    var input = root.querySelector("#hero-search-q");
    root.querySelectorAll(".hs__suggest button").forEach(function (b) {
      b.addEventListener("click", function () {
        input.value = b.textContent;
        input.focus();
      });
    });
  })();
</script>

