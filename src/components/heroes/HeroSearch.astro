---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<section id="hero-search" class="section section--dark hs" data-scope="recipes" data-alignment="center">
  <!-- kit: hero-search -->
  <img class="hs__bg" src="https://picsum.photos/seed/caldera-recipes-hero/2400/1200" alt="Overhead view of a camp table with chili, cornbread and a cast iron pan" width="2400" height="1200" />
  <div class="hs__overlay" aria-hidden="true"></div>

  <div class="container hs__inner">
    <span class="eyebrow hs__eyebrow">400+ tested recipes</span>
    <h2 class="hs__title">What are you cooking tonight?</h2>
    <p class="lead hs__lead">Every recipe is tested over coals and on a stovetop, with notes for both.</p>

    <form class="hs__form" role="search" action={bcmsFormAction("What are you cooking tonight?")} method={bcmsFormMethod("What are you cooking tonight?")} data-bcms-form={bcmsFormId("What are you cooking tonight?")} data-bcms-form-success="Thank you for your submission!">
      <label class="visually-hidden" for="hero-search-q" data-bcms-form-part="label">Search recipes</label>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M20 20l-4-4"/></svg>
      <input id="hero-search-q" type="search" name="q" placeholder="Try “dutch oven bread”" list="hero-search-suggestions" data-bcms-form-field="q" />
      <input type="hidden" name="scope" value="recipes" data-bcms-form-field="scope" />
      <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Search</button>
      <datalist id="hero-search-suggestions">
        <option value="dutch oven bread"></option>
        <option value="skillet cornbread"></option>
        <option value="one-pot chili"></option>
        <option value="campfire breakfast"></option>
      </datalist>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

    <div class="hs__suggest">
      <span>Popular:</span>
      <ul>
        <li><button type="button">dutch oven bread</button></li>
        <li><button type="button">skillet cornbread</button></li>
        <li><button type="button">one-pot chili</button></li>
        <li><button type="button">campfire breakfast</button></li>
      </ul>
    </div>

    <nav class="hs__topics" aria-label="Browse by topic">
      <ul>
        <li><a href="/topics/camp">Camp cooking</a></li>
        <li><a href="/topics/recipes">Recipes</a></li>
        <li><a href="/topics/cast-iron">Cast iron</a></li>
        <li><a href="/topics/care">Care &amp; seasoning</a></li>
      </ul>
    </nav>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("hero-search");
    if (!root) return;
    var input = root.querySelector("#hero-search-q");
    root.querySelectorAll(".hs__suggest button").forEach(function (b) {
      b.addEventListener("click", function () {
        input.value = b.textContent;
        input.focus();
      });
    });
  })();
</script>

<style>
  .hs {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(80px, 12vw, 152px);
  }

  .hs__bg,
  .hs__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hs__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hs__overlay {
    background: rgb(12 10 8 / 0.5);
  }

  .hs__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hs__eyebrow {
    color: #ffd7a8;
  }

  .hs__title {
    font-size: clamp(2.25rem, 6vw, 4rem);
  }

  .hs__lead {
    margin-inline: auto;
  }

  .hs__form {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 640px;
    margin-top: 1.5rem;
    padding: 0.375rem;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 20px 48px rgb(0 0 0 / 0.3);
  }

  .hs__form > svg {
    margin-left: 0.875rem;
    color: var(--ink-3);
    flex-shrink: 0;
  }

  .hs__form input[type="search"] {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    border: 0;
    background: transparent;
    font-size: 1.0625rem;
  }

  .hs__form input[type="search"]:focus {
    outline: none;
  }

  .hs__form:focus-within {
    outline: 3px solid #ffd7a8;
    outline-offset: 2px;
  }

  .hs__form .btn {
    border-radius: 999px;
    min-height: 48px;
    padding-inline: 1.5rem;
  }

  .hs__suggest {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }

  .hs__suggest ul,
  .hs__topics ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hs__suggest button {
    min-height: 32px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  .hs__suggest button:hover {
    background: rgb(255 255 255 / 0.28);
  }

  .hs__topics {
    margin-top: 2rem;
  }

  .hs__topics a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hs__topics a:hover {
    background: #fff;
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .hs__form {
      border-radius: var(--radius-lg);
      flex-wrap: wrap;
    }

    .hs__form .btn {
      flex-basis: 100%;
      border-radius: var(--radius);
    }
  }
</style>
