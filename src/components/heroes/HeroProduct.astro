<script is:inline>
  (function () {
    var root = document.getElementById("hero-product");
    if (!root) return;
    var main = root.querySelector(".hp__main-img");
    var thumbs = Array.prototype.slice.call(root.querySelectorAll(".hp__thumbs button"));
    function show(i) {
      var t = thumbs[i];
      if (!t) return;
      main.src = t.getAttribute("data-src");
      main.alt = t.getAttribute("data-alt");
      thumbs.forEach(function (b, n) { b.setAttribute("aria-pressed", String(n === i)); });
    }
    thumbs.forEach(function (t, i) { t.addEventListener("click", function () { show(i); }); });
    root.querySelectorAll('input[name="color"]').forEach(function (input) {
      input.addEventListener("change", function () {
        root.querySelector(".hp__picked").textContent = input.value;
        var img = input.getAttribute("data-image");
        if (img !== null) show(Number(img));
      });
    });
    root.querySelector(".hp__form").addEventListener("submit", function (e) {
      e.preventDefault();
      var btn = root.querySelector(".hp__add");
      btn.textContent = "Added to cart";
      setTimeout(function () { btn.textContent = "Add to cart"; }, 2000);
    });
  })();
</script>

