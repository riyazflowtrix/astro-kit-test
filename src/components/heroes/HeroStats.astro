<section id="hero-stats" class="section hst" data-variant="below" data-count-up="true" data-spacing="spacious">
  <!-- kit: hero-stats -->
  <div class="container">
    <div class="hst__head">
      <div>
        <span class="eyebrow">2025 impact</span>
        <h2 class="hst__title">Rivers recover fast when we get out of their way.</h2>
      </div>
      <div>
        <p class="lead">Since 2009 we've removed dams, replanted banks and bought back water rights so rivers can run the way they used to.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/donate?frequency=monthly">Give monthly</a>
          <a class="btn btn-secondary" href="https://cdn.bettercms.site/owt/impact-report-2025.pdf" target="_blank" rel="noopener">Read the 2025 report</a>
        </div>
      </div>
    </div>

    <img class="hst__image" src="https://picsum.photos/seed/owt-river-restored/2400/1400" alt="A braided river winding through a green valley where a reservoir used to be" width="2400" height="1400" />

    <dl class="hst__stats">
      <div class="hst__stat">
        <dt>river miles reopened<sup><a href="#hero-stats-src-1" aria-label="Source 1">1</a></sup></dt>
        <dd data-value="1240" data-decimals="0" data-prefix="" data-suffix="">1,240</dd>
      </div>
      <div class="hst__stat">
        <dt>dams removed</dt>
        <dd data-value="38" data-decimals="0" data-prefix="" data-suffix="">38</dd>
      </div>
      <div class="hst__stat">
        <dt>raised from 31,000 donors<sup><a href="#hero-stats-src-2" aria-label="Source 2">2</a></sup></dt>
        <dd data-value="4.2" data-decimals="1" data-prefix="$" data-suffix="M">$4.2M</dd>
      </div>
      <div class="hst__stat">
        <dt>of returning salmon runs monitored</dt>
        <dd data-value="96" data-decimals="0" data-prefix="" data-suffix="%">96%</dd>
      </div>
    </dl>

    <div class="hst__notes">
      <p>Figures as of <time datetime="2026-03-31">March 31, 2026</time>.</p>
      <ol>
        <li id="hero-stats-src-1">OWT field surveys, 2009–2025</li>
        <li id="hero-stats-src-2">Audited accounts, FY2025</li>
      </ol>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("hero-stats");
    if (!root || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var nums = Array.prototype.slice.call(root.querySelectorAll("dd[data-value]"));
    function format(el, v) {
      var d = Number(el.getAttribute("data-decimals")) || 0;
      var text = v.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });
      el.textContent = (el.getAttribute("data-prefix") || "") + text + (el.getAttribute("data-suffix") || "");
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        var el = entry.target;
        var target = Number(el.getAttribute("data-value"));
        var start = performance.now();
        function step(now) {
          var t = Math.min(1, (now - start) / 1400);
          var eased = 1 - Math.pow(1 - t, 3);
          format(el, target * eased);
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }, { threshold: 0.6 });
    nums.forEach(function (n) { io.observe(n); });
  })();
</script>

