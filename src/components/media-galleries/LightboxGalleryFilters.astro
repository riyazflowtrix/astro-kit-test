---
// Gallery with category filters (variant: landscape) — Tidewater Hotel.
---

<section id="lightbox-gallery-filters" class="section section--muted filter-gallery" data-variant="landscape">
  <!-- kit: lightbox-gallery-filters -->
  <div class="container">
    <header class="section-head">
      <h2>Inside Tidewater</h2>
    </header>

    <div class="chips" role="group" aria-label="Filter photos">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="chip" data-filter="rooms" aria-pressed="false">Rooms</button>
      <button type="button" class="chip" data-filter="dining" aria-pressed="false">Dining</button>
      <button type="button" class="chip" data-filter="spa" aria-pressed="false">Spa</button>
      <button type="button" class="chip" data-filter="beach" aria-pressed="false">The beach</button>
    </div>

    <ul class="grid-photos" role="list" aria-live="polite">
      <li class="photo" data-categories="rooms">
        <a href="https://picsum.photos/seed/tidewater-king-suite/1600/1200" data-caption="Bay King Suite — every suite faces the water.">
          <img src="https://picsum.photos/seed/tidewater-king-suite/1600/1200" alt="King suite with linen bedding and a balcony over the bay" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
      <li class="photo" data-categories="dining">
        <a href="https://picsum.photos/seed/tidewater-oyster-bar/1600/1200" data-caption="The Shell Bar opens at 4pm daily.">
          <img src="https://picsum.photos/seed/tidewater-oyster-bar/1600/1200" alt="Oyster bar counter with a chef shucking oysters" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
      <li class="photo" data-categories="spa">
        <a href="https://picsum.photos/seed/tidewater-steam-room/1600/1200" data-caption="">
          <img src="https://picsum.photos/seed/tidewater-steam-room/1600/1200" alt="Cedar steam room with soft light" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
      <li class="photo" data-categories="beach">
        <a href="https://picsum.photos/seed/tidewater-dunes/1600/1200" data-caption="A two-minute walk from the lobby.">
          <img src="https://picsum.photos/seed/tidewater-dunes/1600/1200" alt="Boardwalk through dunes to the beach at sunset" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
      <li class="photo" data-categories="dining beach">
        <a href="https://picsum.photos/seed/tidewater-terrace-breakfast/1600/1200" data-caption="Breakfast on the Dune Terrace.">
          <img src="https://picsum.photos/seed/tidewater-terrace-breakfast/1600/1200" alt="Breakfast on a terrace above the beach" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
      <li class="photo" data-categories="rooms">
        <a href="https://picsum.photos/seed/tidewater-twin-room/1600/1200" data-caption="Harbour Twin.">
          <img src="https://picsum.photos/seed/tidewater-twin-room/1600/1200" alt="Twin room with two double beds and a reading nook" width="3200" height="2400" loading="lazy" />
        </a>
      </li>
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="lb-close" type="button" aria-label="Close">×</button>
    <button class="lb-nav lb-prev" type="button" aria-label="Previous photo">‹</button>
    <figure class="lb-figure">
      <img class="lb-img" src="https://picsum.photos/seed/tidewater-king-suite/1600/1200" alt="" />
      <figcaption class="lb-caption"></figcaption>
    </figure>
    <button class="lb-nav lb-next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .chip {
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .chip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .grid-photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .photo[hidden] {
    display: none;
  }
  .photo a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    cursor: zoom-in;
    background: var(--surface-2);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .photo a:hover img {
    transform: scale(1.04);
  }
  @media (max-width: 900px) {
    .grid-photos { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .grid-photos { grid-template-columns: 1fr; }
  }

  .lightbox {
    width: min(1100px, 100vw - 24px);
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(10 10 12 / 0.9);
  }
  .lb-figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .lb-img {
    max-height: calc(100vh - 140px);
    width: auto;
    border-radius: var(--radius-sm);
  }
  .lb-caption {
    text-align: center;
    font-size: 0.9375rem;
  }
  .lb-close,
  .lb-nav {
    position: fixed;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-close { top: 12px; right: 12px; }
  .lb-prev { left: 12px; top: 50%; }
  .lb-next { right: 12px; top: 50%; }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("lightbox-gallery-filters");
    if (!root) return;
    var chips = Array.prototype.slice.call(root.querySelectorAll(".chip"));
    var photos = Array.prototype.slice.call(root.querySelectorAll(".photo"));
    var dialog = root.querySelector(".lightbox");
    var img = root.querySelector(".lb-img");
    var cap = root.querySelector(".lb-caption");
    var index = 0;

    function apply(key, updateUrl) {
      var valid = chips.some(function (c) { return c.dataset.filter === key; });
      if (!valid) key = "all";
      chips.forEach(function (c) { c.setAttribute("aria-pressed", String(c.dataset.filter === key)); });
      photos.forEach(function (p) {
        var cats = (p.dataset.categories || "").split(" ");
        p.hidden = key !== "all" && cats.indexOf(key) === -1;
      });
      if (updateUrl) {
        var url = new URL(window.location.href);
        if (key === "all") url.searchParams.delete("gallery");
        else url.searchParams.set("gallery", key);
        history.replaceState(null, "", url);
      }
    }
    chips.forEach(function (c) {
      c.addEventListener("click", function () { apply(c.dataset.filter, true); });
    });
    apply(new URL(window.location.href).searchParams.get("gallery") || "all", false);

    function visible() { return photos.filter(function (p) { return !p.hidden; }); }
    function show(i) {
      var list = visible();
      index = (i + list.length) % list.length;
      var a = list[index].querySelector("a");
      img.src = a.getAttribute("href");
      img.alt = a.querySelector("img").alt;
      cap.textContent = a.dataset.caption || "";
    }
    photos.forEach(function (p) {
      p.querySelector("a").addEventListener("click", function (e) {
        if (!dialog.showModal) return;
        e.preventDefault();
        show(visible().indexOf(p));
        dialog.showModal();
      });
    });
    root.querySelector(".lb-close").addEventListener("click", function () { dialog.close(); });
    root.querySelector(".lb-prev").addEventListener("click", function () { show(index - 1); });
    root.querySelector(".lb-next").addEventListener("click", function () { show(index + 1); });
    dialog.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("click", function (e) { if (e.target === dialog) dialog.close(); });
  })();
</script>
