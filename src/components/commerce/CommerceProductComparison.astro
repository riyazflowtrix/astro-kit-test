<section id="commerce-product-comparison" class="section compare">
  <!-- kit: commerce-product-comparison -->
  <div class="container">
    <div class="section-head section-head--center">
      <h2>Which pan is right for you?</h2>
      <p class="lead">Three ways to cook over fire. Here's how they compare where it matters.</p>
    </div>

    <label class="compare__toggle"><input type="checkbox" data-hide-same /> Only show differences</label>

    <div class="compare__scroll" role="region" aria-labelledby="tbl_pan_compare-caption" tabindex="0">
      <table id="tbl_pan_compare">
        <caption id="tbl_pan_compare-caption" class="visually-hidden">Ridge Skillet, Ember Dutch Oven and Cable Fold Grill compared for cooking and carrying</caption>
        <thead>
          <tr>
            <th scope="col" class="compare__corner">Spec</th>
            <th scope="col">
              <div class="compare__product">
                <img src="https://picsum.photos/seed/caldera-ridge-skillet/320/320" alt="Ridge Skillet 10 inch" width="320" height="320" loading="lazy" />
                <span class="compare__name">Ridge Skillet 10"</span>
                <span class="compare__price">$95</span>
                <a class="btn btn-secondary" href="/products/ridge-skillet">View</a>
              </div>
            </th>
            <th scope="col" class="is-highlight">
              <div class="compare__product">
                <span class="badge compare__pick">Our pick</span>
                <img src="https://picsum.photos/seed/caldera-dutch-coals/320/320" alt="Ember Dutch Oven" width="320" height="320" loading="lazy" />
                <span class="compare__name">Ember Dutch Oven</span>
                <span class="compare__price">$165</span>
                <a class="btn btn-primary" href="/products/ember-dutch-oven">View</a>
              </div>
            </th>
            <th scope="col">
              <div class="compare__product">
                <img src="https://picsum.photos/seed/caldera-cable-fold-card/320/320" alt="Cable Fold Grill" width="320" height="320" loading="lazy" />
                <span class="compare__name">Cable Fold Grill</span>
                <span class="compare__price">$89</span>
                <a class="btn btn-secondary" href="/products/cable-fold">View</a>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="compare__group"><th scope="rowgroup" colspan="4">Cooking</th></tr>
          <tr>
            <th scope="row">Best for</th>
            <td>Searing, eggs</td>
            <td class="is-highlight">Bread, braises</td>
            <td>Grilling over flame</td>
          </tr>
          <tr>
            <th scope="row">Induction</th>
            <td><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
            <td class="is-highlight"><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
            <td><span class="no" aria-hidden="true">&#10005;</span><span class="visually-hidden">No</span></td>
          </tr>
          <tr data-same>
            <th scope="row">Open fire</th>
            <td><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
            <td class="is-highlight"><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
            <td><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
          </tr>
          <tr>
            <th scope="row">Oven-safe lid</th>
            <td><span class="no" aria-hidden="true">&#10005;</span><span class="visually-hidden">No</span></td>
            <td class="is-highlight"><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
            <td>No lid &mdash; use foil</td>
          </tr>
          <tr class="compare__group"><th scope="rowgroup" colspan="4">Carry</th></tr>
          <tr>
            <th scope="row">Weight</th>
            <td>5.1 lb</td>
            <td class="is-highlight">13.2 lb</td>
            <td>2.4 lb</td>
          </tr>
          <tr>
            <th scope="row">Packs flat</th>
            <td><span class="no" aria-hidden="true">&#10005;</span><span class="visually-hidden">No</span></td>
            <td class="is-highlight"><span class="no" aria-hidden="true">&#10005;</span><span class="visually-hidden">No</span></td>
            <td><span class="yes" aria-hidden="true">&#10003;</span><span class="visually-hidden">Yes</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="compare__notes">Weights in pounds, without lids. Open fire = directly on coals or over a fire ring.</p>
  </div>
</section>

<script>
  const root = document.getElementById("commerce-product-comparison");
  if (root) {
    const toggle = root.querySelector<HTMLInputElement>("[data-hide-same]");
    toggle?.addEventListener("change", () => {
      root.querySelectorAll<HTMLElement>("tr[data-same]").forEach((tr) => { tr.hidden = toggle.checked; });
    });
  }
</script>

<style>
  .compare__toggle { display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; font-size: 0.9375rem; }
  .compare__scroll { position: relative; overflow: auto; max-height: 80vh; border: 1px solid var(--line); border-radius: var(--radius); }
  .compare table { width: 100%; min-width: 640px; border-collapse: separate; border-spacing: 0; font-size: 0.9375rem; }
  .compare th, .compare td { padding: 0.875rem 1rem; text-align: center; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .compare thead th { position: sticky; top: 0; z-index: 2; background: var(--bg); vertical-align: bottom; }
  .compare tbody th[scope="row"] { text-align: left; font-weight: 600; position: sticky; left: 0; background: var(--bg); z-index: 1; }
  .compare__corner { text-align: left !important; left: 0; z-index: 3 !important; color: var(--ink-3); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .compare__product { display: grid; justify-items: center; gap: 0.375rem; }
  .compare__product img { width: 96px; height: 96px; object-fit: cover; border-radius: var(--radius); }
  .compare__name { font-weight: 700; }
  .compare__price { color: var(--ink-2); font-weight: 500; }
  .compare__product .btn { min-height: 36px; font-size: 0.875rem; }
  .compare__pick { margin-bottom: 0.25rem; }
  .compare .is-highlight { background: color-mix(in srgb, var(--brand-soft) 55%, var(--bg)); }
  .compare thead th.is-highlight { box-shadow: inset 0 3px 0 var(--brand); }
  .compare__group th { text-align: left; background: var(--surface); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); padding-block: 0.5rem; }
  .yes { color: var(--success); font-weight: 700; font-size: 1.125rem; }
  .no { color: var(--ink-3); font-size: 1rem; }
  .compare__notes { margin-top: 0.875rem; font-size: 0.8125rem; color: var(--ink-3); }
</style>
