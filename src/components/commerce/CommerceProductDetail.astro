<script>
  const root = document.getElementById("commerce-product-detail");
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>(".pdp__slide");
    const thumbs = root.querySelectorAll<HTMLButtonElement>("[data-thumb]");
    const show = (i: number) => {
      slides.forEach((s, n) => s.classList.toggle("is-active", n === i));
      thumbs.forEach((t, n) => t.setAttribute("aria-selected", String(n === i)));
    };
    thumbs.forEach((t) => t.addEventListener("click", () => show(Number(t.dataset.thumb))));

    type Variant = { sku: string; price: number; stock: number };
    const variants: Record<string, Variant> = {
      "5.5 qt / Bare iron": { sku: "ED-55-BI", price: 165, stock: 38 },
      "5.5 qt / Ember red": { sku: "ED-55-ER", price: 185, stock: 12 },
      "3.5 qt / Bare iron": { sku: "ED-35-BI", price: 129, stock: 0 },
    };
    const form = root.querySelector<HTMLFormElement>(".pdp__form");
    const set = (sel: string, text: string) => {
      const el = root.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };
    const update = () => {
      if (!form) return;
      const data = new FormData(form);
      const size = String(data.get("size"));
      const finish = String(data.get("finish"));
      set("[data-size-label]", size);
      set("[data-finish-label]", finish);
      const v = variants[`${size} / ${finish}`];
      const add = root.querySelector<HTMLButtonElement>("[data-add]");
      if (!v) {
        set("[data-stock]", "Preorder · back in stock November 12");
        set("[data-sku]", "—");
        if (add) add.textContent = "Preorder";
        return;
      }
      set("[data-price]", `$${v.price}`);
      set("[data-save]", `Save $${195 - v.price}`);
      set("[data-sku]", v.sku);
      if (v.stock === 0) {
        set("[data-stock]", "Out of stock · preorder ships November 12");
        if (add) add.textContent = "Preorder";
      } else {
        set("[data-stock]", v.stock < 10 ? `Only ${v.stock} left` : "In stock · ships in 1–2 days");
        if (add) add.textContent = "Add to cart";
      }
      if (finish === "Ember red") show(1);
      else if (finish === "Bare iron") show(0);
    };
    form?.addEventListener("change", update);
    form?.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

