---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<section id="commerce-bundle-builder" class="section section--muted bundle">
  <!-- kit: commerce-bundle-builder -->
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">Build your camp kit</span>
      <h2>Pick 3, save 15%</h2>
      <p class="lead">Choose any three pieces from the camp range. Save 10% on two, 15% on three, 20% on four.</p>
    </div>

    <ol class="bundle__tiers" role="list" aria-label="Bundle discounts">
      <li data-tier="2"><strong>2 items</strong><span>Save 10%</span></li>
      <li data-tier="3"><strong>3 items</strong><span>Save 15%</span></li>
      <li data-tier="4"><strong>4 items</strong><span>Save 20%</span></li>
    </ol>

    <form class="bundle__form" action={bcmsFormAction("Choose 2 to 4 products")} method={bcmsFormMethod("Choose 2 to 4 products")} data-bcms-form={bcmsFormId("Choose 2 to 4 products")} data-bcms-form-success="Thank you for your submission!">
      <fieldset class="bundle__products">
        <legend class="visually-hidden">Choose 2 to 4 products</legend>
        <label class="bundle__item" data-bcms-form-field="items">
          <input type="checkbox" name="items" value="cable-fold" data-price="89" />
          <img src="https://picsum.photos/seed/caldera-cable-fold-card/600/600" alt="Cable Fold Grill folded flat" width="600" height="600" loading="lazy" />
          <span class="bundle__name">Cable Fold Grill</span>
          <span class="bundle__price">$89</span>
          <span class="bundle__check" aria-hidden="true"></span>
        </label>
        <label class="bundle__item">
          <input type="checkbox" name="items" value="ember-dutch-oven" data-price="165" />
          <img src="https://picsum.photos/seed/caldera-dutch-coals/600/600" alt="Ember Dutch Oven in coals" width="600" height="600" loading="lazy" />
          <span class="bundle__name">Ember Dutch Oven 5.5qt</span>
          <span class="bundle__price">$165</span>
          <span class="bundle__check" aria-hidden="true"></span>
        </label>
        <label class="bundle__item">
          <input type="checkbox" name="items" value="ridge-skillet" data-price="95" />
          <img src="https://picsum.photos/seed/caldera-ridge-skillet/600/600" alt="Ridge Skillet on a burner" width="600" height="600" loading="lazy" />
          <span class="bundle__name">Ridge Skillet 10"</span>
          <span class="bundle__price">$95</span>
          <span class="bundle__check" aria-hidden="true"></span>
        </label>
        <label class="bundle__item">
          <input type="checkbox" name="items" value="trail-kettle" data-price="49" />
          <img src="https://picsum.photos/seed/caldera-trail-kettle/600/600" alt="Trail Kettle steaming on a rock" width="600" height="600" loading="lazy" />
          <span class="bundle__name">Trail Kettle 1.2L</span>
          <span class="bundle__price">$49</span>
          <span class="bundle__check" aria-hidden="true"></span>
        </label>
      </fieldset>

      <div class="bundle__summary" data-bcms-form-field="discount">
        <p class="bundle__status" aria-live="polite" data-status>Pick at least 2 pieces to unlock your discount.</p>
        <p class="bundle__total"><s data-was hidden></s> <strong data-total>$0</strong></p>
        <input type="hidden" name="discount" value="BUNDLE-CAMPKIT-AUTO" />
        <button class="btn btn-primary" type="submit" data-submit disabled data-bcms-form-part="submit">Add kit to cart</button>
        <p class="bundle__note">Gift cards and the Ember Pizza Oven aren't included.</p>
      </div>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
  </div>
</section>

<script>
  const root = document.getElementById("commerce-bundle-builder");
  if (root) {
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="items"]'));
    const tiers: Record<number, number> = { 2: 10, 3: 15, 4: 20 };
    const status = root.querySelector<HTMLElement>("[data-status]");
    const total = root.querySelector<HTMLElement>("[data-total]");
    const was = root.querySelector<HTMLElement>("[data-was]");
    const submit = root.querySelector<HTMLButtonElement>("[data-submit]");
    const update = () => {
      const picked = boxes.filter((b) => b.checked);
      const sum = picked.reduce((n, b) => n + Number(b.dataset.price), 0);
      const pct = tiers[picked.length] ?? 0;
      const final = Math.round(sum * (1 - pct / 100));
      root.querySelectorAll<HTMLElement>("[data-tier]").forEach((t) => t.classList.toggle("is-active", Number(t.dataset.tier) === picked.length));
      if (total) total.textContent = `$${final}`;
      if (was) { was.hidden = pct === 0; was.textContent = `$${sum}`; }
      if (status) status.textContent = picked.length < 2 ? `Pick ${2 - picked.length} more to unlock your discount.` : `${picked.length} pieces · you save ${pct}%`;
      if (submit) submit.disabled = picked.length < 2;
    };
    boxes.forEach((b) => b.addEventListener("change", update));
    root.querySelector("form")?.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style>
  .bundle__tiers { list-style: none; margin: 0 auto 2rem; padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem; }
  .bundle__tiers li { display: grid; text-align: center; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); min-width: 104px; transition: all 150ms ease; }
  .bundle__tiers li span { font-size: 0.8125rem; color: var(--brand); font-weight: 600; }
  .bundle__tiers li.is-active { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .bundle__form { display: grid; gap: 2rem; }
  @media (min-width: 960px) { .bundle__form { grid-template-columns: 1fr 300px; align-items: start; } }
  .bundle__products { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (min-width: 720px) { .bundle__products { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bundle__item { position: relative; display: grid; gap: 0.25rem; padding: 0.75rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; }
  .bundle__item input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .bundle__item img { border-radius: var(--radius-sm); aspect-ratio: 1; object-fit: cover; width: 100%; }
  .bundle__name { font-weight: 600; font-size: 0.9375rem; margin-top: 0.5rem; line-height: 1.3; }
  .bundle__price { color: var(--ink-2); font-size: 0.875rem; }
  .bundle__check { position: absolute; top: 1.25rem; right: 1.25rem; width: 26px; height: 26px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line); }
  .bundle__item:has(input:checked) { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .bundle__item:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bundle__item input:checked ~ .bundle__check { background: var(--brand); border-color: var(--brand); }
  .bundle__item input:checked ~ .bundle__check::after { content: ""; position: absolute; left: 7px; top: 3px; width: 6px; height: 11px; border: solid #fff; border-width: 0 2px 2px 0; rotate: 45deg; }
  .bundle__summary { padding: 1.5rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 0.75rem; }
  .bundle__summary p { margin: 0; }
  .bundle__status { font-weight: 600; }
  .bundle__total { font-size: 1.75rem; }
  .bundle__total s { font-size: 1.125rem; color: var(--ink-3); }
  .bundle__summary .btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  .bundle__note { font-size: 0.8125rem; color: var(--ink-3); }
</style>
