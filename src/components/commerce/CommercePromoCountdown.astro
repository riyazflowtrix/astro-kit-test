<section id="commerce-promo-countdown" class="section promo">
  <!-- kit: commerce-promo-countdown -->
  <div class="container">
    <div class="promo__bar" role="region" aria-label="Fireside Sale" data-ends="2026-11-02T23:59:00-08:00">
      <p class="promo__message">Fireside Sale: 20% off all cast iron</p>
      <div class="promo__code">
        <span>Code</span>
        <button type="button" class="promo__copy" data-copy="FIRESIDE20" aria-label="Copy code FIRESIDE20">FIRESIDE20</button>
        <span class="promo__auto">Applied at checkout</span>
      </div>
      <div class="promo__timer" aria-label="Time left in the sale" data-timer>
        <span><strong data-unit="d">00</strong>d</span>
        <span><strong data-unit="h">00</strong>h</span>
        <span><strong data-unit="m">00</strong>m</span>
        <span><strong data-unit="s">00</strong>s</span>
      </div>
      <p class="promo__ended" data-ended hidden>The sale's over &mdash; free shipping still applies over $80.</p>
      <a class="promo__link" href="/collections/cast-iron">Shop the sale <span aria-hidden="true">&rarr;</span></a>
      <button type="button" class="promo__close" aria-label="Dismiss promotion" data-dismiss>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("commerce-promo-countdown");
  const bar = root?.querySelector<HTMLElement>(".promo__bar");
  if (root && bar) {
    const ends = new Date(bar.dataset.ends ?? "").getTime();
    const timer = bar.querySelector<HTMLElement>("[data-timer]");
    const ended = bar.querySelector<HTMLElement>("[data-ended]");
    const pad = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      const left = Math.max(0, ends - Date.now());
      if (left === 0) {
        if (timer) timer.hidden = true;
        if (ended) ended.hidden = false;
        bar.querySelector<HTMLElement>(".promo__message")?.setAttribute("hidden", "");
        bar.querySelector<HTMLElement>(".promo__code")?.setAttribute("hidden", "");
        return false;
      }
      const s = Math.floor(left / 1000);
      const parts: Record<string, number> = { d: Math.floor(s / 86400), h: Math.floor((s % 86400) / 3600), m: Math.floor((s % 3600) / 60), s: s % 60 };
      bar.querySelectorAll<HTMLElement>("[data-unit]").forEach((el) => { el.textContent = pad(parts[el.dataset.unit ?? "s"]); });
      return true;
    };
    if (tick()) {
      const id = window.setInterval(() => { if (!tick()) window.clearInterval(id); }, 1000);
    }
    const copy = bar.querySelector<HTMLButtonElement>("[data-copy]");
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? "");
        copy.textContent = "Copied!";
        window.setTimeout(() => { copy.textContent = copy.dataset.copy ?? ""; }, 1500);
      } catch {
        /* clipboard not available */
      }
    });
    bar.querySelector("[data-dismiss]")?.addEventListener("click", () => { bar.hidden = true; });
  }
</script>

<style>
  .promo { padding-block: 2rem; }
  .promo__bar { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem 1.5rem; padding: 0.875rem 3rem 0.875rem 1.25rem; border-radius: var(--radius); background: var(--brand); color: var(--brand-ink); text-align: center; }
  .promo__bar[hidden] { display: none; }
  .promo__message, .promo__ended { margin: 0; font-weight: 700; }
  .promo__code { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; flex-wrap: wrap; justify-content: center; }
  .promo__code[hidden] { display: none; }
  .promo__copy { font: inherit; font-family: var(--font-mono); font-weight: 700; letter-spacing: 0.06em; padding: 0.25rem 0.625rem; border: 1px dashed rgb(255 255 255 / 0.7); border-radius: var(--radius-sm); background: rgb(255 255 255 / 0.12); color: inherit; cursor: pointer; min-height: 32px; }
  .promo__auto { opacity: 0.8; }
  .promo__timer { display: flex; gap: 0.375rem; font-size: 0.8125rem; }
  .promo__timer span { display: inline-flex; align-items: baseline; gap: 1px; padding: 0.25rem 0.5rem; border-radius: var(--radius-sm); background: rgb(0 0 0 / 0.18); }
  .promo__timer[hidden] { display: none; }
  .promo__timer strong { font-variant-numeric: tabular-nums; font-size: 1rem; }
  .promo__link { font-weight: 700; text-underline-offset: 3px; }
  .promo__close { position: absolute; top: 50%; right: 0.5rem; translate: 0 -50%; display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
  .promo__close:hover { background: rgb(0 0 0 / 0.15); }
  @media (max-width: 600px) { .promo__close { top: 0.5rem; translate: none; } }
</style>
