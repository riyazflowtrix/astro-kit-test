---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Store",
    name: "Caldera Bend",
    telephone: "+1 541 555 0182",
    address: { "@type": "PostalAddress", streetAddress: "1020 NW Wall St", addressLocality: "Bend", addressRegion: "OR", postalCode: "97703", addressCountry: "US" },
    geo: { "@type": "GeoCoordinates", latitude: 44.0596, longitude: -121.3133 },
    openingHours: ["Mo-Fr 10:00-18:00", "Sa 09:00-18:00", "Su 11:00-16:00"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Store",
    name: "Caldera Portland",
    telephone: "+1 503 555 0147",
    address: { "@type": "PostalAddress", streetAddress: "2311 SE Division St", addressLocality: "Portland", addressRegion: "OR", postalCode: "97202", addressCountry: "US" },
    geo: { "@type": "GeoCoordinates", latitude: 45.5047, longitude: -122.6406 },
    openingHours: ["Tu-Su 10:00-19:00"],
  },
]);
---

<section id="commerce-store-locator" class="section locator">
  <!-- kit: commerce-store-locator -->
  <div class="container">
    <div class="section-head">
      <h2>Find Caldera near you</h2>
      <p class="lead">Two Caldera stores in Oregon, and 140 outfitters across the US who stock the range.</p>
    </div>

    <form class="locator__search" action={bcmsFormAction("Location type")} method={bcmsFormMethod("Location type")} role="search" data-bcms-form={bcmsFormId("Location type")} data-bcms-form-success="Thank you for your submission!">
      <div class="field" data-bcms-form-field="q">
        <label for="locator-query" data-bcms-form-part="label">City or ZIP code</label>
        <input id="locator-query" name="q" type="search" placeholder="e.g. Bend or 97703" autocomplete="postal-code" />
      </div>
      <div class="field" data-bcms-form-field="radius">
        <label for="locator-radius" data-bcms-form-part="label">Within</label>
        <select id="locator-radius" name="radius">
          <option value="25">25 miles</option>
          <option value="50" selected>50 miles</option>
          <option value="100">100 miles</option>
        </select>
      </div>
      <fieldset class="locator__types">
        <legend class="visually-hidden">Location type</legend>
        <label data-bcms-form-field="type"><input type="checkbox" name="type" value="flagship" checked /> Caldera stores</label>
        <label><input type="checkbox" name="type" value="stockist" checked /> Stockists</label>
      </fieldset>
      <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Search</button>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

    <div class="locator__layout">
      <ol class="locator__list" role="list">
        <li class="locator__card">
          <div class="locator__top">
            <h3>Caldera Bend</h3>
            <span class="badge">Flagship</span>
          </div>
          <address>1020 NW Wall St<br />Bend, OR 97703</address>
          <p><a href="tel:+15415550182">(541) 555-0182</a> &middot; <a href="https://www.openstreetmap.org/?mlat=44.0596&mlon=-121.3133#map=16/44.0596/-121.3133" target="_blank" rel="noopener">Directions</a></p>
          <dl class="locator__hours">
            <div><dt>Mon&ndash;Fri</dt><dd>10:00 &ndash; 18:00</dd></div>
            <div><dt>Sat</dt><dd>09:00 &ndash; 18:00</dd></div>
            <div><dt>Sun</dt><dd>11:00 &ndash; 16:00</dd></div>
          </dl>
          <p class="locator__closed">Closed Nov 26 (Thanksgiving) and Dec 25 (Christmas Day)</p>
          <ul class="locator__services" role="list" aria-label="Services">
            <li>Re-seasoning</li>
            <li>Engraving</li>
            <li>Warranty swaps</li>
          </ul>
        </li>
        <li class="locator__card">
          <div class="locator__top">
            <h3>Caldera Portland</h3>
            <span class="badge">Flagship</span>
          </div>
          <address>2311 SE Division St<br />Portland, OR 97202</address>
          <p><a href="tel:+15035550147">(503) 555-0147</a> &middot; <a href="https://www.openstreetmap.org/?mlat=45.5047&mlon=-122.6406#map=16/45.5047/-122.6406" target="_blank" rel="noopener">Directions</a></p>
          <dl class="locator__hours">
            <div><dt>Tue&ndash;Sun</dt><dd>10:00 &ndash; 19:00</dd></div>
            <div><dt>Mon</dt><dd>Closed</dd></div>
          </dl>
          <ul class="locator__services" role="list" aria-label="Services">
            <li>Re-seasoning</li>
          </ul>
        </li>
      </ol>

      <div class="locator__map">
        <iframe
          title="Map of Caldera stores in Oregon"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-124.2%2C43.4%2C-119.8%2C46.0&amp;layer=mapnik"
          width="800"
          height="600"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</section>

<style>
  .locator__search { display: grid; grid-template-columns: 1fr; gap: 1rem; align-items: end; padding: 1.25rem; margin-bottom: 1.5rem; background: var(--surface); border-radius: var(--radius); }
  @media (min-width: 760px) { .locator__search { grid-template-columns: 2fr 1fr auto auto; } }
  .locator__types { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; min-height: 44px; align-items: center; font-size: 0.9375rem; }
  .locator__types label { display: flex; gap: 0.375rem; align-items: center; }
  .locator__layout { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .locator__layout { grid-template-columns: 380px 1fr; } }
  .locator__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; align-content: start; }
  .locator__card { padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .locator__top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  .locator__top h3 { margin: 0; font-size: 1.125rem; }
  .locator__card address { font-style: normal; color: var(--ink-2); margin-bottom: 0.5rem; }
  .locator__card p { font-size: 0.9375rem; margin-bottom: 0.75rem; }
  .locator__hours { margin: 0 0 0.75rem; display: grid; gap: 0.125rem; font-size: 0.875rem; }
  .locator__hours div { display: flex; justify-content: space-between; gap: 1rem; }
  .locator__hours dt { color: var(--ink-2); }
  .locator__hours dd { margin: 0; font-variant-numeric: tabular-nums; }
  .locator__closed { font-size: 0.8125rem !important; color: var(--warning); }
  .locator__services { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .locator__services li { font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: 999px; background: var(--surface-2); }
  .locator__map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); min-height: 360px; background: var(--surface); }
  .locator__map iframe { width: 100%; height: 100%; min-height: 360px; border: 0; }
</style>
