      <div class="cart-xsell__ship">
        <p>You've unlocked <strong>free shipping</strong>.</p>
        <div class="cart-xsell__bar" role="progressbar" aria-label="Progress to free shipping" aria-valuemin="0" aria-valuemax="80" aria-valuenow="80"><span style="width:100%"></span></div>
      </div>
      <ul class="cart-xsell__lines" role="list">
