      <ul class="cart-xsell__list" role="list">
        <li class="cart-xsell__offer">
          <img src="https://picsum.photos/seed/caldera-ridge-skillet/240/240" alt="Ridge Skillet on a burner" width="240" height="240" loading="lazy" />
          <div class="cart-xsell__offer-body">
            <p class="cart-xsell__name">Ridge Skillet 10"</p>
            <p class="cart-xsell__price"><strong>$85.50</strong> <s>$95</s> <span class="badge">10% off</span></p>
          </div>
          <form action="#" method="post"><input type="hidden" name="product" value="ridge-skillet" /><button class="btn btn-secondary" type="submit" aria-label="Add Ridge Skillet 10 inch to cart">Add</button></form>
        </li>
        <li class="cart-xsell__offer">
          <img src="https://picsum.photos/seed/caldera-cable-fold-card/240/240" alt="Cable Fold Grill folded flat" width="240" height="240" loading="lazy" />
          <div class="cart-xsell__offer-body">
            <p class="cart-xsell__name">Cable Fold Grill</p>
            <p class="cart-xsell__price"><strong>$80.10</strong> <s>$89</s> <span class="badge">10% off</span></p>
          </div>
          <form action="#" method="post"><input type="hidden" name="product" value="cable-fold" /><button class="btn btn-secondary" type="submit" aria-label="Add Cable Fold Grill to cart">Add</button></form>
        </li>
        <li class="cart-xsell__offer">
          <img src="https://picsum.photos/seed/caldera-trail-kettle/240/240" alt="Trail Kettle steaming on a rock" width="240" height="240" loading="lazy" />
          <div class="cart-xsell__offer-body">
            <p class="cart-xsell__name">Trail Kettle 1.2L</p>
            <p class="cart-xsell__price"><strong>$49</strong></p>
          </div>
          <form action="#" method="post"><input type="hidden" name="product" value="trail-kettle" /><button class="btn btn-secondary" type="submit" aria-label="Add Trail Kettle to cart">Add</button></form>
        </li>
      </ul>
    </div>
  </div>
</section>

