<section id="commerce-collection-header-facets" class="section collection-header">
  <!-- kit: commerce-collection-header-facets -->
  <div class="container">
    <div class="collection-header__banner">
      <img src="https://picsum.photos/seed/caldera-castiron-banner/1600/500" alt="A row of cast iron skillets hanging on a workshop wall" width="1600" height="500" />
      <div class="collection-header__overlay">
        <h2 class="collection-header__title">Cast iron</h2>
        <p>Skillets, Dutch ovens and griddles poured in Bend, Oregon. Pre-seasoned, ready for coals, guaranteed for life.</p>
      </div>
    </div>

    <div class="collection-header__toolbar">
      <p class="collection-header__count" aria-live="polite"><strong>14</strong> products</p>
      <button class="btn btn-secondary collection-header__toggle" type="button" aria-expanded="false" aria-controls="collection-filters">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        Filters
      </button>
      <div class="field collection-header__sort">
        <label for="collection-sort">Sort by</label>
        <select id="collection-sort" name="sort">
          <option value="featured" selected>Featured</option>
          <option value="bestselling">Best selling</option>
          <option value="newest">Newest</option>
          <option value="price-asc">Price, low to high</option>
          <option value="price-desc">Price, high to low</option>
        </select>
      </div>
    </div>

    <form id="collection-filters" class="collection-header__filters" action="#" method="get" aria-label="Filter products">
      <fieldset class="facet">
        <legend>Product type</legend>
        <div class="facet__pills">
          <label><input type="checkbox" name="productType" value="Skillets" /><span>Skillets <em>(6)</em></span></label>
          <label><input type="checkbox" name="productType" value="Dutch ovens" /><span>Dutch ovens <em>(4)</em></span></label>
          <label><input type="checkbox" name="productType" value="Griddles" /><span>Griddles <em>(3)</em></span></label>
          <label><input type="checkbox" name="productType" value="Accessories" /><span>Accessories <em>(1)</em></span></label>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Finish</legend>
        <div class="facet__swatches">
          <label><input type="checkbox" name="finish" value="Bare iron" /><span class="facet__swatch" style="background:#1E1B18"></span>Bare iron</label>
          <label><input type="checkbox" name="finish" value="Ember red" /><span class="facet__swatch" style="background:#B33A24"></span>Ember red</label>
          <label><input type="checkbox" name="finish" value="Speckled sage" /><span class="facet__swatch" style="background:#7D8F74"></span>Speckled sage</label>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Price</legend>
        <div class="facet__range">
          <div class="field">
            <label for="collection-price-min">Min ($)</label>
            <input id="collection-price-min" name="priceMin" type="number" min="0" step="10" value="0" inputmode="numeric" />
          </div>
          <span aria-hidden="true">&ndash;</span>
          <div class="field">
            <label for="collection-price-max">Max ($)</label>
            <input id="collection-price-max" name="priceMax" type="number" min="0" step="10" value="250" inputmode="numeric" />
          </div>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Availability</legend>
        <label class="facet__check"><input type="checkbox" name="inStock" value="1" /> In stock only <em>(12)</em></label>
      </fieldset>
    </form>
  </div>
</section>

<script>
  const root = document.getElementById("commerce-collection-header-facets");
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>(".collection-header__toggle");
    const panel = root.querySelector<HTMLElement>(".collection-header__filters");
    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel?.classList.toggle("is-open", open);
    });
  }
</script>

<style>
  .collection-header__banner { position: relative; border-radius: var(--radius-lg); overflow: hidden; min-height: 240px; background: var(--dark); }
  .collection-header__banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .collection-header__overlay { position: relative; padding: clamp(1.5rem, 5vw, 3.5rem); color: #fff; background: linear-gradient(90deg, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0.1)); min-height: 240px; display: flex; flex-direction: column; justify-content: flex-end; }
  .collection-header__title { font-size: clamp(2rem, 5vw, 3.25rem); margin-bottom: 0.5rem; }
  .collection-header__overlay p { max-width: 52ch; margin: 0; color: rgb(255 255 255 / 0.88); }
  .collection-header__toolbar { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin: 1.5rem 0 1rem; }
  .collection-header__count { margin: 0; color: var(--ink-2); }
  .collection-header__sort { min-width: 200px; }
  .collection-header__toggle { display: none; }
  .collection-header__filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  @media (max-width: 719px) {
    .collection-header__toggle { display: inline-flex; }
    .collection-header__sort { min-width: 0; flex: 1 1 100%; }
    .collection-header__filters { display: none; }
    .collection-header__filters.is-open { display: grid; }
  }
  .facet { border: 0; margin: 0; padding: 0; min-width: 0; }
  .facet legend { font-weight: 600; margin-bottom: 0.75rem; font-size: 0.9375rem; }
  .facet em { font-style: normal; color: var(--ink-3); }
  .facet__pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .facet__pills input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .facet__pills span { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.875rem; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); font-size: 0.875rem; cursor: pointer; }
  .facet__pills input:checked + span { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .facet__pills input:checked + span em { color: inherit; }
  .facet__pills input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .facet__swatches { display: grid; gap: 0.5rem; }
  .facet__swatches label, .facet__check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; cursor: pointer; }
  .facet__swatch { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.15); }
  .facet__range { display: flex; align-items: end; gap: 0.5rem; }
  .facet__range > span { padding-bottom: 0.75rem; }
  .facet__range .field { flex: 1; min-width: 0; }
</style>
