---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<section id="commerce-collection-header-facets" class="section collection-header">
  <!-- kit: commerce-collection-header-facets -->
  <div class="container">
    <div class="collection-header__banner">
      <img src="https://picsum.photos/seed/caldera-castiron-banner/1600/500" alt="A row of cast iron skillets hanging on a workshop wall" width="1600" height="500" />
      <div class="collection-header__overlay">
        <h2 class="collection-header__title">Cast iron</h2>
        <p>Skillets, Dutch ovens and griddles poured in Bend, Oregon. Pre-seasoned, ready for coals, guaranteed for life.</p>
      </div>
    </div>

    <div class="collection-header__toolbar">
      <p class="collection-header__count" aria-live="polite"><strong>14</strong> products</p>
      <button class="btn btn-secondary collection-header__toggle" type="button" aria-expanded="false" aria-controls="collection-filters">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        Filters
      </button>
      <div class="field collection-header__sort">
        <label for="collection-sort">Sort by</label>
        <select id="collection-sort" name="sort">
          <option value="featured" selected>Featured</option>
          <option value="bestselling">Best selling</option>
          <option value="newest">Newest</option>
          <option value="price-asc">Price, low to high</option>
          <option value="price-desc">Price, high to low</option>
        </select>
      </div>
    </div>

    <form id="collection-filters" class="collection-header__filters" action={bcmsFormAction("Filter products")} method={bcmsFormMethod("Filter products")} aria-label="Filter products" data-bcms-form={bcmsFormId("Filter products")} data-bcms-form-success="Thank you for your submission!">
      <fieldset class="facet">
        <legend>Product type</legend>
        <div class="facet__pills">
          <label data-bcms-form-field="productType"><input type="checkbox" name="productType" value="Skillets" /><span>Skillets <em>(6)</em></span></label>
          <label><input type="checkbox" name="productType" value="Dutch ovens" /><span>Dutch ovens <em>(4)</em></span></label>
          <label><input type="checkbox" name="productType" value="Griddles" /><span>Griddles <em>(3)</em></span></label>
          <label><input type="checkbox" name="productType" value="Accessories" /><span>Accessories <em>(1)</em></span></label>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Finish</legend>
        <div class="facet__swatches">
          <label data-bcms-form-field="finish"><input type="checkbox" name="finish" value="Bare iron" /><span class="facet__swatch" style="background:#1E1B18"></span>Bare iron</label>
          <label><input type="checkbox" name="finish" value="Ember red" /><span class="facet__swatch" style="background:#B33A24"></span>Ember red</label>
          <label><input type="checkbox" name="finish" value="Speckled sage" /><span class="facet__swatch" style="background:#7D8F74"></span>Speckled sage</label>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Price</legend>
        <div class="facet__range">
          <div class="field" data-bcms-form-field="priceMin">
            <label for="collection-price-min" data-bcms-form-part="label">Min ($)</label>
            <input id="collection-price-min" name="priceMin" type="number" min="0" step="10" value="0" inputmode="numeric" />
          </div>
          <span aria-hidden="true">&ndash;</span>
          <div class="field" data-bcms-form-field="priceMax">
            <label for="collection-price-max" data-bcms-form-part="label">Max ($)</label>
            <input id="collection-price-max" name="priceMax" type="number" min="0" step="10" value="250" inputmode="numeric" />
          </div>
        </div>
      </fieldset>

      <fieldset class="facet">
        <legend>Availability</legend>
        <label class="facet__check" data-bcms-form-field="inStock"><input type="checkbox" name="inStock" value="1" /> In stock only <em>(12)</em></label>
      </fieldset>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
  </div>
</section>

<script>
  const root = document.getElementById("commerce-collection-header-facets");
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>(".collection-header__toggle");
    const panel = root.querySelector<HTMLElement>(".collection-header__filters");
    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel?.classList.toggle("is-open", open);
    });
  }
</script>

<style>
  .collection-header__banner { position: relative; border-radius: var(--radius-lg); overflow: hidden; min-height: 240px; background: var(--dark); }
  .collection-header__banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .collection-header__overlay { position: relative; padding: clamp(1.5rem, 5vw, 3.5rem); color: #fff; background: linear-gradient(90deg, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0.1)); min-height: 240px; display: flex; flex-direction: column; justify-content: flex-end; }
  .collection-header__title { font-size: clamp(2rem, 5vw, 3.25rem); margin-bottom: 0.5rem; }
  .collection-header__overlay p { max-width: 52ch; margin: 0; color: rgb(255 255 255 / 0.88); }
  .collection-header__toolbar { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin: 1.5rem 0 1rem; }
  .collection-header__count { margin: 0; color: var(--ink-2); }
  .collection-header__sort { min-width: 200px; }
  .collection-header__toggle { display: none; }
  .collection-header__filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  @media (max-width: 719px) {
    .collection-header__toggle { display: inline-flex; }
    .collection-header__sort { min-width: 0; flex: 1 1 100%; }
    .collection-header__filters { display: none; }
    .collection-header__filters.is-open { display: grid; }
  }
  .facet { border: 0; margin: 0; padding: 0; min-width: 0; }
  .facet legend { font-weight: 600; margin-bottom: 0.75rem; font-size: 0.9375rem; }
  .facet em { font-style: normal; color: var(--ink-3); }
  .facet__pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .facet__pills input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .facet__pills span { display: inline-flex; align-items: center; min-height: 36px; padding: 0 0.875rem; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); font-size: 0.875rem; cursor: pointer; }
  .facet__pills input:checked + span { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .facet__pills input:checked + span em { color: inherit; }
  .facet__pills input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .facet__swatches { display: grid; gap: 0.5rem; }
  .facet__swatches label, .facet__check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; cursor: pointer; }
  .facet__swatch { width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgb(0 0 0 / 0.15); }
  .facet__range { display: flex; align-items: end; gap: 0.5rem; }
  .facet__range > span { padding-bottom: 0.75rem; }
  .facet__range .field { flex: 1; min-width: 0; }
</style>
