---
import categories from "../../data/categories.json";
---

<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__logo">Kit Site</a>
    <nav aria-label="Categories">
      <ul class="site-header__links">
        {categories.map((c) => (
          <li><a href={`/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 60px;
  }

  .site-header__logo {
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-header__links {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
    font-size: 0.875rem;
  }

  .site-header__links a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-header__links a:hover {
    color: var(--ink);
  }
</style>
