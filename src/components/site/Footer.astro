---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p>Kit Site: every BetterCMS Kit section, as a plain Astro site.</p>
    <p>© {year} Flowtrix</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer p {
    margin: 0;
  }
</style>
