  }

  .cc__inner {
    padding-block: 1.25rem;
  }

  .cc__main {
    display: flex;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .cc__main[hidden],
  .cc__prefs[hidden],
  .cc__saved[hidden] {
    display: none;
  }

  .cc__copy {
    flex: 1;
  }

  .cc__title {
    margin-bottom: 0.25rem;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .cc__copy p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .cc__copy a {
    color: var(--ink);
    font-weight: 600;
  }

  .cc__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cc__prefs {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .cc__prefs fieldset {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cc__cat {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cc__cat input {
    width: 18px;
    height: 18px;
    margin-top: 0.2rem;
    accent-color: var(--brand);
    flex-shrink: 0;
  }

  .cc__cat label {
    display: grid;
    gap: 0.125rem;
    cursor: pointer;
  }

  .cc__cat span {
    font-size: 0.875rem;
