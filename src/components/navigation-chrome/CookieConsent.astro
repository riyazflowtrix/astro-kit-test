---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<div id="cookie-consent" class="cc" role="region" aria-labelledby="cookie-consent-title" data-variant="bar">
  <!-- kit: cookie-consent -->
  <div class="container cc__inner">
    <div class="cc__main">
      <div class="cc__copy">
        <h2 id="cookie-consent-title" class="cc__title">Cookies, briefly</h2>
        <p>We use essential cookies to run this site and, if you agree, analytics to see which stories help rivers most. We never sell your data. <a href="/privacy/cookies">Cookie policy</a></p>
      </div>
      <div class="cc__buttons">
        <button type="button" class="btn btn-secondary" data-action="customize" aria-expanded="false" aria-controls="cookie-consent-prefs">Choose cookies</button>
        <button type="button" class="btn btn-secondary" data-action="reject">Reject all</button>
        <button type="button" class="btn btn-primary" data-action="accept">Accept all</button>
      </div>
    </div>

    <form class="cc__prefs" id="cookie-consent-prefs" action={bcmsFormAction("Cookie categories")} hidden method={bcmsFormMethod("Cookie categories")} data-bcms-form={bcmsFormId("Cookie categories")} data-bcms-form-success="Thank you for your submission!">
      <fieldset>
        <legend class="visually-hidden">Cookie categories</legend>
        <div class="cc__cat" data-bcms-form-field="essential">
          <input type="checkbox" id="cookie-consent-essential" name="essential" checked disabled />
          <label for="cookie-consent-essential" data-bcms-form-part="label">
            <strong>Essential</strong>
            <span>Keeps you signed in and remembers this choice. Always on.</span>
          </label>
        </div>
        <div class="cc__cat" data-bcms-form-field="analytics">
          <input type="checkbox" id="cookie-consent-analytics" name="analytics" />
          <label for="cookie-consent-analytics" data-bcms-form-part="label">
            <strong>Analytics</strong>
            <span>Plausible and Google Analytics, to count visits and see which pages people read.</span>
          </label>
        </div>
        <div class="cc__cat" data-bcms-form-field="marketing">
          <input type="checkbox" id="cookie-consent-marketing" name="marketing" />
          <label for="cookie-consent-marketing" data-bcms-form-part="label">
            <strong>Marketing</strong>
            <span>Meta Pixel, to show our campaigns to people who visited — and to measure if they work.</span>
          </label>
        </div>
      </fieldset>
      <button type="submit" class="btn btn-primary" data-bcms-form-part="submit">Save my choices</button>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

    <p class="cc__saved" role="status" hidden></p>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById("cookie-consent");
    if (!root) return;
    var main = root.querySelector(".cc__main");
    var prefs = root.querySelector(".cc__prefs");
    var saved = root.querySelector(".cc__saved");
    var customize = root.querySelector('[data-action="customize"]');

    function done(text) {
      main.hidden = true;
      prefs.hidden = true;
      saved.hidden = false;
      saved.innerHTML = "";
      saved.appendChild(document.createTextNode(text + " "));
      var again = document.createElement("button");
      again.type = "button";
      again.textContent = "Change";
      again.addEventListener("click", function () {
        saved.hidden = true;
        main.hidden = false;
      });
      saved.appendChild(again);
    }
    function setAll(on) {
      root.querySelectorAll('.cc__prefs input:not([disabled])').forEach(function (i) { i.checked = on; });
    }
    customize.addEventListener("click", function () {
      var open = prefs.hidden;
      prefs.hidden = !open;
      customize.setAttribute("aria-expanded", String(open));
    });
    root.querySelector('[data-action="accept"]').addEventListener("click", function () {
      setAll(true);
      done("Thanks. All cookies are on.");
    });
    root.querySelector('[data-action="reject"]').addEventListener("click", function () {
      setAll(false);
      done("Only essential cookies are on.");
    });
    prefs.addEventListener("submit", function (e) {
      e.preventDefault();
      done("Your cookie choices are saved.");
    });
  })();
</script>

<style>
  .cc {
    position: relative;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.06);
  }

  .cc__inner {
    padding-block: 1.25rem;
  }

  .cc__main {
    display: flex;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .cc__main[hidden],
  .cc__prefs[hidden],
  .cc__saved[hidden] {
    display: none;
  }

  .cc__copy {
    flex: 1;
  }

  .cc__title {
    margin-bottom: 0.25rem;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .cc__copy p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .cc__copy a {
    color: var(--ink);
    font-weight: 600;
  }

  .cc__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cc__prefs {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .cc__prefs fieldset {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cc__cat {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cc__cat input {
    width: 18px;
    height: 18px;
    margin-top: 0.2rem;
    accent-color: var(--brand);
    flex-shrink: 0;
  }

  .cc__cat label {
    display: grid;
    gap: 0.125rem;
    cursor: pointer;
  }

  .cc__cat span {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .cc__saved {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .cc__saved :global(button) {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .cc__main {
      flex-direction: column;
      align-items: stretch;
    }

    .cc__buttons .btn {
      flex: 1 1 auto;
    }
  }
</style>
