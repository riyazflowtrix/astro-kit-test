    scrollbar-width: none;
  }

  .neh__categories a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .neh__categories a:hover {
