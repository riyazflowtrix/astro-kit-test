    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .neh__suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .neh__suggestions button {
    min-height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .neh__suggestions button:hover {
    border-color: var(--ink-3);
  }

  .neh__popular {
