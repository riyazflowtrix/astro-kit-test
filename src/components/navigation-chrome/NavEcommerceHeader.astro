  }

  .neh__drawer {
    margin: 0 0 0 auto;
    width: min(400px, 100vw);
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--ink);
  }

  .neh__drawer::backdrop {
    background: rgb(20 19 23 / 0.45);
  }

  .neh__drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .neh__drawer-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .neh__close {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
