    font-size: 0.9375rem;
  }

  .neh__actions {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .neh__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
