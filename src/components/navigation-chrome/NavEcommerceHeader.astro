<header id="nav-ecommerce-header" class="neh" data-variant="inline-search">
  <!-- kit: nav-ecommerce-header -->
  <div class="container neh__top">
    <a class="neh__logo" href="/">
      <img src="https://picsum.photos/seed/caldera-mark/240/64" alt="Caldera" width="240" height="64" />
      <span>Caldera</span>
    </a>

    <form class="neh__search" role="search" action="#" autocomplete="off">
      <label class="visually-hidden" for="nav-ecommerce-header-q">Search the store</label>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M20 20l-4-4"/></svg>
      <input id="nav-ecommerce-header-q" type="search" name="q" placeholder="Search skillets, grills, recipes" aria-controls="nav-ecommerce-header-results" aria-expanded="false" />
      <div class="neh__results" id="nav-ecommerce-header-results" hidden>
        <p class="neh__results-title">Try searching for</p>
        <ul class="neh__suggestions">
          <li><button type="button">cast iron skillet</button></li>
          <li><button type="button">dutch oven</button></li>
          <li><button type="button">seasoning</button></li>
          <li><button type="button">camp grill</button></li>
        </ul>
        <p class="neh__results-title">Popular right now</p>
        <ul class="neh__popular">
          <li>
            <a href="/products/cable-fold">
              <img src="https://picsum.photos/seed/caldera-cable-fold/160/160" alt="" width="160" height="160" loading="lazy" />
              <span><strong>Cable Fold Grill</strong><small>$189</small></span>
            </a>
          </li>
          <li>
            <a href="/products/ember-dutch-oven">
              <img src="https://picsum.photos/seed/caldera-ember-rust/160/160" alt="" width="160" height="160" loading="lazy" />
              <span><strong>Ember Dutch Oven 5.5qt</strong><small>$245</small></span>
            </a>
          </li>
          <li>
            <a href="/products/ridge-skillet-10">
              <img src="https://picsum.photos/seed/caldera-ridge-skillet/160/160" alt="" width="160" height="160" loading="lazy" />
              <span><strong>Ridge Skillet 10"</strong><small>$95</small></span>
            </a>
          </li>
        </ul>
        <p class="neh__no-results" hidden>Nothing matched. Try “skillet” or “kettle”.</p>
      </div>
    </form>

    <div class="neh__actions">
      <a class="neh__action" href="/account">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 21a8 8 0 0 1 16 0"/></svg>
        <span>Sign in</span>
      </a>
      <button class="neh__action" type="button" data-open-cart aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span>Cart</span>
      </button>
    </div>
  </div>

  <nav class="neh__categories" aria-label="Shop categories">
    <ul class="container">
      <li><a href="/collections/skillets"><img src="https://picsum.photos/seed/caldera-skillet-thumb/320/320" alt="" width="320" height="320" loading="lazy" />Skillets</a></li>
      <li><a href="/collections/dutch-ovens"><img src="https://picsum.photos/seed/caldera-dutch-thumb/320/320" alt="" width="320" height="320" loading="lazy" />Dutch ovens</a></li>
      <li><a href="/collections/grills"><img src="https://picsum.photos/seed/caldera-grill-thumb/320/320" alt="" width="320" height="320" loading="lazy" />Grills</a></li>
      <li><a href="/collections/camp-kitchen">Camp kitchen</a></li>
      <li><a href="/shop/bundles">Bundles</a></li>
      <li><a class="is-highlighted" href="/collections/sale">Sale</a></li>
    </ul>
  </nav>

  <dialog class="neh__drawer" aria-labelledby="nav-ecommerce-header-cart-title">
    <div class="neh__drawer-head">
      <h2 id="nav-ecommerce-header-cart-title">Your cart</h2>
      <button type="button" class="neh__close" data-close-cart>
        <span class="visually-hidden">Close cart</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="neh__drawer-body">
      <p>Your cart is empty. The fire's still going.</p>
      <a class="btn btn-primary" href="/collections/bestsellers">Shop bestsellers</a>
    </div>
  </dialog>
</header>

<script is:inline>
  (function () {
    var root = document.getElementById("nav-ecommerce-header");
    if (!root) return;
    var input = root.querySelector("#nav-ecommerce-header-q");
    var results = root.querySelector(".neh__results");
    var noResults = root.querySelector(".neh__no-results");
    var popular = Array.prototype.slice.call(root.querySelectorAll(".neh__popular li"));
    var drawer = root.querySelector(".neh__drawer");

    function show(open) {
      results.hidden = !open;
      input.setAttribute("aria-expanded", String(open));
    }
    function filter() {
      var q = input.value.trim().toLowerCase();
      var hits = 0;
      popular.forEach(function (li) {
        var match = !q || li.textContent.toLowerCase().indexOf(q) !== -1;
        li.hidden = !match;
        if (match) hits++;
      });
      noResults.hidden = hits > 0;
    }
    input.addEventListener("focus", function () { show(true); });
    input.addEventListener("input", filter);
    root.querySelectorAll(".neh__suggestions button").forEach(function (b) {
      b.addEventListener("click", function () {
        input.value = b.textContent;
        filter();
        input.focus();
      });
    });
    document.addEventListener("click", function (e) {
      if (!root.querySelector(".neh__search").contains(e.target)) show(false);
    });
    root.addEventListener("keydown", function (e) {
      if (e.key === "Escape") show(false);
    });
    root.querySelector("[data-open-cart]").addEventListener("click", function () {
      if (drawer.showModal) drawer.showModal();
    });
    root.querySelector("[data-close-cart]").addEventListener("click", function () { drawer.close(); });
    drawer.addEventListener("click", function (e) {
      if (e.target === drawer) drawer.close();
    });
  })();
</script>

<style>
  .neh {
