---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<footer id="footer-multi-column" class="fmc" data-variant="columns" data-theme="dark">
  <!-- kit: footer-multi-column -->
  <div class="container">
    <div class="fmc__top">
      <div class="fmc__brand">
        <a href="/" class="fmc__logo">
          <img src="https://picsum.photos/seed/caldera-mark-light/240/64" alt="Caldera" width="240" height="64" loading="lazy" />
        </a>
        <p class="fmc__tagline">Cookware built for the open fire. Forged in Bend, Oregon, and guaranteed for life.</p>
        <ul class="fmc__social">
          <li>
            <a href="https://instagram.com/caldera.cookware" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              <span class="visually-hidden">Instagram</span>
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@calderacookware" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>
              <span class="visually-hidden">YouTube</span>
            </a>
          </li>
          <li>
            <a href="https://pinterest.com/calderacookware" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M11 8.5c3-1 5 .5 5 3 0 2.5-1.8 4-3.5 4-1 0-1.6-.5-1.8-1.2M12 11l-2.5 9"/></svg>
              <span class="visually-hidden">Pinterest</span>
            </a>
          </li>
        </ul>
      </div>

      <nav class="fmc__groups" aria-label="Footer">
        <div>
          <h2 class="fmc__group-title">Shop</h2>
          <ul>
            <li><a href="/collections/skillets">Skillets</a></li>
            <li><a href="/collections/dutch-ovens">Dutch ovens</a></li>
            <li><a href="/collections/grills">Grills</a></li>
            <li><a href="/gift-cards">Gift cards</a></li>
          </ul>
        </div>
        <div>
          <h2 class="fmc__group-title">Help</h2>
          <ul>
            <li><a href="/shipping">Shipping &amp; returns</a></li>
            <li><a href="/warranty">Lifetime warranty</a></li>
            <li><a href="/journal/cast-iron-care">Care guides</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2 class="fmc__group-title">Company</h2>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/journal">Journal</a></li>
            <li><a href="/wholesale">Wholesale</a></li>
            <li><a href="/careers">Careers</a></li>
          </ul>
        </div>
      </nav>

      <div class="fmc__newsletter">
        <h2 class="fmc__newsletter-title">Recipes from the fire, monthly</h2>
        <p>One email a month: a new recipe, a care tip and first word on launches. No spam.</p>
        <form action={bcmsFormAction("Recipes from the fire, monthly")} method={bcmsFormMethod("Recipes from the fire, monthly")} data-form="form_newsletter" data-bcms-form={bcmsFormId("Recipes from the fire, monthly")} data-bcms-form-success="Thank you for your submission!">
          <label class="visually-hidden" for="footer-multi-column-email" data-bcms-form-part="label">Email address</label>
          <input id="footer-multi-column-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required data-bcms-form-field="email" />
          <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Subscribe</button>
        <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
        <p class="bcms-form-msg" hidden></p>
        </form>
        <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
      </div>
    </div>

    <div class="fmc__bottom">
      <p class="fmc__copyright">© {new Date().getFullYear()} Caldera Cookware Co.</p>
      <ul class="fmc__legal">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
      </ul>
      <ul class="fmc__payments" aria-label="We accept">
        <li>Visa</li>
        <li>Mastercard</li>
        <li>Amex</li>
        <li>Apple Pay</li>
        <li>Shop Pay</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .fmc {
    background: var(--dark);
    color: var(--dark-ink);
    padding-block: clamp(48px, 7vw, 80px) 2rem;
  }

  .fmc a {
    color: color-mix(in srgb, var(--dark-ink) 78%, transparent);
    text-decoration: none;
  }

  .fmc a:hover {
    color: var(--dark-ink);
  }

  .fmc__top {
    display: grid;
    grid-template-columns: 1.2fr 2fr 1.4fr;
    gap: 2.5rem;
  }

  .fmc__logo img {
    width: auto;
    height: 36px;
    border-radius: 4px;
  }

  .fmc__tagline {
    margin: 1rem 0 1.25rem;
    max-width: 32ch;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--dark-ink) 70%, transparent);
  }

  .fmc__social {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fmc__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 50%;
  }

  .fmc__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .fmc__group-title {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dark-ink);
  }

  .fmc__groups ul {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .fmc__newsletter-title {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .fmc__newsletter p {
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--dark-ink) 70%, transparent);
  }

  .fmc__newsletter form {
    display: flex;
    gap: 0.5rem;
  }

  .fmc__newsletter input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
    color: var(--dark-ink);
  }

  .fmc__newsletter input::placeholder {
    color: color-mix(in srgb, var(--dark-ink) 50%, transparent);
  }

  .fmc__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.875rem;
  }

  .fmc__copyright {
    margin: 0;
    color: color-mix(in srgb, var(--dark-ink) 60%, transparent);
  }

  .fmc__legal {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fmc__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .fmc__payments li {
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--dark-ink) 80%, transparent);
  }

  @media (max-width: 980px) {
    .fmc__top {
      grid-template-columns: 1fr 1fr;
    }

    .fmc__groups {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 640px) {
    .fmc__top {
      grid-template-columns: 1fr;
    }

    .fmc__groups {
      grid-row: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fmc__payments {
      margin-left: 0;
    }
  }

  @media (max-width: 400px) {
    .fmc__newsletter form {
      flex-direction: column;
    }
  }
</style>
