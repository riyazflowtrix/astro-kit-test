<script is:inline>
  (function () {
    var root = document.getElementById("nav-mega-featured-promo");
    if (!root) return;
    var triggers = Array.prototype.slice.call(root.querySelectorAll(".nmf__trigger"));
    var backdrop = root.querySelector(".nmf__backdrop");
    function closeAll() {
      triggers.forEach(function (t) {
        t.setAttribute("aria-expanded", "false");
        document.getElementById(t.getAttribute("aria-controls")).hidden = true;
      });
      backdrop.hidden = true;
    }
    triggers.forEach(function (t) {
      t.addEventListener("click", function () {
        var wasOpen = t.getAttribute("aria-expanded") === "true";
        closeAll();
        if (!wasOpen) {
          t.setAttribute("aria-expanded", "true");
          document.getElementById(t.getAttribute("aria-controls")).hidden = false;
          backdrop.hidden = false;
        }
      });
    });
    backdrop.addEventListener("click", closeAll);
    root.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAll();
    });
    document.addEventListener("click", function (e) {
      if (!root.contains(e.target)) closeAll();
    });
  })();
</script>

