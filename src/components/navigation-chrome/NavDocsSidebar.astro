<script is:inline>
  (function () {
    var root = document.getElementById("nav-docs-sidebar");
    if (!root) return;
    var toggle = root.querySelector(".nds__toggle");
    var panel = root.querySelector(".nds__panel");
    toggle.addEventListener("click", function () {
      var open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("is-open", open);
    });
  })();
</script>

<style>
  .nds {
