<script is:inline>
  (function () {
    var root = document.getElementById("recipe");
    if (!root) return;
    function fmt(s) {
      var m = Math.floor(s / 60);
      var r = s % 60;
      return m + ":" + (r < 10 ? "0" : "") + r;
    }
    root.querySelectorAll(".timer").forEach(function (btn) {
      var total = Number(btn.dataset.minutes) * 60;
      var left = total;
      var label = btn.dataset.label;
      var id = null;
      function render() { btn.textContent = "⏱ " + label + " · " + fmt(left); }
      btn.setAttribute("aria-pressed", "false");
      btn.addEventListener("click", function () {
        if (btn.classList.contains("is-done")) {
          btn.classList.remove("is-done");
          left = total;
          render();
          return;
        }
        if (id) {
          clearInterval(id);
          id = null;
          btn.setAttribute("aria-pressed", "false");
          return;
        }
        btn.setAttribute("aria-pressed", "true");
        id = setInterval(function () {
          left -= 1;
          render();
          if (left <= 0) {
            clearInterval(id);
            id = null;
            btn.setAttribute("aria-pressed", "false");
            btn.classList.add("is-done");
            btn.textContent = "✓ " + label + " done — tap to reset";
          }
        }, 1000);
      });
    });
  })();
</script>
