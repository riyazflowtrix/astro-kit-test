<script is:inline>
  (function () {
    var root = document.getElementById("docs-page");
    if (!root) return;
    var toggle = root.querySelector(".sidebar-toggle");
    if (window.matchMedia("(max-width: 780px)").matches) toggle.removeAttribute("open");

    var group = root.querySelector(".code-tabs");
    var key = group.getAttribute("data-sync-key");
    var tabs = Array.prototype.slice.call(group.querySelectorAll('[role="tab"]'));
    function select(lang, broadcast) {
      if (!tabs.some(function (t) { return t.dataset.lang === lang; })) return;
      tabs.forEach(function (t) {
        var on = t.dataset.lang === lang;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
      });
      if (broadcast) {
        try { localStorage.setItem("codetabs:" + key, lang); } catch (e) {}
        window.dispatchEvent(new CustomEvent("codetabs:sync", { detail: { key: key, lang: lang, source: group } }));
      }
    }
    tabs.forEach(function (t, i) {
      t.addEventListener("click", function () { select(t.dataset.lang, true); });
      t.addEventListener("keydown", function (e) {
        var n = null;
        if (e.key === "ArrowRight") n = tabs[(i + 1) % tabs.length];
        if (e.key === "ArrowLeft") n = tabs[(i - 1 + tabs.length) % tabs.length];
        if (n) { e.preventDefault(); select(n.dataset.lang, true); n.focus(); }
      });
    });
    window.addEventListener("codetabs:sync", function (e) {
      if (e.detail.key === key && e.detail.source !== group) select(e.detail.lang, false);
    });
    try {
      var saved = localStorage.getItem("codetabs:" + key);
      if (saved) select(saved, false);
    } catch (e) {}
    var copy = group.querySelector(".copy");
    copy.addEventListener("click", function () {
      var panel = group.querySelector(".panel:not([hidden])");
      var text = Array.prototype.map.call(panel.querySelectorAll(".line"), function (l) { return l.textContent; }).join("\n");
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () {
        copy.textContent = "Copied";
        setTimeout(function () { copy.textContent = "Copy"; }, 1600);
      });
    });

    var links = Array.prototype.slice.call(root.querySelectorAll(".toc a"));
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          links.forEach(function (a) { a.classList.toggle("is-active", a.getAttribute("href") === "#" + en.target.id); });
        });
      }, { rootMargin: "0px 0px -70% 0px" });
      root.querySelectorAll(".prose h2[id], .prose h3[id]").forEach(function (h) { io.observe(h); });
    }
  })();
</script>
