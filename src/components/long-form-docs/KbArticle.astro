---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
// Knowledge-base article (entry) — Ledgerline help centre, Bank feeds. Feedback: "No" shows quick reasons.
---

<section id="kb-article" class="section kb-article">
  <!-- kit: kb-article -->
  <div class="container kb-layout">
    <article class="kb-main">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/help">Help centre</a></li>
          <li><a href="/help/bank-feeds">Bank feeds</a></li>
          <li aria-current="page">Missing transactions</li>
        </ol>
      </nav>

      <h1>Why is my bank feed missing transactions?</h1>
      <p class="lead">Most gaps are a pending sync or an expired bank login. Reconnect the account and run a 90-day backfill.</p>
      <p class="meta">Reviewed by <strong>Rina Das</strong>, Support lead · <time datetime="2026-08-18">18 August 2026</time></p>

      <div class="prose">
        <ol class="steps">
          <li>Open <strong>Banking › Connections</strong> and look for a yellow <em>Reconnect</em> badge.</li>
          <li>Click <strong>Reconnect</strong> and sign in to your bank again.</li>
          <li>Choose <strong>Backfill 90 days</strong>. New lines appear within 15 minutes.</li>
        </ol>

        <figure class="shot">
          <img src="https://picsum.photos/seed/ledgerline-reconnect/1600/1000" alt="The Connections list with a yellow Reconnect badge on the Chase operating account" width="1600" height="1000" loading="lazy" />
          <figcaption>An expired connection shows Reconnect.</figcaption>
        </figure>

        <div class="callout">
          <p class="callout-title">Pending transactions</p>
          <p>Banks send pending card charges only once they settle, usually 1–3 business days later.</p>
        </div>
      </div>

      <div class="feedback" aria-live="polite">
        <div class="fb-ask">
          <p class="fb-q" id="kb-feedback-q">Was this article helpful?</p>
          <div class="btn-row" role="group" aria-labelledby="kb-feedback-q">
            <button type="button" class="btn btn-secondary" data-answer="yes">Yes</button>
            <button type="button" class="btn btn-secondary" data-answer="no" aria-expanded="false" aria-controls="kb-feedback-reasons">No</button>
          </div>
        </div>
        <p class="fb-thanks" hidden>Thanks — glad it helped.</p>
        <form class="fb-reasons" id="kb-feedback-reasons" action={bcmsFormAction("What went wrong?")} method={bcmsFormMethod("What went wrong?")} hidden data-bcms-form={bcmsFormId("What went wrong?")} data-bcms-form-success="Thank you for your submission!">
          <fieldset>
            <legend>What went wrong?</legend>
            <label data-bcms-form-field="reason"><input type="radio" name="reason" value="steps-didnt-work" /> Steps didn't work</label>
            <label><input type="radio" name="reason" value="bank-not-listed" /> My bank isn't listed</label>
            <label><input type="radio" name="reason" value="hard-to-follow" /> Hard to follow</label>
            <label><input type="radio" name="reason" value="not-what-i-wanted" /> Not what I was looking for</label>
          </fieldset>
          <button type="submit" class="btn btn-primary" data-bcms-form-part="submit">Send feedback</button>
        <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
        <p class="bcms-form-msg" hidden></p>
        </form>
        <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
      </div>
    </article>

    <aside class="kb-side" aria-label="Related articles">
      <p class="side-title">Related articles</p>
      <ul>
        <li><a href="/help/bank-feeds/reconnect-bank">How to reconnect a bank account</a></li>
        <li><a href="/help/bank-feeds/duplicate-lines">Why do I see duplicate lines?</a></li>
      </ul>
      <div class="side-help">
        <p><strong>Still stuck?</strong></p>
        <p>Our support team replies within one business day.</p>
        <a class="btn btn-secondary" href="/help/contact">Contact support</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .kb-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px) 260px;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .crumbs li + li::before {
    content: "›";
    margin-right: 0.375rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  h1 {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
  }
  .meta {
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .prose {
    margin-top: 2rem;
    font-size: 1.0625rem;
  }
  .steps {
    padding-left: 1.5rem;
  }
  .steps li {
    padding-left: 0.25rem;
  }
  .steps li + li {
    margin-top: 0.625rem;
  }
  .shot {
    margin: 2rem auto;
    max-width: 560px;
  }
  .shot img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-3);
    text-align: center;
  }
  .callout {
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 7%, var(--bg));
  }
  .callout p {
    margin: 0;
  }
  .callout-title {
    font-weight: 700;
    margin-bottom: 0.25rem !important;
  }
  .feedback {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .fb-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .fb-ask[hidden] {
    display: none;
  }
  .fb-q,
  .fb-thanks {
    margin: 0;
    font-weight: 600;
  }
  .fb-ask .btn {
    min-width: 80px;
    background: var(--bg);
  }
  .fb-ask .btn[aria-pressed="true"] {
    border-color: var(--ink);
  }
  .fb-reasons {
    margin-top: 1.25rem;
  }
  fieldset {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    display: grid;
    gap: 0.5rem;
  }
  legend {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  fieldset label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 40px;
    padding: 0 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    cursor: pointer;
  }
  .kb-side {
    position: sticky;
    top: 1.5rem;
    font-size: 0.9375rem;
  }
  .side-title {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kb-side ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .kb-side li a {
    display: block;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    text-decoration: none;
  }
  .side-help {
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .side-help p {
    margin-bottom: 0.5rem;
  }
  @media (max-width: 900px) {
    .kb-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .kb-side {
      position: static;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("kb-article");
    if (!root) return;
    var ask = root.querySelector(".fb-ask");
    var thanks = root.querySelector(".fb-thanks");
    var form = root.querySelector(".fb-reasons");
    var no = root.querySelector('[data-answer="no"]');
    root.querySelector('[data-answer="yes"]').addEventListener("click", function () {
      ask.hidden = true;
      form.hidden = true;
      thanks.hidden = false;
    });
    no.addEventListener("click", function () {
      no.setAttribute("aria-pressed", "true");
      no.setAttribute("aria-expanded", "true");
      form.hidden = false;
    });
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      form.hidden = true;
      ask.hidden = true;
      thanks.textContent = "Thanks — we'll use this to improve the article.";
      thanks.hidden = false;
    });
  })();
</script>
