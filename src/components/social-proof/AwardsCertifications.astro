---
---

<section id="awards-certifications" class="section awards-certifications">
  <!-- kit: awards-certifications -->
  <div class="container">
    <header class="section-head section-head--center">
      <span class="eyebrow">Trust</span>
      <h2>Your health data, held to the highest standard.</h2>
    </header>

    <ul class="ac-grid" role="list">
      <li class="ac-card">
        <img src="https://cdn.bettercms.site/kit/logos/soc2-type2.svg" alt="SOC 2 Type II badge" width="120" height="120" loading="lazy" />
        <span class="ac-kind">Certification</span>
        <h3>SOC 2 Type II</h3>
        <p class="ac-issuer">AICPA (audited by Prescient Assurance)</p>
        <dl class="ac-facts">
          <div><dt>Valid until</dt><dd><time datetime="2027-03-31">31 March 2027</time></dd></div>
        </dl>
        <a class="ac-verify" href="https://trust.junipercare.com" target="_blank" rel="noopener">Trust centre <span aria-hidden="true">↗</span></a>
      </li>
      <li class="ac-card">
        <img src="https://cdn.bettercms.site/kit/logos/hitrust-r2.svg" alt="HITRUST CSF r2 badge" width="120" height="120" loading="lazy" />
        <span class="ac-kind">Certification</span>
        <h3>HITRUST CSF r2</h3>
        <p class="ac-issuer">HITRUST Alliance</p>
        <dl class="ac-facts">
          <div><dt>Certificate</dt><dd>HT-2025-118842</dd></div>
          <div><dt>Valid until</dt><dd><time datetime="2027-01-15">15 January 2027</time></dd></div>
        </dl>
        <a class="ac-verify" href="https://hitrustalliance.net/validated-assessment-registry" target="_blank" rel="noopener">Validated registry <span aria-hidden="true">↗</span></a>
      </li>
      <li class="ac-card">
        <img src="https://cdn.bettercms.site/kit/logos/iso-27001.svg" alt="ISO/IEC 27001:2022 badge" width="120" height="120" loading="lazy" />
        <span class="ac-kind">Certification</span>
        <h3>ISO/IEC 27001:2022</h3>
        <p class="ac-issuer">BSI</p>
        <dl class="ac-facts">
          <div><dt>Certificate</dt><dd>IS 781204</dd></div>
          <div><dt>Valid until</dt><dd><time datetime="2028-06-30">30 June 2028</time></dd></div>
        </dl>
        <a class="ac-verify" href="https://www.bsigroup.com/en-US/validate-bsi-issued-certificates/" target="_blank" rel="noopener">Validate with BSI <span aria-hidden="true">↗</span></a>
      </li>
      <li class="ac-card ac-card--award">
        <img src="https://cdn.bettercms.site/kit/logos/dha-2026.svg" alt="Best Virtual Care Experience 2026 badge" width="120" height="120" loading="lazy" />
        <span class="ac-kind">Award · 2026</span>
        <h3>Best Virtual Care Experience 2026</h3>
        <p class="ac-issuer">Digital Health Awards</p>
      </li>
    </ul>

    <p class="ac-note">Our SOC 2 report is available under NDA. HIPAA has no official certification — we sign a BAA with every covered entity.</p>
    <div class="btn-row ac-cta">
      <a class="btn btn-secondary" href="https://trust.junipercare.com" target="_blank" rel="noopener">Visit our trust centre</a>
    </div>
  </div>
</section>

<style>
  .ac-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ac-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .ac-card--award { background: var(--surface); }
  .ac-card img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .ac-kind {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand);
    margin-bottom: 0.25rem;
  }
  .ac-card h3 { font-size: 1.125rem; margin-bottom: 0.25rem; }
  .ac-issuer { color: var(--ink-2); font-size: 0.9375rem; }
  .ac-facts { margin: 0 0 1rem; display: grid; gap: 0.25rem; font-size: 0.8125rem; width: 100%; }
  .ac-facts div { display: flex; justify-content: space-between; gap: 0.75rem; border-top: 1px solid var(--line); padding-top: 0.375rem; }
  .ac-facts dt { color: var(--ink-3); }
  .ac-facts dd { margin: 0; font-weight: 600; text-align: right; }
  .ac-verify { margin-top: auto; font-size: 0.875rem; font-weight: 600; color: var(--brand); text-decoration: none; }
  .ac-verify:hover { text-decoration: underline; }
  .ac-note { max-width: 62ch; margin: 2rem auto 1rem; text-align: center; font-size: 0.875rem; color: var(--ink-2); }
  .ac-cta { justify-content: center; }
  @media (max-width: 1000px) { .ac-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .ac-grid { grid-template-columns: 1fr; } }
</style>
