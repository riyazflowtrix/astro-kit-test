---
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Ember Dutch Oven",
  url: "/products/ember-dutch-oven",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: 4.8,
    reviewCount: 2418,
    bestRating: 5,
    worstRating: 1,
  },
};
---

<section id="review-summary" class="section review-summary">
  <!-- kit: review-summary -->
  <div class="container rs">
    <div class="rs-summary">
      <h2>What cooks are saying</h2>
      <div class="rs-score">
        <span class="rs-average">4.8</span>
        <div>
          <span class="rs-stars" role="img" aria-label="Rated 4.8 out of 5" style="--rating: 4.8;"></span>
          <p class="rs-count">Based on 2,418 reviews</p>
        </div>
      </div>

      <ul class="rs-bars" role="list" aria-label="Rating distribution">
        <li><span class="rs-bar-label">5 stars</span><span class="rs-bar"><span style="width: 84%;"></span></span><span class="rs-bar-count">2,031</span></li>
        <li><span class="rs-bar-label">4 stars</span><span class="rs-bar"><span style="width: 12%;"></span></span><span class="rs-bar-count">290</span></li>
        <li><span class="rs-bar-label">3 stars</span><span class="rs-bar"><span style="width: 2.4%;"></span></span><span class="rs-bar-count">58</span></li>
        <li><span class="rs-bar-label">2 stars</span><span class="rs-bar"><span style="width: 0.9%;"></span></span><span class="rs-bar-count">22</span></li>
        <li><span class="rs-bar-label">1 star</span><span class="rs-bar"><span style="width: 0.7%;"></span></span><span class="rs-bar-count">17</span></li>
      </ul>

      <ul class="rs-platforms" role="list">
        <li>
          <a href="https://www.rei.com/product/caldera-ember-dutch-oven" target="_blank" rel="noopener">
            <strong>REI</strong>
            <span>4.7 ★ · 612 reviews</span>
            <span class="visually-hidden">REI reviews (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href="https://www.amazon.com/dp/B0CALDERA55" target="_blank" rel="noopener">
            <strong>Amazon</strong>
            <span>4.6 ★ · 1,290 reviews</span>
            <span class="visually-hidden">Amazon reviews (opens in a new tab)</span>
          </a>
        </li>
      </ul>
      <p class="rs-provider">Verified reviews collected by Judge.me</p>
    </div>

    <div class="rs-featured">
      <figure class="rs-review">
        <p class="rs-review-stars" aria-label="Rated 5 out of 5"><span aria-hidden="true">★★★★★</span></p>
        <blockquote>
          <p>I bought the Ember Dutch Oven for one camping trip. Now it never leaves my stove: sourdough on Sunday, short ribs midweek, chilli over coals on Saturday.</p>
        </blockquote>
        <figcaption>
          <img src="https://i.pravatar.cc/192?img=5" alt="Amara Nwosu" width="96" height="96" loading="lazy" />
          <span><strong>Amara Nwosu</strong><span>Verified buyer · Portland, OR</span></span>
        </figcaption>
      </figure>
      <figure class="rs-review">
        <p class="rs-review-stars" aria-label="Rated 5 out of 5"><span aria-hidden="true">★★★★★</span></p>
        <blockquote>
          <p>I've guided for twelve years and Caldera is the first cookware I've never left behind. It sears trout at night and cleans up in the coals.</p>
        </blockquote>
        <figcaption>
          <img src="https://i.pravatar.cc/192?img=47" alt="Maya Reyes" width="96" height="96" loading="lazy" />
          <span><strong>Maya Reyes</strong><span>Verified buyer · Lander, WY</span></span>
        </figcaption>
      </figure>
      <div class="btn-row">
        <a class="btn btn-secondary" href="/products/ember-dutch-oven#reviews" title="Ember Dutch Oven">Read all 2,418 reviews</a>
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .rs {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .rs-summary h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .rs-score { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 1.5rem; }
  .rs-average { font-size: 4rem; font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
  .rs-stars {
    --percent: calc(var(--rating) / 5 * 100%);
    display: inline-block;
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: 0.1em;
  }
  .rs-stars::before {
    content: "★★★★★";
    background: linear-gradient(90deg, var(--brand) var(--percent), var(--line) var(--percent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .rs-count { margin: 0.25rem 0 0; color: var(--ink-2); font-size: 0.9375rem; }
  .rs-bars { margin: 0 0 1.5rem; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .rs-bars li { display: grid; grid-template-columns: 4rem 1fr 3.25rem; align-items: center; gap: 0.75rem; font-size: 0.875rem; }
  .rs-bar { height: 8px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .rs-bar span { display: block; height: 100%; background: var(--brand); border-radius: inherit; }
  .rs-bar-count { text-align: right; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .rs-platforms { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .rs-platforms a {
    display: grid;
    gap: 0.125rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .rs-platforms a:hover { border-color: var(--ink-3); }
  .rs-platforms span { color: var(--ink-2); }
  .rs-provider { margin: 1rem 0 0; font-size: 0.8125rem; color: var(--ink-3); }
  .rs-featured { display: grid; gap: 1.25rem; }
  .rs-review {
    margin: 0;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .rs-review-stars { color: var(--brand); letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .rs-review blockquote { margin: 0 0 1rem; }
  .rs-review blockquote p { margin: 0; font-size: 1.0625rem; }
  .rs-review figcaption { display: flex; align-items: center; gap: 0.75rem; }
  .rs-review figcaption img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .rs-review figcaption > span { display: grid; line-height: 1.3; }
  .rs-review figcaption > span span { font-size: 0.8125rem; color: var(--ink-2); }
  @media (max-width: 860px) { .rs { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .rs-platforms { grid-template-columns: 1fr; } }
</style>
