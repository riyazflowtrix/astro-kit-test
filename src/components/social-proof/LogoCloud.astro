---
---

<section id="logo-cloud" class="section logo-cloud">
  <!-- kit: logo-cloud -->
  <div class="container">
    <h2 class="lc-heading">Sold at independent outfitters and these retailers</h2>
  </div>
  <div class="lc-marquee is-grayscale" style="--lc-height: 32px; --lc-duration: 48s;">
    <ul class="lc-track" role="list">
      <li><img src="https://cdn.bettercms.site/kit/logos/rei.svg" alt="REI Co-op logo" title="REI Co-op" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/huckberry.svg" alt="Huckberry logo" title="Huckberry" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/backcountry.svg" alt="Backcountry logo" title="Backcountry" width="160" height="48" loading="lazy" style="--lc-scale: 0.9;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/moosejaw.svg" alt="Moosejaw logo" title="Moosejaw" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/cabelas.svg" alt="Cabela's logo" title="Cabela's" width="160" height="48" loading="lazy" style="--lc-scale: 1.1;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/williams-sonoma.svg" alt="Williams Sonoma logo" title="Williams Sonoma" width="160" height="48" loading="lazy" style="--lc-scale: 0.85;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/food52.svg" alt="Food52 logo" title="Food52" width="160" height="48" loading="lazy" /></li>
    </ul>
    <ul class="lc-track lc-track--clone" role="list" aria-hidden="true">
      <li><img src="https://cdn.bettercms.site/kit/logos/rei.svg" alt="" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/huckberry.svg" alt="" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/backcountry.svg" alt="" width="160" height="48" loading="lazy" style="--lc-scale: 0.9;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/moosejaw.svg" alt="" width="160" height="48" loading="lazy" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/cabelas.svg" alt="" width="160" height="48" loading="lazy" style="--lc-scale: 1.1;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/williams-sonoma.svg" alt="" width="160" height="48" loading="lazy" style="--lc-scale: 0.85;" /></li>
      <li><img src="https://cdn.bettercms.site/kit/logos/food52.svg" alt="" width="160" height="48" loading="lazy" /></li>
    </ul>
  </div>
</section>

<style>
  .logo-cloud { padding-block: clamp(40px, 6vw, 72px); }
  .lc-heading {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    text-align: center;
    color: var(--ink-3);
    margin-bottom: 2rem;
  }
  .lc-marquee {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .lc-track {
    flex: none;
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0;
    padding: 0 clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    animation: lc-scroll var(--lc-duration) linear infinite;
  }
  .lc-marquee:hover .lc-track { animation-play-state: paused; }
  .lc-track img {
    width: auto;
    height: calc(var(--lc-height) * var(--lc-scale, 1));
    max-width: 180px;
    object-fit: contain;
    color: var(--ink-3);
    font-size: 0.8125rem;
  }
  .is-grayscale img { filter: grayscale(1); opacity: 0.7; transition: filter 150ms ease, opacity 150ms ease; }
  .is-grayscale img:hover { filter: none; opacity: 1; }
  @keyframes lc-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lc-marquee { justify-content: center; -webkit-mask-image: none; mask-image: none; }
    .lc-track { animation: none; flex-wrap: wrap; justify-content: center; row-gap: 1.5rem; flex: 1; }
    .lc-track--clone { display: none; }
  }
</style>
