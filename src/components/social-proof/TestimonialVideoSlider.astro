---
---

<section id="testimonial-video-slider" class="section section--dark testimonial-video-slider">
  <!-- kit: testimonial-video-slider -->
  <div class="container">
    <div class="tvs-head">
      <header class="section-head">
        <span class="eyebrow">Customer stories</span>
        <h2>Hear it from the people closing their books on Fridays.</h2>
      </header>
      <div class="tvs-nav">
        <button type="button" class="tvs-arrow" data-dir="-1" aria-label="Previous story">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button type="button" class="tvs-arrow" data-dir="1" aria-label="Next story">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <ul class="tvs-track" role="list" aria-label="Customer stories" tabindex="0">
      <li class="tvs-slide tvs-slide--video" aria-roledescription="slide" aria-label="1 of 3">
        <button type="button" class="tvs-poster" data-dialog="tvs-dialog-rosa">
          <img src="https://picsum.photos/seed/ledgerly-rosa-poster/900/1200" alt="Rosa Delgado behind the counter at Masa Bakery" width="1800" height="2400" loading="lazy" />
          <span class="tvs-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="tvs-duration">1:12</span>
          <span class="visually-hidden">Play Rosa Delgado's story (1 minute 12 seconds)</span>
        </button>
        <div class="tvs-body">
          <blockquote><p>“We stopped paying our bookkeeper overtime in March.”</p></blockquote>
          <div class="tvs-person">
            <img src="https://i.pravatar.cc/192?img=32" alt="Rosa Delgado" width="96" height="96" loading="lazy" />
            <span><strong>Rosa Delgado</strong><span>Owner, Masa Bakery</span></span>
          </div>
          <details class="tvs-transcript">
            <summary>Read transcript</summary>
            <p><strong>Rosa:</strong> I used to do the books on Sunday nights with a glass of wine and a lot of swearing. Now Ledgerly does most of it before I open on Monday.</p>
          </details>
          <a class="tvs-link" href="/customers/masa-bakery" title="Masa Bakery">Read Masa's story <span aria-hidden="true">→</span></a>
        </div>
        <dialog class="tvs-dialog" id="tvs-dialog-rosa" aria-label="Rosa Delgado, Masa Bakery">
          <form method="dialog"><button class="tvs-close" aria-label="Close video">×</button></form>
          <video controls playsinline preload="none" poster="https://picsum.photos/seed/ledgerly-rosa-poster/900/1200" width="900" height="1200">
            <source src="https://cdn.ledgerly.com/stories/masa-bakery.mp4" type="video/mp4" />
            <track kind="captions" src="https://cdn.ledgerly.com/stories/masa-bakery.en.vtt" srclang="en" label="English" default />
          </video>
        </dialog>
      </li>

      <li class="tvs-slide tvs-slide--video" aria-roledescription="slide" aria-label="2 of 3">
        <button type="button" class="tvs-poster" data-dialog="tvs-dialog-devon">
          <img src="https://picsum.photos/seed/ledgerly-north-fork-poster/900/1200" alt="Devon Park in the North Fork Builders workshop" width="1800" height="2400" loading="lazy" />
          <span class="tvs-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
          <span class="tvs-duration">1:38</span>
          <span class="visually-hidden">Play Devon Park's story (1 minute 38 seconds)</span>
        </button>
        <div class="tvs-body">
          <blockquote><p>“Job costing used to be a spreadsheet only I understood.”</p></blockquote>
          <div class="tvs-person">
            <img src="https://i.pravatar.cc/192?img=12" alt="Devon Park" width="96" height="96" loading="lazy" />
            <span><strong>Devon Park</strong><span>Operations lead, North Fork Builders</span></span>
          </div>
        </div>
        <dialog class="tvs-dialog" id="tvs-dialog-devon" aria-label="Devon Park, North Fork Builders">
          <form method="dialog"><button class="tvs-close" aria-label="Close video">×</button></form>
          <div class="tvs-embed">
            <iframe data-src="https://player.vimeo.com/video/870112233?texttrack=en" title="Devon Park, North Fork Builders — customer story" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
        </dialog>
      </li>

      <li class="tvs-slide tvs-slide--quote" aria-roledescription="slide" aria-label="3 of 3">
        <div class="tvs-body">
          <svg class="tvs-mark" viewBox="0 0 32 32" width="40" height="40" fill="currentColor" aria-hidden="true"><path d="M13 8H7a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h4v1a4 4 0 0 1-4 4v3a7 7 0 0 0 7-7V9a1 1 0 0 0-1-1zm15 0h-6a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h4v1a4 4 0 0 1-4 4v3a7 7 0 0 0 7-7V9a1 1 0 0 0-1-1z"/></svg>
          <blockquote><p>“Our accountant asked what changed. The answer was: everything is just already there.”</p></blockquote>
          <div class="tvs-person">
            <img src="https://i.pravatar.cc/192?img=45" alt="Priya Shah" width="96" height="96" loading="lazy" />
            <span><strong>Priya Shah</strong><span>Co-founder, Loop &amp; Thread</span></span>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .tvs-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .tvs-head .section-head { margin-bottom: 0; }
  .tvs-nav { display: flex; gap: 0.5rem; flex: none; }
  .tvs-arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .tvs-arrow:hover { background: rgb(255 255 255 / 0.08); }
  .tvs-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, calc((100% - 2.5rem) / 3));
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
  }
  .tvs-slide {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .tvs-poster {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
    aspect-ratio: 4 / 5;
    color: #fff;
  }
  .tvs-poster img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: opacity 200ms ease; }
  .tvs-poster:hover img { opacity: 1; }
  .tvs-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--brand-ink);
  }
  .tvs-duration {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgb(0 0 0 / 0.6);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .tvs-body { padding: 1.5rem; display: grid; gap: 1rem; align-content: start; }
  .tvs-slide--quote { justify-content: center; }
  .tvs-slide--quote blockquote p { font-size: clamp(1.375rem, 2.4vw, 1.75rem); }
  .tvs-mark { color: var(--brand); }
  .tvs-body blockquote { margin: 0; }
  .tvs-body blockquote p { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .tvs-person { display: flex; align-items: center; gap: 0.75rem; }
  .tvs-person img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .tvs-person > span { display: grid; line-height: 1.3; }
  .tvs-person > span span { font-size: 0.875rem; opacity: 0.7; }
  .tvs-transcript summary { cursor: pointer; font-size: 0.875rem; font-weight: 600; }
  .tvs-transcript p { margin: 0.5rem 0 0; font-size: 0.9375rem; opacity: 0.85; }
  .tvs-link { font-weight: 600; color: color-mix(in srgb, var(--brand) 70%, white); text-decoration: none; }
  .tvs-dialog {
    width: min(92vw, 720px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: #000;
    color: #fff;
    overflow: visible;
  }
  .tvs-dialog::backdrop { background: rgb(0 0 0 / 0.75); }
  .tvs-dialog video { width: 100%; max-height: 80vh; background: #000; border-radius: var(--radius-lg); }
  .tvs-embed { aspect-ratio: 16 / 9; }
  .tvs-embed iframe { width: 100%; height: 100%; border: 0; border-radius: var(--radius-lg); }
  .tvs-close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: #fff;
    color: #000;
    font-size: 1.25rem;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .tvs-head { flex-direction: column; align-items: flex-start; }
    .tvs-track { grid-auto-columns: 85%; }
    .tvs-close { top: 6px; right: 6px; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("testimonial-video-slider");
    if (!root) return;
    var track = root.querySelector(".tvs-track");
    root.querySelectorAll(".tvs-arrow").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var slide = track.querySelector(".tvs-slide");
        var step = slide ? slide.getBoundingClientRect().width + 20 : 300;
        track.scrollBy({ left: step * Number(btn.getAttribute("data-dir")), behavior: "smooth" });
      });
    });
    root.querySelectorAll(".tvs-poster").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var dialog = root.querySelector("#" + btn.getAttribute("data-dialog"));
        if (!dialog || typeof dialog.showModal !== "function") return;
        var frame = dialog.querySelector("iframe[data-src]");
        if (frame && !frame.getAttribute("src")) frame.setAttribute("src", frame.getAttribute("data-src"));
        dialog.showModal();
        var video = dialog.querySelector("video");
        if (video) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
      });
    });
    root.querySelectorAll(".tvs-dialog").forEach(function (dialog) {
      dialog.addEventListener("close", function () {
        var video = dialog.querySelector("video");
        if (video) video.pause();
        var frame = dialog.querySelector("iframe");
        if (frame) frame.removeAttribute("src");
      });
      dialog.addEventListener("click", function (e) { if (e.target === dialog) dialog.close(); });
    });
  })();
</script>
