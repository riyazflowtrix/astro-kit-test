---
---

<section id="case-study-cards" class="section case-study-cards">
  <!-- kit: case-study-cards -->
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Customers</span>
      <h2>Teams that got their Fridays back.</h2>
    </header>

    <ul class="csc-grid" role="list">
      <li>
        <article class="card csc-card">
          <img class="csc-image" src="https://picsum.photos/seed/ledgerly-masa-bakery/1200/800" alt="Bakers shaping conchas at Masa Bakery before opening" width="1200" height="800" loading="lazy" />
          <div class="csc-body">
            <div class="csc-meta">
              <span class="csc-logo">Masa Bakery</span>
              <span class="csc-industry">Hospitality</span>
            </div>
            <p class="csc-metric">6 hours saved every month</p>
            <h3><a href="/customers/masa-bakery">How a three-location bakery stopped doing the books on Sunday nights</a></h3>
            <span class="csc-more" aria-hidden="true">Read the story →</span>
          </div>
        </article>
      </li>
      <li>
        <article class="card csc-card">
          <img class="csc-image" src="https://picsum.photos/seed/ledgerly-north-fork/1200/800" alt="A North Fork Builders crew framing a house" width="1200" height="800" loading="lazy" />
          <div class="csc-body">
            <div class="csc-meta">
              <span class="csc-logo">North Fork Builders</span>
              <span class="csc-industry">Construction</span>
            </div>
            <p class="csc-metric">Job costing in real time</p>
            <h3><a href="/customers/north-fork-builders">North Fork Builders replaced a 40-tab spreadsheet with live job costing</a></h3>
            <span class="csc-more" aria-hidden="true">Read the story →</span>
          </div>
        </article>
      </li>
      <li>
        <article class="card csc-card">
          <img class="csc-image" src="https://picsum.photos/seed/ledgerly-loop-thread/1200/800" alt="Spools of thread on the wall of the Loop & Thread studio" width="1200" height="800" loading="lazy" />
          <div class="csc-body">
            <div class="csc-meta">
              <span class="csc-logo">Loop &amp; Thread</span>
              <span class="csc-industry">Retail</span>
            </div>
            <p class="csc-metric">Paid 9 days sooner</p>
            <h3><a href="/customers/loop-and-thread">Loop &amp; Thread gets paid faster with reminders that sound like the founders</a></h3>
            <span class="csc-more" aria-hidden="true">Read the story →</span>
          </div>
        </article>
      </li>
    </ul>

    <div class="btn-row csc-cta">
      <a class="btn btn-secondary" href="/customers" title="Customers">All customer stories <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .csc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .csc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .csc-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .csc-image { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .csc-body { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem 1.5rem 1.5rem; flex: 1; }
  .csc-meta { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .csc-logo { font-weight: 800; letter-spacing: -0.02em; font-size: 1.0625rem; }
  .csc-industry { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .csc-metric { margin: 0.25rem 0 0; font-size: 1.5rem; font-weight: 700; color: var(--brand); letter-spacing: -0.02em; line-height: 1.2; }
  .csc-card h3 { font-size: 1.0625rem; font-weight: 600; line-height: 1.4; margin: 0; }
  .csc-card h3 a { text-decoration: none; }
  .csc-card h3 a::after { content: ""; position: absolute; inset: 0; }
  .csc-more { margin-top: auto; padding-top: 0.75rem; font-weight: 600; font-size: 0.9375rem; color: var(--ink-2); }
  .csc-cta { margin-top: 2.5rem; }
  @media (max-width: 900px) { .csc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .csc-grid { grid-template-columns: 1fr; } }
</style>
