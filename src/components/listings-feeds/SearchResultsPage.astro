<script>
  const root = document.getElementById("search-results-page");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const dir = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!dir) return;
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
    const input = root.querySelector<HTMLInputElement>("#search-page-q");
    const results = root.querySelector<HTMLElement>("[data-results]");
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const run = (q: string) => {
      const term = q.trim().toLowerCase();
      const known = ["seasoning", "season", "dutch oven", "cable fold", "campfire paella", "warranty", "skillet", "bread"];
      const hit = term === "" || known.some((k) => term.includes(k) || k.includes(term));
      if (results) results.hidden = !hit;
      if (empty) empty.hidden = hit;
      const span = root.querySelector<HTMLElement>("[data-empty-q]");
      if (span) span.textContent = q;
    };
    root.querySelector("form")?.addEventListener("submit", (e) => { e.preventDefault(); run(input?.value ?? ""); });
    root.querySelectorAll<HTMLButtonElement>("[data-q]").forEach((b) => b.addEventListener("click", () => {
      if (input) input.value = b.dataset.q ?? "";
      run(b.dataset.q ?? "");
    }));
  }
</script>

