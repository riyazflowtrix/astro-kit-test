---
// Site-wide announcement bar (solid, brand tone) with a page-level message override. Dismissible.
---

<aside id="global-announcement-overrides" class="announce announce--solid announce--brand" aria-label="Announcement">
  <!-- kit: global-announcement-overrides -->
  <div class="container announce__inner">
    <p class="announce__text">
      <a class="announce__link" href="/products/cable-fold#accessories" title="Cable Fold Grill">Cable Fold owners: free shipping on every grate accessory this week.</a>
      <small class="announce__legal">US orders only. Ends <time datetime="2026-10-12T23:59:00-07:00">Oct 12, 11:59 pm PT</time>.</small>
    </p>
    <button type="button" class="announce__close" aria-label="Dismiss announcement">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
</aside>

<script>
  {
    const root = document.getElementById("global-announcement-overrides");
    root?.querySelector(".announce__close")?.addEventListener("click", () => {
      root.hidden = true;
    });
  }
</script>

<style>
  .announce {
    position: relative;
    background: var(--brand);
    color: var(--brand-ink);
  }
  .announce[hidden] {
    display: none;
  }
  .announce__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 48px;
    padding-block: 0.5rem;
  }
  .announce__text {
    margin: 0;
    flex: 1;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .announce__link {
    font-weight: 600;
    color: inherit;
    text-underline-offset: 3px;
  }
  .announce__legal {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.8125rem;
    opacity: 0.85;
  }
  .announce__close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .announce__close:hover {
    background: rgb(255 255 255 / 0.15);
  }
</style>
