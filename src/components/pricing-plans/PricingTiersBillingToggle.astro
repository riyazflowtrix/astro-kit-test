<section id="pricing-tiers-billing-toggle" class="section tiers">
  <!-- kit: pricing-tiers-billing-toggle -->
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">Pricing</span>
      <h2>Start free. Pay when you ship.</h2>
      <p class="lead">Every plan includes unlimited endpoints, signed webhooks and automatic retries.</p>
    </div>

    <div class="tiers__toggle" role="radiogroup" aria-label="Billing cycle">
      <button type="button" role="radio" aria-checked="false" data-cycle="monthly">Monthly</button>
      <button type="button" role="radio" aria-checked="true" data-cycle="yearly">Yearly <span class="badge">Save 20%</span></button>
    </div>

    <ul class="tiers__grid" role="list">
      <li class="tiers__plan">
        <h3>Hobby</h3>
        <p class="tiers__audience">For side projects and prototypes</p>
        <p class="tiers__price"><strong>$0</strong><span>free forever</span></p>
        <a class="btn btn-secondary tiers__cta" href="https://app.northwind.dev/signup">Start building</a>
        <ul class="tiers__features" role="list">
          <li>100k events a month</li>
          <li>3-day event history</li>
          <li>Community support</li>
        </ul>
      </li>
      <li class="tiers__plan tiers__plan--featured">
        <span class="badge tiers__badge">Most popular</span>
        <h3>Pro</h3>
        <p class="tiers__audience">For apps in production</p>
        <p class="tiers__price"><strong data-monthly="$49" data-yearly="$39">$39</strong><span data-monthly="a month" data-yearly="a month, billed yearly">a month, billed yearly</span></p>
        <a class="btn btn-primary tiers__cta" href="https://app.northwind.dev/signup?plan=pro" data-stripe-monthly="price_1PqProMonthly49" data-stripe-yearly="price_1PqProYearly468">Start 14-day trial <span aria-hidden="true">&rarr;</span></a>
        <p class="tiers__inherits">Everything in Hobby, plus:</p>
        <ul class="tiers__features" role="list">
          <li>2M events a month</li>
          <li>30-day event history</li>
          <li>Replay failed deliveries</li>
          <li>Email support, 1-day reply</li>
        </ul>
      </li>
      <li class="tiers__plan">
        <h3>Team</h3>
        <p class="tiers__audience">For teams with on-call rotations</p>
        <p class="tiers__price"><strong data-monthly="$25" data-yearly="$20">$20</strong><span data-monthly="per seat a month, min. 3 seats" data-yearly="per seat a month, billed yearly, min. 3 seats">per seat a month, billed yearly, min. 3 seats</span></p>
        <a class="btn btn-secondary tiers__cta" href="https://app.northwind.dev/signup?plan=team" data-stripe-monthly="price_1PqTeamSeatMonthly25" data-stripe-yearly="price_1PqTeamSeatYearly240">Start 14-day trial</a>
        <p class="tiers__inherits">Everything in Pro, plus:</p>
        <ul class="tiers__features" role="list">
          <li>10M events a month</li>
          <li>90-day event history</li>
          <li>SSO with Google and Okta</li>
          <li>Audit log</li>
        </ul>
      </li>
      <li class="tiers__plan">
        <h3>Enterprise</h3>
        <p class="tiers__audience">For regulated industries and high volume</p>
        <p class="tiers__price"><strong>Let's talk</strong><span>custom pricing</span></p>
        <a class="btn btn-secondary tiers__cta" href="/contact-sales">Talk to sales</a>
        <p class="tiers__inherits">Everything in Team, plus:</p>
        <ul class="tiers__features" role="list">
          <li>Volume pricing</li>
          <li>Dedicated region</li>
          <li>99.99% uptime SLA</li>
          <li>HIPAA BAA</li>
        </ul>
      </li>
    </ul>

    <p class="tiers__footnote">Prices in USD, excluding tax. Events over your plan's allowance are billed at $0.40 per 100k.</p>
  </div>
</section>

<script>
  const root = document.getElementById("pricing-tiers-billing-toggle");
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-cycle]");
    const apply = (cycle: string) => {
      buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.cycle === cycle)));
      root.querySelectorAll<HTMLElement>("[data-monthly]").forEach((el) => {
        const text = cycle === "yearly" ? el.dataset.yearly : el.dataset.monthly;
        if (text) el.textContent = text;
      });
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.cycle ?? "yearly")));
  }
</script>

<style>
  .tiers__toggle { display: flex; width: max-content; max-width: 100%; margin: 0 auto 2.5rem; padding: 4px; border-radius: 999px; background: var(--surface-2); }
  .tiers__toggle button { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding: 0 1.125rem; border: 0; border-radius: 999px; background: transparent; font: inherit; font-weight: 600; font-size: 0.9375rem; color: var(--ink-2); cursor: pointer; }
  .tiers__toggle button[aria-checked="true"] { background: var(--bg); color: var(--ink); box-shadow: var(--shadow); }
  .tiers__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; align-items: stretch; }
  .tiers__plan { position: relative; display: flex; flex-direction: column; padding: 1.75rem 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); }
  .tiers__plan--featured { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand), var(--shadow); }
  .tiers__badge { position: absolute; top: -0.75rem; left: 1.5rem; background: var(--brand); color: var(--brand-ink); }
  .tiers__plan h3 { margin-bottom: 0.25rem; }
  .tiers__audience { color: var(--ink-2); font-size: 0.9375rem; min-height: 3em; }
  .tiers__price { display: grid; margin-bottom: 1.25rem; }
  .tiers__price strong { font-size: 2.25rem; line-height: 1.1; letter-spacing: -0.02em; }
  .tiers__price span { font-size: 0.8125rem; color: var(--ink-3); min-height: 2.6em; }
  .tiers__cta { width: 100%; margin-bottom: 1.5rem; }
  .tiers__inherits { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; }
  .tiers__features { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; font-size: 0.9375rem; }
  .tiers__features li { position: relative; padding-left: 1.5rem; }
  .tiers__features li::before { content: ""; position: absolute; left: 0.125rem; top: 0.45em; width: 6px; height: 11px; border: solid var(--success); border-width: 0 2px 2px 0; rotate: 45deg; }
  .tiers__footnote { margin-top: 2rem; text-align: center; font-size: 0.8125rem; color: var(--ink-3); }
</style>
