---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<section id="pricing-enterprise-card" class="section enterprise">
  <!-- kit: pricing-enterprise-card -->
  <div class="container">
    <div class="enterprise__card">
      <div class="enterprise__copy">
        <span class="eyebrow">Enterprise</span>
        <h2>Billions of events. One calm on-call.</h2>
        <p class="lead">Volume pricing, a dedicated region and a named engineer who knows your integration. We'll scope it with you in a 30-minute call.</p>
        <ul class="enterprise__points" role="list">
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>Dedicated region in US, EU or APAC</li>
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z M9 11h6v5H9z M10 11V9a2 2 0 0 1 4 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>SAML SSO, SCIM and audit log export</li>
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 7v5l3 2 M20 12a8 8 0 1 0-8 8 M15 19l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>99.99% uptime SLA with credits</li>
          <li><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2 M4 14h3v5H4z M17 14h3v5h-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Named support engineer, 1-hour P1 response</li>
        </ul>
        <ul class="enterprise__compliance" role="list" aria-label="Compliance">
          <li>SOC 2 Type II</li>
          <li>HIPAA</li>
          <li>GDPR</li>
        </ul>
        <blockquote class="enterprise__quote">
          <p>"We moved 4 billion webhooks a month to Northwind and our pager went quiet within a week."</p>
          <footer><strong>Ines Albright</strong> &middot; Staff Engineer, Kestrel Pay</footer>
        </blockquote>
        <ul class="enterprise__logos" role="list" aria-label="Enterprise customers">
          <li><img src="https://picsum.photos/seed/northwind-logo-halcyon/320/120" alt="Halcyon Health logo" width="320" height="120" loading="lazy" /></li>
          <li><img src="https://picsum.photos/seed/northwind-logo-ferrous/320/120" alt="Ferrous Freight logo" width="320" height="120" loading="lazy" /></li>
          <li><img src="https://picsum.photos/seed/northwind-logo-kestrel/320/120" alt="Kestrel Pay logo" width="320" height="120" loading="lazy" /></li>
        </ul>
      </div>

      <form class="enterprise__form" action={bcmsFormAction("Talk to sales")} method={bcmsFormMethod("Talk to sales")} aria-labelledby="enterprise-form-title" data-bcms-form={bcmsFormId("Talk to sales")} data-bcms-form-success="Thank you for your submission!">
        <h3 id="enterprise-form-title">Talk to sales</h3>
        <div class="field" data-bcms-form-field="name">
          <label for="ent-name" data-bcms-form-part="label">Full name</label>
          <input id="ent-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field" data-bcms-form-field="email">
          <label for="ent-email" data-bcms-form-part="label">Work email</label>
          <input id="ent-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field" data-bcms-form-field="company">
          <label for="ent-company" data-bcms-form-part="label">Company</label>
          <input id="ent-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field" data-bcms-form-field="volume">
          <label for="ent-volume" data-bcms-form-part="label">Events a month</label>
          <select id="ent-volume" name="volume">
            <option>Under 50M</option>
            <option>50M &ndash; 500M</option>
            <option>500M &ndash; 5B</option>
            <option>Over 5B</option>
          </select>
        </div>
        <div class="field" data-bcms-form-field="message">
          <label for="ent-message" data-bcms-form-part="label">What are you building?</label>
          <textarea id="ent-message" name="message" rows="3"></textarea>
        </div>
        <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Talk to sales</button>
        <p class="enterprise__response">We reply within one business day</p>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
    </div>
  </div>
</section>

<style>
  .enterprise__card { display: grid; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius-lg); background: var(--dark); color: var(--dark-ink); }
  @media (min-width: 900px) { .enterprise__card { grid-template-columns: 1.3fr 1fr; gap: 3.5rem; } }
  .enterprise__card .lead { color: color-mix(in srgb, var(--dark-ink) 75%, transparent); }
  .enterprise__points { list-style: none; margin: 1.5rem 0; padding: 0; display: grid; gap: 0.75rem; }
  .enterprise__points li { display: flex; align-items: center; gap: 0.75rem; }
  .enterprise__points svg { flex: none; color: var(--brand); }
  .enterprise__compliance { list-style: none; margin: 0 0 1.75rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .enterprise__compliance li { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; padding: 0.25rem 0.625rem; border: 1px solid rgb(255 255 255 / 0.25); border-radius: 999px; }
  .enterprise__quote { margin: 0 0 1.5rem; padding-left: 1rem; border-left: 3px solid var(--brand); }
  .enterprise__quote p { font-size: 1.0625rem; margin-bottom: 0.5rem; }
  .enterprise__quote footer { font-size: 0.875rem; color: color-mix(in srgb, var(--dark-ink) 65%, transparent); }
  .enterprise__logos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .enterprise__logos img { height: 36px; width: auto; border-radius: 4px; opacity: 0.85; filter: grayscale(1); }
  .enterprise__form { display: grid; gap: 1rem; align-content: start; padding: 1.5rem; border-radius: var(--radius); background: var(--bg); color: var(--ink); }
  .enterprise__form h3 { margin: 0; }
  .enterprise__form textarea { min-height: 88px; }
  .enterprise__response { margin: 0; font-size: 0.8125rem; color: var(--ink-3); text-align: center; }
</style>
