---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---
<section id="pricing-single-plan-addons" class="section addons">
  <!-- kit: pricing-single-plan-addons -->
  <div class="container">
    <div class="section-head">
      <h2>The Recovery Membership</h2>
      <p class="lead">Steady, one-to-one care for runners, climbers and anyone coming back from an injury. Book online, cancel any time after three months.</p>
    </div>

    <form class="addons__layout" action={bcmsFormAction("Add to your membership")} method={bcmsFormMethod("Add to your membership")} data-bcms-form={bcmsFormId("Add to your membership")} data-bcms-form-success="Thank you for your submission!">
      <div class="addons__plan">
        <h3>Recovery Membership</h3>
        <p class="addons__price"><strong>$189</strong><span>/ month</span></p>
        <p class="addons__commit">3 months, then month to month</p>
        <ul class="addons__includes" role="list">
          <li>Two 45-minute sessions a month</li>
          <li>A home program in the Juniper app</li>
          <li>Message your physio between visits</li>
          <li>10% off retail and taping</li>
        </ul>
      </div>

      <fieldset class="addons__list">
        <legend>Add to your membership</legend>

        <div class="addon" data-price="95" data-unit="month">
          <div class="addon__text">
            <p class="addon__name">Extra session <span class="addon__hsa">HSA/FSA eligible</span></p>
            <p class="addon__desc">Another 45-minute visit in the same month.</p>
            <p class="addon__unit">$95 per session</p>
          </div>
          <div class="addon__qty" data-bcms-form-field="extraSession">
            <label for="addon-extra" class="visually-hidden" data-bcms-form-part="label">Extra sessions</label>
            <button type="button" data-step="-1" aria-label="Fewer extra sessions">&minus;</button>
            <input id="addon-extra" name="extraSession" type="number" min="0" max="4" value="0" inputmode="numeric" />
            <button type="button" data-step="1" aria-label="More extra sessions">+</button>
          </div>
        </div>

        <div class="addon" data-price="40" data-unit="month">
          <div class="addon__text">
            <p class="addon__name">Dry needling <span class="addon__hsa">HSA/FSA eligible</span></p>
            <p class="addon__desc">Added to a session for stubborn muscle tension.</p>
            <p class="addon__unit">$40 per session</p>
          </div>
          <div class="addon__qty" data-bcms-form-field="dryNeedling">
            <label for="addon-needling" class="visually-hidden" data-bcms-form-part="label">Dry needling sessions</label>
            <button type="button" data-step="-1" aria-label="Fewer dry needling sessions">&minus;</button>
            <input id="addon-needling" name="dryNeedling" type="number" min="0" max="6" value="0" inputmode="numeric" />
            <button type="button" data-step="1" aria-label="More dry needling sessions">+</button>
          </div>
        </div>

        <label class="addon addon--check" data-price="105" data-unit="month" data-bcms-form-field="sportsMassage">
          <span class="addon__text">
            <span class="addon__name">Sports massage, 60 min</span>
            <span class="addon__desc">With one of our licensed massage therapists.</span>
            <span class="addon__unit">$105 per session</span>
          </span>
          <input type="checkbox" name="sportsMassage" value="1" />
        </label>

        <label class="addon addon--check" data-price="150" data-unit="once" data-bcms-form-field="gaitAnalysis">
          <span class="addon__text">
            <span class="addon__name">Running gait analysis <span class="addon__hsa">HSA/FSA eligible</span></span>
            <span class="addon__desc">Treadmill video analysis and a written report.</span>
            <span class="addon__unit">$150 one time</span>
          </span>
          <input type="checkbox" name="gaitAnalysis" value="1" />
        </label>
      </fieldset>

      <div class="addons__summary" aria-live="polite">
        <p class="addons__total-label">Your monthly total</p>
        <p class="addons__total"><strong data-total>$189</strong><span>/ month</span></p>
        <p class="addons__once" data-once hidden></p>
        <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Book your first visit <span aria-hidden="true">&rarr;</span></button>
        <div class="addons__fine">
          <p>Unused sessions roll over for one month. We'll give you a superbill for out-of-network insurance claims. Cancel with 30 days' notice after the first three months &mdash; <a href="/membership-terms">read the terms</a>.</p>
        </div>
      </div>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
  </div>
</section>

<script>
  const root = document.getElementById("pricing-single-plan-addons");
  if (root) {
    const form = root.querySelector("form");
    const update = () => {
      let monthly = 189;
      let once = 0;
      root.querySelectorAll<HTMLElement>(".addon").forEach((a) => {
        const price = Number(a.dataset.price);
        const num = a.querySelector<HTMLInputElement>('input[type="number"]');
        const box = a.querySelector<HTMLInputElement>('input[type="checkbox"]');
        const qty = num ? Math.max(0, Math.min(Number(num.max), Number(num.value) || 0)) : box?.checked ? 1 : 0;
        if (a.dataset.unit === "once") once += price * qty;
        else monthly += price * qty;
      });
      const total = root.querySelector<HTMLElement>("[data-total]");
      const onceEl = root.querySelector<HTMLElement>("[data-once]");
      if (total) total.textContent = `$${monthly}`;
      if (onceEl) { onceEl.hidden = once === 0; onceEl.textContent = `Plus $${once} one time`; }
    };
    root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) => b.addEventListener("click", () => {
      const input = b.parentElement?.querySelector<HTMLInputElement>("input");
      if (!input) return;
      const next = Number(input.value) + Number(b.dataset.step);
      input.value = String(Math.max(Number(input.min), Math.min(Number(input.max), next)));
      update();
    }));
    form?.addEventListener("input", update);
    form?.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style>
  .addons__layout { display: grid; gap: 1.5rem; }
  @media (min-width: 980px) { .addons__layout { grid-template-columns: 1fr 1.3fr 1fr; align-items: start; } }
  .addons__plan, .addons__summary { padding: 1.75rem; border-radius: var(--radius-lg); }
  .addons__plan { background: var(--dark); color: var(--dark-ink); }
  .addons__price { display: flex; align-items: baseline; gap: 0.375rem; margin: 0.5rem 0 0; }
  .addons__price strong { font-size: 2.75rem; letter-spacing: -0.03em; line-height: 1; }
  .addons__price span, .addons__commit { color: color-mix(in srgb, var(--dark-ink) 70%, transparent); }
  .addons__commit { font-size: 0.875rem; }
  .addons__includes { list-style: none; margin: 1.25rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid rgb(255 255 255 / 0.15); display: grid; gap: 0.625rem; }
  .addons__includes li { padding-left: 1.5rem; position: relative; }
  .addons__includes li::before { content: ""; position: absolute; left: 0.125rem; top: 0.45em; width: 6px; height: 11px; border: solid var(--brand); border-width: 0 2px 2px 0; rotate: 45deg; }
  .addons__list { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 0.75rem; }
  .addons__list legend { font-weight: 700; font-size: 1.125rem; margin-bottom: 0.75rem; }
  .addon { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.125rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .addon--check { cursor: pointer; }
  .addon--check:has(input:checked) { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  .addon--check input { width: 22px; height: 22px; accent-color: var(--brand); flex: none; }
  .addon__text p { margin: 0; }
  .addon__text > span { display: block; }
  .addon__name { font-weight: 600; }
  .addon__hsa { display: inline-block; margin-left: 0.25rem; font-size: 0.6875rem; font-weight: 600; padding: 0 0.375rem; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); vertical-align: middle; }
  .addon__desc { font-size: 0.875rem; color: var(--ink-2); }
  .addon__unit { font-size: 0.875rem; font-weight: 600; margin-top: 0.25rem !important; }
  .addon__qty { display: flex; align-items: center; border: 1px solid var(--line); border-radius: var(--radius-sm); flex: none; }
  .addon__qty button { width: 36px; height: 40px; border: 0; background: none; font-size: 1.125rem; cursor: pointer; color: var(--ink); }
  .addon__qty input { width: 40px; height: 40px; border: 0; text-align: center; -moz-appearance: textfield; appearance: textfield; background: transparent; }
  .addon__qty input::-webkit-inner-spin-button, .addon__qty input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .addons__summary { background: var(--surface); display: grid; gap: 0.75rem; }
  .addons__summary p { margin: 0; }
  .addons__total-label { font-weight: 600; color: var(--ink-2); font-size: 0.875rem; }
  .addons__total { display: flex; align-items: baseline; gap: 0.375rem; }
  .addons__total strong { font-size: 2.5rem; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .addons__total span { color: var(--ink-3); }
  .addons__once { font-size: 0.9375rem; font-weight: 600; }
  .addons__fine p { font-size: 0.8125rem; color: var(--ink-3); }
  .addons__fine a { color: var(--ink-2); }
</style>
