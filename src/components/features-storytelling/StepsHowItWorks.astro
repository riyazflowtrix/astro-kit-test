---
---

<section id="steps-how-it-works" class="section section--muted steps-how-it-works">
  <!-- kit: steps-how-it-works -->
  <div class="container">
    <header class="section-head section-head--center">
      <span class="eyebrow">Lifetime exchange</span>
      <h2>Wore it out? Send it home.</h2>
    </header>

    <ol class="steps" role="list">
      <li class="step">
        <div class="step-top">
          <span class="step-num">01</span>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l1.9-5.2A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"/></svg>
          </span>
        </div>
        <h3>Start a claim</h3>
        <p>Tell us what happened and add a photo. No receipt, no proof of purchase.</p>
        <p class="step-duration">2 minutes</p>
        <a class="step-link" href="/warranty/claim" title="Warranty claim">Start a claim <span aria-hidden="true">→</span></a>
      </li>
      <li class="step">
        <div class="step-top">
          <span class="step-num">02</span>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
          </span>
        </div>
        <h3>Print the label</h3>
        <p>We email a prepaid label. Drop the box at any UPS store.</p>
        <p class="step-duration">Same day</p>
      </li>
      <li class="step">
        <div class="step-top">
          <span class="step-num">03</span>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/></svg>
          </span>
        </div>
        <h3>We restore it</h3>
        <p>Our foundry team strips, re-machines and reseasons it — or casts you a new one.</p>
        <p class="step-duration">10 days</p>
      </li>
      <li class="step">
        <div class="step-top">
          <span class="step-num">04</span>
          <span class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </span>
        </div>
        <h3>Cook again</h3>
        <p>It ships back to you free, seasoned and ready for the next fire.</p>
        <p class="step-duration">3–5 days</p>
      </li>
    </ol>

    <div class="btn-row steps-cta">
      <a class="btn btn-secondary" href="/warranty" title="Warranty">Read the full warranty</a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
  }
  .step-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  /* connector line between steps */
  .step:not(:last-child) .step-top::after {
    content: "";
    position: absolute;
    left: 6.5rem;
    right: -1.5rem;
    top: 50%;
    border-top: 2px dashed var(--line);
  }
  .step-num {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }
  .step-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .step h3 { margin-bottom: 0.375rem; }
  .step p { color: var(--ink-2); margin-bottom: 0.5rem; }
  .step .step-duration {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface-2);
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
  }
  .step-link {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
  }
  .steps-cta { justify-content: center; margin-top: 3rem; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step:nth-child(2n) .step-top::after { display: none; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .step .step-top::after { display: none; }
  }
</style>
