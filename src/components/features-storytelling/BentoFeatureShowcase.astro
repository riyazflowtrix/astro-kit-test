---
---

<section id="bento-feature-showcase" class="section bento-feature-showcase">
  <!-- kit: bento-feature-showcase -->
  <div class="container">
    <header class="section-head section-head--center">
      <span class="eyebrow">Product tour</span>
      <h2>Close the month in a day, not a week.</h2>
      <p class="lead">Ledgerly reconciles bank feeds, chases invoices and drafts your books while you run the business.</p>
    </header>

    <div class="bento">
      <figure class="bento-cell bento-image surface-muted span-2 rows-2 tab-full m-order-1">
        <img src="https://picsum.photos/seed/ledgerly-reconcile-ui/1200/1000" alt="Bank reconciliation screen matching 48 transactions automatically" width="1800" height="1500" loading="lazy" />
        <figcaption>Auto-match 95% of bank lines</figcaption>
      </figure>

      <div class="bento-cell bento-stat surface-brand tab-half m-order-3">
        <span class="bento-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <p class="bento-stat-value">6 hrs</p>
        <p class="bento-stat-label">Saved per close, on average</p>
      </div>

      <div class="bento-cell bento-feature surface-muted tab-half m-order-4">
        <span class="bento-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2z"/><path d="M9 8h6M9 12h6"/></svg>
        </span>
        <h3>Receipts by email</h3>
        <p>Forward a receipt to your inbox address and it lands on the right transaction.</p>
      </div>

      <div class="bento-cell bento-video surface-dark span-2 tab-full m-order-2">
        <a class="bento-video-link" href="https://www.youtube.com/watch?v=ledgerly-reminders" target="_blank" rel="noopener">
          <img src="https://picsum.photos/seed/ledgerly-reminders/1200/600" alt="Invoice reminder email preview" width="1800" height="900" loading="lazy" />
          <span class="bento-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span class="bento-video-title">Invoice reminders that sound like you<span class="visually-hidden"> (play video, opens YouTube)</span></span>
        </a>
      </div>

      <figure class="bento-cell bento-quote surface-image span-2 tab-full m-order-5">
        <img class="bento-bg" src="https://picsum.photos/seed/ledgerly-bakery/1200/600" alt="Bakery counter at opening time" width="1800" height="900" loading="lazy" />
        <div class="bento-quote-inner">
          <p class="bento-stars" aria-label="Rated 5 out of 5">★★★★★</p>
          <blockquote>
            <p>“We stopped paying our bookkeeper overtime in March. That's the whole review.”</p>
          </blockquote>
          <figcaption><strong>Rosa Delgado</strong> · Owner, Masa Bakery</figcaption>
        </div>
      </figure>
    </div>

    <div class="btn-row bento-cta">
      <a class="btn btn-primary" href="/signup" title="Sign up">Start a free trial <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(220px, auto);
    gap: 1rem;
  }
  .bento-cell {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 1.5rem;
    min-width: 0;
  }
  .span-2 { grid-column: span 2; }
  .rows-2 { grid-row: span 2; }
  .surface-muted { background: var(--surface); }
  .surface-brand { background: var(--brand); color: var(--brand-ink); }
  .surface-dark { background: var(--dark); color: var(--dark-ink); padding: 0; }
  .surface-image { color: #fff; padding: 0; }

  .bento-image {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }
  .bento-image img {
    width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: contain;
    border-radius: var(--radius);
  }
  .bento-image figcaption {
    font-weight: 600;
    font-size: 1.125rem;
  }
  .bento-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 12%, transparent);
    margin-bottom: 1rem;
  }
  .bento-stat-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  .bento-stat-label { margin: 0; opacity: 0.9; }
  .bento-feature p { color: var(--ink-2); margin: 0; }

  .bento-video-link {
    display: block;
    position: relative;
    height: 100%;
    min-height: 220px;
    color: inherit;
    text-decoration: none;
  }
  .bento-video-link img,
  .bento-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bento-video-link img { opacity: 0.7; transition: opacity 200ms ease; }
  .bento-video-link:hover img { opacity: 0.85; }
  .bento-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--dark);
  }
  .bento-video-title {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.25rem;
    font-weight: 600;
    font-size: 1.125rem;
  }
  .bento-quote::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.7));
  }
  .bento-quote-inner {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .bento-quote blockquote { margin: 0 0 0.75rem; }
  .bento-quote blockquote p {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }
  .bento-stars { color: #f5c04a; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .bento-cta { justify-content: center; margin-top: 2.5rem; }

  @media (max-width: 960px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tab-full { grid-column: 1 / -1; }
    .tab-half { grid-column: span 1; }
    .rows-2 { grid-row: span 1; }
    .bento-image img { max-height: 360px; }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; }
    .tab-half, .tab-full, .span-2 { grid-column: 1 / -1; }
    .m-order-1 { order: 1; }
    .m-order-2 { order: 2; }
    .m-order-3 { order: 3; }
    .m-order-4 { order: 4; }
    .m-order-5 { order: 5; }
  }
</style>
