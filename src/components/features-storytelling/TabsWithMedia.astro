---
---

<section id="tabs-with-media" class="section section--muted tabs-with-media" data-autoplay="true" data-interval="7">
  <!-- kit: tabs-with-media -->
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">How teams use Ledgerly</span>
      <h2>One ledger for everyone who touches the money.</h2>
    </header>

    <div class="twm">
      <div class="twm-list" role="tablist" aria-label="Who uses Ledgerly" aria-orientation="vertical">
        <button class="twm-tab" type="button" role="tab" id="twm-tab-owners" aria-controls="twm-panel-owners" aria-selected="true">
          <span class="twm-tab-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"/><path d="M5 21V10.8M19 21V10.8"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>
          </span>
          <span class="twm-tab-text">
            <span class="twm-tab-label">Owners</span>
            <span class="twm-tab-summary">Cash position and runway, every morning.</span>
          </span>
          <span class="twm-progress" aria-hidden="true"></span>
        </button>
        <button class="twm-tab" type="button" role="tab" id="twm-tab-bookkeepers" aria-controls="twm-panel-bookkeepers" aria-selected="false" tabindex="-1">
          <span class="twm-tab-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8"/><path d="M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 18h.01M12 18h.01M16 18h.01"/></svg>
          </span>
          <span class="twm-tab-text">
            <span class="twm-tab-label">Bookkeepers</span>
            <span class="twm-tab-summary">Reconcile 20 clients from one inbox.</span>
          </span>
          <span class="twm-progress" aria-hidden="true"></span>
        </button>
        <button class="twm-tab" type="button" role="tab" id="twm-tab-accountants" aria-controls="twm-panel-accountants" aria-selected="false" tabindex="-1">
          <span class="twm-tab-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M5 8V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2h-5"/><circle cx="6" cy="14" r="3"/><path d="M4.5 17 3 22l3-1.5L9 22l-1.5-5"/></svg>
          </span>
          <span class="twm-tab-text">
            <span class="twm-tab-label">Accountants</span>
            <span class="twm-tab-summary">Year-end packs without the chase.</span>
          </span>
          <span class="twm-progress" aria-hidden="true"></span>
        </button>
      </div>

      <div class="twm-panels">
        <div class="twm-panel" role="tabpanel" id="twm-panel-owners" aria-labelledby="twm-tab-owners">
          <div class="twm-copy">
            <h3>Know your runway before coffee.</h3>
            <div class="twm-body">
              <p>A daily digest with cash on hand, money owed to you and what's due this week. <strong>No logins, no spreadsheets.</strong></p>
            </div>
            <a class="twm-link" href="/features/digest" title="Digest">See the daily digest <span aria-hidden="true">→</span></a>
          </div>
          <div class="twm-frame">
            <div class="twm-frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="https://picsum.photos/seed/ledgerly-digest/1600/1000" alt="Daily digest email showing cash on hand and upcoming bills" width="2400" height="1500" loading="lazy" />
          </div>
        </div>

        <div class="twm-panel" role="tabpanel" id="twm-panel-bookkeepers" aria-labelledby="twm-tab-bookkeepers" hidden>
          <div class="twm-copy">
            <h3>Every client, one reconciliation queue.</h3>
            <div class="twm-body">
              <p>Switch clients with one key. Rules you write for one client can be shared with the rest.</p>
            </div>
          </div>
          <div class="twm-frame">
            <div class="twm-frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <video src="https://cdn.ledgerly.com/tours/bookkeeper-queue.mp4" poster="https://picsum.photos/seed/ledgerly-queue-poster/1600/1000" width="2400" height="1500" controls muted playsinline preload="none" aria-label="Reconciliation queue across client accounts"></video>
          </div>
        </div>

        <div class="twm-panel" role="tabpanel" id="twm-panel-accountants" aria-labelledby="twm-tab-accountants" hidden>
          <div class="twm-copy">
            <h3>Tax-ready books, with the receipts attached.</h3>
            <div class="twm-body">
              <p>Export a year-end pack with every transaction linked to its receipt and every adjustment explained.</p>
            </div>
            <a class="twm-link" href="/partners" title="Partners">Partner program <span aria-hidden="true">→</span></a>
          </div>
          <div class="twm-frame">
            <div class="twm-frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="https://picsum.photos/seed/ledgerly-yearend/1600/1000" alt="Year-end pack export with attached receipts" width="2400" height="1500" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .twm {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .twm-list {
    display: grid;
    gap: 0.5rem;
  }
  .twm-tab {
    position: relative;
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    width: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
  }
  .twm-tab:hover { background: var(--surface-2); }
  .twm-tab[aria-selected="true"] {
    background: var(--bg);
    border-color: var(--line);
    box-shadow: var(--shadow);
  }
  .twm-tab-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .twm-tab[aria-selected="true"] .twm-tab-icon { background: var(--brand-soft); color: var(--brand); }
  .twm-tab-text { display: grid; gap: 0.125rem; }
  .twm-tab-label { font-weight: 600; }
  .twm-tab-summary { font-size: 0.875rem; color: var(--ink-2); }
  .twm-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background: var(--brand);
  }
  .twm-tab[aria-selected="true"] .twm-progress.is-running {
    animation: twm-fill var(--twm-interval, 7s) linear forwards;
  }
  @keyframes twm-fill { from { width: 0; } to { width: 100%; } }

  .twm-panel {
    display: grid;
    gap: 1.5rem;
  }
  .twm-panel[hidden] { display: none; }
  .twm-copy h3 { font-size: clamp(1.375rem, 2.4vw, 1.75rem); }
  .twm-body { color: var(--ink-2); }
  .twm-link { font-weight: 600; color: var(--brand); text-decoration: none; }
  .twm-link:hover { text-decoration: underline; }
  .twm-frame {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .twm-frame-bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .twm-frame-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .twm-frame img,
  .twm-frame video {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .twm { grid-template-columns: 1fr; }
    .twm-list { grid-auto-flow: column; grid-auto-columns: minmax(200px, 1fr); overflow-x: auto; padding-bottom: 0.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .twm-tab[aria-selected="true"] .twm-progress.is-running { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("tabs-with-media");
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var intervalSec = Number(root.getAttribute("data-interval")) || 7;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var autoplay = root.getAttribute("data-autoplay") === "true" && !reduce;
    var timer = null;
    root.style.setProperty("--twm-interval", intervalSec + "s");

    function select(index, focus) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        var panel = root.querySelector("#" + tab.getAttribute("aria-controls"));
        if (panel) panel.hidden = !on;
        var bar = tab.querySelector(".twm-progress");
        if (bar) {
          bar.classList.remove("is-running");
          if (on && autoplay) { void bar.offsetWidth; bar.classList.add("is-running"); }
        }
      });
      if (focus) tabs[index].focus();
    }
    function current() {
      return tabs.findIndex(function (t) { return t.getAttribute("aria-selected") === "true"; });
    }
    function stop() {
      autoplay = false;
      if (timer) clearInterval(timer);
      root.querySelectorAll(".twm-progress").forEach(function (b) { b.classList.remove("is-running"); });
    }
    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () { stop(); select(i, false); });
      tab.addEventListener("keydown", function (e) {
        var n = tabs.length, next = -1;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (i + 1) % n;
        if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (i - 1 + n) % n;
        if (e.key === "Home") next = 0;
        if (e.key === "End") next = n - 1;
        if (next > -1) { e.preventDefault(); stop(); select(next, true); }
      });
    });
    root.addEventListener("focusin", function (e) {
      if (!e.target.closest || !e.target.closest('[role="tab"]')) stop();
    });
    select(0, false);
    if (autoplay) {
      timer = setInterval(function () {
        if (!autoplay) return;
        select((current() + 1) % tabs.length, false);
      }, intervalSec * 1000);
    }
  })();
</script>
