---
---

<section id="timeline-company-history" class="section timeline-company-history">
  <!-- kit: timeline-company-history -->
  <div class="container">
    <header class="section-head section-head--center">
      <span class="eyebrow">Our story</span>
      <h2>Twelve years of fires, foundries and second chances.</h2>
      <p class="lead">From a garage in Bend to a foundry that pours 4,000 pans a week.</p>
    </header>

    <ol class="tl" role="list">
      <li class="tl-item is-highlighted">
        <div class="tl-marker" aria-hidden="true"></div>
        <div class="tl-card">
          <time class="tl-date" datetime="2014">2014</time>
          <h3>The first skillet</h3>
          <div class="tl-body">
            <p>Ana Ruiz pours a 10" skillet in her garage using scrap from a <a href="/journal/engine-blocks">1978 Ford engine block</a>.</p>
          </div>
          <img src="https://picsum.photos/seed/caldera-garage-2014/800/600" alt="Ana Ruiz holding the first Caldera skillet in her garage" width="1200" height="900" loading="lazy" />
        </div>
      </li>
      <li class="tl-item">
        <div class="tl-marker" aria-hidden="true"></div>
        <div class="tl-card">
          <time class="tl-date" datetime="2016-04">Spring 2016</time>
          <h3>The Kickstarter</h3>
          <div class="tl-body">
            <p>2,140 backers fund the first production run of the Ridge Skillet in 31 days.</p>
          </div>
        </div>
      </li>
      <li class="tl-item">
        <div class="tl-marker" aria-hidden="true"></div>
        <div class="tl-card">
          <time class="tl-date" datetime="2019">2019</time>
          <h3>Our own foundry</h3>
          <div class="tl-body">
            <p>We move into a 22,000 sq ft foundry on Bend's east side and hire our first twelve casters.</p>
          </div>
          <img src="https://picsum.photos/seed/caldera-foundry-2019/800/600" alt="The Caldera foundry floor with sand moulds in rows" width="1200" height="900" loading="lazy" />
        </div>
      </li>
      <li class="tl-item">
        <div class="tl-marker" aria-hidden="true"></div>
        <div class="tl-card">
          <time class="tl-date" datetime="2022-09-14">14 September 2022</time>
          <h3>Cable Fold launches</h3>
          <div class="tl-body">
            <p>Our first folding grill sells out in nine hours.</p>
          </div>
        </div>
      </li>
      <li class="tl-item is-highlighted">
        <div class="tl-marker" aria-hidden="true"></div>
        <div class="tl-card">
          <time class="tl-date" datetime="2025">2025</time>
          <h3>Lifetime exchange, 10,000th pan</h3>
          <div class="tl-body">
            <p>We restore our ten-thousandth returned pan — a 2015 skillet that had cooked across four continents.</p>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .tl {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .tl::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }
  .tl-item {
    position: relative;
    padding-left: 3rem;
    padding-bottom: 2.5rem;
  }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-marker {
    position: absolute;
    left: 4px;
    top: 0.4rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--ink-3);
  }
  .is-highlighted .tl-marker {
    border-color: var(--brand);
    background: var(--brand);
    box-shadow: 0 0 0 5px var(--brand-soft);
  }
  .tl-date {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.25rem;
  }
  .is-highlighted .tl-date { color: var(--brand); }
  .tl-card h3 { margin-bottom: 0.375rem; }
  .tl-body { color: var(--ink-2); }
  .tl-body a { color: var(--brand); }
  .tl-card img {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: 0.5rem;
  }
  .is-highlighted .tl-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-top: -0.75rem;
  }
  @media (max-width: 480px) {
    .tl-item { padding-left: 2.25rem; }
    .is-highlighted .tl-card { padding: 1rem; }
  }
</style>
