---
---

<section id="integrations-grid" class="section integrations-grid">
  <!-- kit: integrations-grid -->
  <div class="container">
    <header class="section-head section-head--center">
      <span class="eyebrow">Integrations</span>
      <h2>Plays well with the tools you already pay for.</h2>
      <p class="lead">Connect your bank, payroll, payments and store in a couple of clicks. No CSVs.</p>
    </header>

    <div class="ig-filter" role="group" aria-label="Filter integrations by category">
      <button type="button" class="ig-chip" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="ig-chip" data-filter="banking" aria-pressed="false">Banking</button>
      <button type="button" class="ig-chip" data-filter="payments" aria-pressed="false">Payments</button>
      <button type="button" class="ig-chip" data-filter="payroll" aria-pressed="false">Payroll</button>
      <button type="button" class="ig-chip" data-filter="commerce" aria-pressed="false">Commerce</button>
    </div>

    <ul class="ig-grid" role="list">
      <li class="ig-item" data-category="banking">
        <a class="ig-tile" href="/integrations/chase">
          <span class="ig-logo" style="--tile: #117aca;" aria-hidden="true">C</span>
          <span class="ig-name">Chase</span>
          <span class="ig-desc">Daily bank feeds for business checking and cards.</span>
          <span class="ig-cat">Banking</span>
        </a>
      </li>
      <li class="ig-item" data-category="banking">
        <a class="ig-tile" href="/integrations/mercury">
          <span class="ig-logo" style="--tile: #1e1e2a;" aria-hidden="true">M</span>
          <span class="ig-name">Mercury</span>
          <span class="ig-desc">Real-time transactions from every Mercury account.</span>
          <span class="ig-cat">Banking</span>
        </a>
      </li>
      <li class="ig-item" data-category="banking">
        <a class="ig-tile" href="/integrations/wells-fargo">
          <span class="ig-logo" style="--tile: #c8102e;" aria-hidden="true">W</span>
          <span class="ig-name">Wells Fargo</span>
          <span class="ig-desc">Business accounts, credit lines and merchant deposits.</span>
          <span class="ig-cat">Banking</span>
        </a>
      </li>
      <li class="ig-item" data-category="payments">
        <a class="ig-tile" href="/integrations/stripe">
          <span class="ig-logo" style="--tile: #635bff;" aria-hidden="true">S</span>
          <span class="ig-name">Stripe</span>
          <span class="ig-desc">Payouts split into sales, fees and refunds automatically.</span>
          <span class="ig-cat">Payments</span>
        </a>
      </li>
      <li class="ig-item" data-category="payments">
        <a class="ig-tile" href="/integrations/square">
          <span class="ig-logo" style="--tile: #3e4348;" aria-hidden="true">Sq</span>
          <span class="ig-name">Square</span>
          <span class="ig-desc">Point-of-sale takings, tips and card fees by location.</span>
          <span class="ig-cat">Payments</span>
        </a>
      </li>
      <li class="ig-item" data-category="payments">
        <a class="ig-tile" href="/integrations/paypal">
          <span class="ig-logo" style="--tile: #003087;" aria-hidden="true">P</span>
          <span class="ig-name">PayPal</span>
          <span class="ig-desc">Invoices paid by PayPal mark themselves as settled.</span>
          <span class="ig-cat">Payments</span>
        </a>
      </li>
      <li class="ig-item" data-category="payroll">
        <a class="ig-tile" href="/integrations/gusto">
          <span class="ig-logo" style="--tile: #f45d48;" aria-hidden="true">G</span>
          <span class="ig-name">Gusto</span>
          <span class="ig-desc">Payroll journals posted the day your team gets paid.</span>
          <span class="ig-cat">Payroll</span>
        </a>
      </li>
      <li class="ig-item" data-category="payroll">
        <a class="ig-tile" href="/integrations/adp">
          <span class="ig-logo" style="--tile: #d0271d;" aria-hidden="true">A</span>
          <span class="ig-name">ADP</span>
          <span class="ig-desc">Wages, taxes and benefits mapped to the right accounts.</span>
          <span class="ig-cat">Payroll</span>
        </a>
      </li>
      <li class="ig-item" data-category="payroll">
        <a class="ig-tile" href="/integrations/rippling">
          <span class="ig-logo" style="--tile: #7a2b45;" aria-hidden="true">R</span>
          <span class="ig-name">Rippling</span>
          <span class="ig-desc">Payroll and expense reimbursements in one sync.</span>
          <span class="ig-cat">Payroll</span>
        </a>
      </li>
      <li class="ig-item" data-category="commerce">
        <a class="ig-tile" href="/integrations/shopify">
          <span class="ig-logo" style="--tile: #5e8e3e;" aria-hidden="true">Sh</span>
          <span class="ig-name">Shopify</span>
          <span class="ig-desc">Orders, refunds and payouts reconciled per store.</span>
          <span class="ig-cat">Commerce</span>
        </a>
      </li>
      <li class="ig-item" data-category="commerce">
        <a class="ig-tile" href="/integrations/woocommerce">
          <span class="ig-logo" style="--tile: #7f54b3;" aria-hidden="true">Wo</span>
          <span class="ig-name">WooCommerce</span>
          <span class="ig-desc">Sales tax and shipping income from your WordPress store.</span>
          <span class="ig-cat">Commerce</span>
        </a>
      </li>
      <li class="ig-item" data-category="commerce">
        <a class="ig-tile" href="/integrations/etsy">
          <span class="ig-logo" style="--tile: #f1641e;" aria-hidden="true">E</span>
          <span class="ig-name">Etsy</span>
          <span class="ig-desc">Listing fees, sales and deposits matched every week.</span>
          <span class="ig-cat">Commerce</span>
        </a>
      </li>
    </ul>

    <p class="ig-status visually-hidden" aria-live="polite"></p>

    <div class="btn-row ig-cta">
      <a class="btn btn-secondary" href="/integrations" title="Integrations">Browse all 140 integrations <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .ig-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .ig-chip {
    min-height: 38px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .ig-chip:hover { border-color: var(--ink-3); }
  .ig-chip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ig-item[hidden] { display: none; }
  .ig-tile {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "logo name" "desc desc" "cat cat";
    align-items: center;
    gap: 0.75rem 0.875rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .ig-tile:hover { border-color: var(--ink-3); box-shadow: var(--shadow); }
  .ig-logo {
    grid-area: logo;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--tile);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .ig-name { grid-area: name; font-weight: 700; }
  .ig-desc { grid-area: desc; font-size: 0.875rem; color: var(--ink-2); line-height: 1.5; }
  .ig-cat { grid-area: cat; font-size: 0.75rem; font-weight: 600; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .ig-cta { justify-content: center; margin-top: 2.5rem; }
  @media (max-width: 1000px) { .ig-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .ig-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 440px) { .ig-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("integrations-grid");
    if (!root) return;
    var chips = Array.prototype.slice.call(root.querySelectorAll(".ig-chip"));
    var items = Array.prototype.slice.call(root.querySelectorAll(".ig-item"));
    var status = root.querySelector(".ig-status");
    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        var f = chip.getAttribute("data-filter");
        chips.forEach(function (c) { c.setAttribute("aria-pressed", c === chip ? "true" : "false"); });
        var shown = 0;
        items.forEach(function (item) {
          var match = f === "all" || item.getAttribute("data-category") === f;
          item.hidden = !match;
          if (match) shown++;
        });
        if (status) status.textContent = shown + " integrations shown";
      });
    });
  })();
</script>
