---
---

<section id="webinar-registration" class="section section--muted webinar" data-variant="split" data-stage="upcoming" data-starts-at="2026-10-22T13:00:00-04:00" data-minutes="45" data-campaign="701Hp00000ClOse3D">
  <!-- kit: webinar-registration -->
  <div class="container webinar__grid">
    <div class="webinar__info">
      <span class="eyebrow">Live webinar</span>
      <h2>Closing the books in 3 days, without the overtime</h2>
      <p class="lead">Northbeam's controller walks through the exact checklist, bank rules and review cadence that cut their close from 11 days to 3.</p>

      <p class="webinar__when">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
        <time datetime="2026-10-22T13:00:00-04:00">Thursday 22 October 2026, 1:00pm ET</time> · 45 minutes
      </p>

      <h3>What you'll learn</h3>
      <ul class="webinar__takeaways">
        <li>The 40-item close checklist, trimmed to 18</li>
        <li>Bank rules that match 92% of transactions</li>
        <li>How to run review without a war room</li>
        <li>Live Q&amp;A</li>
      </ul>

      <h3>Speakers</h3>
      <ul class="webinar__speakers">
        <li>
          <img src="https://picsum.photos/seed/ledgerline-dana-whitfield/240/240" alt="Portrait of Dana Whitfield" width="240" height="240" loading="lazy" />
          <div><strong>Dana Whitfield</strong><span>Controller, Northbeam</span></div>
        </li>
        <li>
          <img src="https://picsum.photos/seed/ledgerline-priya-raman/240/240" alt="Portrait of Priya Raman" width="240" height="240" loading="lazy" />
          <div><strong>Priya Raman</strong><span>Head of Customer Finance, Ledgerline</span></div>
        </li>
      </ul>
    </div>

    <div class="webinar__panel card">
      <form class="webinar__form" action="#" method="post" data-form="form_webinar-registration">
        <h3>Save your seat</h3>
        <div class="webinar__two">
          <div class="field">
            <label for="wb-first">First name</label>
            <input id="wb-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="wb-last">Last name</label>
            <input id="wb-last" name="last_name" type="text" autocomplete="family-name" required />
          </div>
        </div>
        <div class="field">
          <label for="wb-email">Work email</label>
          <input id="wb-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="wb-company">Company</label>
          <input id="wb-company" name="company" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="wb-role">Role</label>
          <select id="wb-role" name="role">
            <option>Controller</option>
            <option>CFO / VP Finance</option>
            <option>Accountant</option>
            <option>Other</option>
          </select>
        </div>
        <input type="hidden" name="campaign" value="701Hp00000ClOse3D" />
        <button class="btn btn-primary" type="submit">Register for free</button>
        <p class="webinar__fine">Can't make it live? Register anyway and we'll send the recording.</p>
      </form>

      <div class="webinar__confirm" role="status" hidden>
        <h3>You're in</h3>
        <p>We've emailed your join link. We'll send the recording to the same address, even if you can't make it live.</p>
        <div class="webinar__cal">
          <a class="btn btn-secondary" href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Closing%20the%20books%20in%203%20days&dates=20261022T170000Z/20261022T174500Z" target="_blank" rel="noopener">Google Calendar</a>
          <a class="btn btn-secondary" href="https://outlook.live.com/calendar/0/deeplink/compose?subject=Closing%20the%20books%20in%203%20days&startdt=2026-10-22T17:00:00Z&enddt=2026-10-22T17:45:00Z" target="_blank" rel="noopener">Outlook</a>
          <a class="btn btn-secondary" href="/webinars/closing-the-books.ics" download>Apple / .ics</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .webinar [hidden] {
    display: none !important;
  }

  .webinar__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .webinar__when {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-weight: 600;
  }

  .webinar__when svg {
    color: var(--brand);
  }

  .webinar__info h3 {
    margin-top: 1.75rem;
    font-size: 1rem;
  }

  .webinar__takeaways {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .webinar__takeaways li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--ink-2);
  }

  .webinar__takeaways li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 1rem;
    height: 0.55rem;
    border-left: 2px solid var(--success);
    border-bottom: 2px solid var(--success);
    transform: rotate(-45deg);
  }

  .webinar__speakers {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .webinar__speakers li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .webinar__speakers img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
  }

  .webinar__speakers strong {
    display: block;
  }

  .webinar__speakers span {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .webinar__panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }

  .webinar__form {
    display: grid;
    gap: 1rem;
  }

  .webinar__form h3 {
    margin: 0;
  }

  .webinar__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .webinar__fine {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .webinar__confirm p {
    color: var(--ink-2);
  }

  .webinar__cal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 860px) {
    .webinar__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("webinar-registration");
    if (!root) return;
    const form = root.querySelector("form");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      root.querySelector(".webinar__confirm").hidden = false;
    });
  })();
</script>
