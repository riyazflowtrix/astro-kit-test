---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="webinar-registration" class="section section--muted webinar" data-variant="split" data-stage="upcoming" data-starts-at="2026-10-22T13:00:00-04:00" data-minutes="45" data-campaign="701Hp00000ClOse3D">
  <!-- kit: webinar-registration -->
  <div class="container webinar__grid">
    <div class="webinar__info">
      <span class="eyebrow">Live webinar</span>
      <h2>Closing the books in 3 days, without the overtime</h2>
      <p class="lead">Northbeam's controller walks through the exact checklist, bank rules and review cadence that cut their close from 11 days to 3.</p>

      <p class="webinar__when">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
        <time datetime="2026-10-22T13:00:00-04:00">Thursday 22 October 2026, 1:00pm ET</time> · 45 minutes
      </p>

      <h3>What you'll learn</h3>
      <ul class="webinar__takeaways">
        <li>The 40-item close checklist, trimmed to 18</li>
        <li>Bank rules that match 92% of transactions</li>
        <li>How to run review without a war room</li>
        <li>Live Q&amp;A</li>
      </ul>

      <h3>Speakers</h3>
      <ul class="webinar__speakers">
        <li>
          <img src="https://picsum.photos/seed/ledgerline-dana-whitfield/240/240" alt="Portrait of Dana Whitfield" width="240" height="240" loading="lazy" />
          <div><strong>Dana Whitfield</strong><span>Controller, Northbeam</span></div>
        </li>
        <li>
          <img src="https://picsum.photos/seed/ledgerline-priya-raman/240/240" alt="Portrait of Priya Raman" width="240" height="240" loading="lazy" />
          <div><strong>Priya Raman</strong><span>Head of Customer Finance, Ledgerline</span></div>
        </li>
      </ul>
    </div>

    <div class="webinar__panel card">
      <form class="webinar__form" action={bcmsFormAction("Save your seat")} method={bcmsFormMethod("Save your seat")} data-form="form_webinar-registration" data-bcms-form={bcmsFormId("Save your seat")} data-bcms-form-success="Thank you for your submission!">
        <h3>Save your seat</h3>
        <div class="webinar__two">
          <div class="field" data-bcms-form-field="first_name">
            <label for="wb-first" data-bcms-form-part="label">First name</label>
            <input id="wb-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field" data-bcms-form-field="last_name">
            <label for="wb-last" data-bcms-form-part="label">Last name</label>
            <input id="wb-last" name="last_name" type="text" autocomplete="family-name" required />
          </div>
        </div>
        <div class="field" data-bcms-form-field="email">
          <label for="wb-email" data-bcms-form-part="label">Work email</label>
          <input id="wb-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field" data-bcms-form-field="company">
          <label for="wb-company" data-bcms-form-part="label">Company</label>
          <input id="wb-company" name="company" type="text" autocomplete="organization" required />
        </div>
        <div class="field" data-bcms-form-field="role">
          <label for="wb-role" data-bcms-form-part="label">Role</label>
          <select id="wb-role" name="role">
            <option>Controller</option>
            <option>CFO / VP Finance</option>
            <option>Accountant</option>
            <option>Other</option>
          </select>
        </div>
        <input type="hidden" name="campaign" value="701Hp00000ClOse3D" data-bcms-form-field="campaign" />
        <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Register for free</button>
        <p class="webinar__fine">Can't make it live? Register anyway and we'll send the recording.</p>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

      <div class="webinar__confirm" role="status" hidden>
        <h3>You're in</h3>
        <p>We've emailed your join link. We'll send the recording to the same address, even if you can't make it live.</p>
        <div class="webinar__cal">
          <a class="btn btn-secondary" href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Closing%20the%20books%20in%203%20days&dates=20261022T170000Z/20261022T174500Z" target="_blank" rel="noopener">Google Calendar</a>
          <a class="btn btn-secondary" href="https://outlook.live.com/calendar/0/deeplink/compose?subject=Closing%20the%20books%20in%203%20days&startdt=2026-10-22T17:00:00Z&enddt=2026-10-22T17:45:00Z" target="_blank" rel="noopener">Outlook</a>
          <a class="btn btn-secondary" href="/webinars/closing-the-books.ics" download>Apple / .ics</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .webinar [hidden] {
    display: none !important;
  }

  .webinar__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .webinar__when {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-weight: 600;
  }

  .webinar__when svg {
    color: var(--brand);
  }

  .webinar__info h3 {
    margin-top: 1.75rem;
    font-size: 1rem;
  }

  .webinar__takeaways {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .webinar__takeaways li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--ink-2);
  }

  .webinar__takeaways li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 1rem;
    height: 0.55rem;
    border-left: 2px solid var(--success);
    border-bottom: 2px solid var(--success);
    transform: rotate(-45deg);
  }

  .webinar__speakers {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .webinar__speakers li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .webinar__speakers img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
  }

  .webinar__speakers strong {
    display: block;
  }

  .webinar__speakers span {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .webinar__panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }

  .webinar__form {
    display: grid;
    gap: 1rem;
  }

  .webinar__form h3 {
    margin: 0;
  }

  .webinar__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .webinar__fine {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .webinar__confirm p {
    color: var(--ink-2);
  }

  .webinar__cal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 860px) {
    .webinar__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("webinar-registration");
    if (!root) return;
    const form = root.querySelector("form");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      root.querySelector(".webinar__confirm").hidden = false;
    });
  })();
</script>
