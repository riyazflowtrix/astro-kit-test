---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="events-list" class="section events" data-variant="list" data-show="both" data-time-display="event">
  <!-- kit: events-list -->
  <div class="container">
    <div class="section-head">
      <h2>Workshops &amp; cookouts</h2>
      <p class="lead">Learn to cook over fire with the people who make the pans. Small groups, all gear provided.</p>
    </div>

    <form class="events__filters" action={bcmsFormAction("Filter events")} aria-label="Filter events" method={bcmsFormMethod("Filter events")} data-bcms-form={bcmsFormId("Filter events")} data-bcms-form-success="Thank you for your submission!">
      <div class="field" data-bcms-form-field="type">
        <label for="ev-type" data-bcms-form-part="label">Type</label>
        <select id="ev-type" name="type">
          <option value="">All types</option>
          <option value="workshop">Workshop</option>
          <option value="cookout">Cookout</option>
          <option value="online">Online class</option>
        </select>
      </div>
      <div class="field" data-bcms-form-field="location">
        <label for="ev-location" data-bcms-form-part="label">Location</label>
        <select id="ev-location" name="location">
          <option value="">All locations</option>
          <option value="bend">Bend, OR</option>
          <option value="portland">Portland, OR</option>
          <option value="online">Online</option>
        </select>
      </div>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

    <h3 class="events__group">Upcoming</h3>
    <ol class="events__list" data-list="upcoming">
      <li class="events__item" data-type="workshop" data-location="bend">
        <time class="events__badge" datetime="2026-11-14T10:00:00-08:00"><span>Nov</span><strong>14</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Workshop</span> Sat 14 Nov · 10:00am–1:00pm PT</p>
          <h4><a href="/events/cast-iron-101">Cast iron 101: seasoning and searing</a></h4>
          <p>Strip, season and cook on your first pan with our foundry team. Take the skillet home.</p>
          <p class="events__where">Caldera Workshop, Bend, OR</p>
        </div>
        <div class="events__cta">
          <p class="events__price">$65</p>
          <a class="btn btn-primary" href="/events/cast-iron-101">Book a place</a>
        </div>
      </li>
      <li class="events__item" data-type="workshop" data-location="bend">
        <time class="events__badge" datetime="2026-12-05T11:00:00-08:00"><span>Dec</span><strong>5</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Workshop</span> Sat 5 Dec · 11:00am–3:00pm PT</p>
          <h4><a href="/events/dutch-oven-bread">Dutch oven bread over coals</a></h4>
          <p>Sourdough and skillet cornbread baked on a bed of coals, with a long lunch to follow.</p>
          <p class="events__where">Caldera Workshop, Bend, OR</p>
        </div>
        <div class="events__cta">
          <p class="events__price">$85</p>
          <a class="btn btn-primary" href="/events/dutch-oven-bread">Book a place</a>
        </div>
      </li>
      <li class="events__item" data-type="cookout" data-location="portland">
        <time class="events__badge" datetime="2027-01-17T17:30:00-08:00"><span>Jan</span><strong>17</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Cookout</span> Sun 17 Jan · 5:30pm–9:00pm PT</p>
          <h4><a href="/events/live-fire-supper">Live-fire supper with Hearth &amp; Ash</a></h4>
          <p>Chef Amara Osei cooks a five-course winter supper over four Ember ovens.</p>
          <p class="events__where">Hearth &amp; Ash, Portland, OR</p>
        </div>
        <div class="events__cta">
          <p class="events__price">$140</p>
          <a class="btn btn-primary" href="/events/live-fire-supper">Book a place</a>
        </div>
      </li>
      <li class="events__item" data-type="online" data-location="online">
        <time class="events__badge" datetime="2027-02-03T18:00:00-08:00"><span>Feb</span><strong>3</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Online class</span> Wed 3 Feb · 6:00pm–7:00pm PT</p>
          <h4><a href="/events/restoring-rusty-skillet">Restoring a rusty skillet</a></h4>
          <p>A live session on bringing a flea-market pan back to life. Bring your questions.</p>
          <p class="events__where">Online · Live on YouTube</p>
        </div>
        <div class="events__cta">
          <p class="events__price">Free</p>
          <a class="btn btn-secondary" href="/events/restoring-rusty-skillet">Register</a>
        </div>
      </li>
    </ol>

    <div class="events__empty" hidden>
      <h4>Nothing on the calendar yet</h4>
      <a class="btn btn-secondary" href="/newsletter" title="Newsletter">Get event emails</a>
    </div>

    <h3 class="events__group">Past events</h3>
    <ol class="events__list events__list--past" data-list="past">
      <li class="events__item" data-type="cookout" data-location="bend">
        <time class="events__badge" datetime="2026-09-20T08:00:00-07:00"><span>Sep</span><strong>20</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Cookout</span> Sun 20 Sep · 8:00am PT</p>
          <h4>Campfire breakfast cookout</h4>
          <p class="events__where">Tumalo State Park, Bend, OR</p>
        </div>
        <div class="events__cta">
          <a class="btn btn-secondary" href="/journal/campfire-breakfast-recap">Read the recap</a>
        </div>
      </li>
      <li class="events__item" data-type="online" data-location="online">
        <time class="events__badge" datetime="2026-08-12T18:00:00-07:00"><span>Aug</span><strong>12</strong></time>
        <div class="events__body">
          <p class="events__meta"><span class="badge">Online class</span> Wed 12 Aug · 6:00pm PT</p>
          <h4>Seasoning myths, tested</h4>
          <p class="events__where">Online</p>
        </div>
        <div class="events__cta">
          <a class="btn btn-secondary" href="https://www.youtube.com/watch?v=caldera-seasoning-myths" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
            Watch the recording
          </a>
        </div>
      </li>
    </ol>
    <p class="events__tz">Times are shown in each event's local time zone.</p>
  </div>
</section>

<style>
  .events [hidden] {
    display: none !important;
  }

  .events__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .events__filters .field {
    flex: 1 1 200px;
    max-width: 260px;
  }

  .events__group {
    margin: 2rem 0 1rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .events__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events__item {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .events__badge {
    display: grid;
    justify-items: center;
    padding: 0.6rem 0;
    border-radius: var(--radius);
    background: var(--brand-soft);
    color: var(--brand);
  }

  .events__badge span {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .events__badge strong {
    font-size: 1.75rem;
    line-height: 1;
  }

  .events__list--past .events__badge {
    background: var(--surface);
    color: var(--ink-3);
  }

  .events__body h4 {
    margin: 0.25rem 0;
    font-size: 1.125rem;
  }

  .events__body h4 a {
    text-decoration: none;
  }

  .events__body h4 a:hover {
    text-decoration: underline;
  }

  .events__body p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .events__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem !important;
  }

  .events__where {
    margin-top: 0.35rem !important;
    font-size: 0.8125rem !important;
    color: var(--ink-3) !important;
  }

  .events__cta {
    display: grid;
    justify-items: end;
    gap: 0.4rem;
  }

  .events__price {
    margin: 0;
    font-weight: 700;
  }

  .events__empty {
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    text-align: center;
  }

  .events__tz {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (max-width: 680px) {
    .events__item {
      grid-template-columns: 60px 1fr;
    }

    .events__cta {
      grid-column: 1 / -1;
      justify-items: start;
      grid-auto-flow: column;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("events-list");
    if (!root) return;
    const form = root.querySelector(".events__filters");
    const upcoming = root.querySelector('[data-list="upcoming"]');
    const empty = root.querySelector(".events__empty");
    const apply = () => {
      const type = form.elements.namedItem("type").value;
      const loc = form.elements.namedItem("location").value;
      root.querySelectorAll(".events__item").forEach((li) => {
        li.hidden = (type && li.dataset.type !== type) || (loc && li.dataset.location !== loc);
      });
      empty.hidden = !!upcoming.querySelector(".events__item:not([hidden])");
    };
    form.addEventListener("change", apply);
  })();
</script>
