---
---

<section id="restaurant-menu" class="section menu" data-variant="tabs" data-currency="USD" data-show-photos="false">
  <!-- kit: restaurant-menu -->
  <div class="container menu__wrap">
    <div class="section-head section-head--center">
      <span class="eyebrow">Fiamma Mission</span>
      <h2>Menu</h2>
    </div>

    <div class="menu__tabs" role="tablist" aria-label="Menus">
      <button type="button" role="tab" id="menu-tab-dinner" aria-controls="menu-panel-dinner" aria-selected="true">Dinner</button>
      <button type="button" role="tab" id="menu-tab-wine" aria-controls="menu-panel-wine" aria-selected="false" tabindex="-1">Wine</button>
    </div>

    <div class="menu__panel" role="tabpanel" id="menu-panel-dinner" aria-labelledby="menu-tab-dinner">
      <p class="menu__served">Served 17:00–22:00 · Kitchen closes 30 minutes before the restaurant.</p>

      <div class="menu__section">
        <h3>Antipasti</h3>
        <ul class="menu__items">
          <li class="menu__item is-signature">
            <div class="menu__line">
              <h4>Burrata <span class="menu__sig" title="House signature">★ Signature</span></h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price">$19</p>
            </div>
            <p class="menu__desc">charred stone fruit, basil, aged balsamic, wood-fired bread</p>
            <p class="menu__tags"><abbr class="menu__tag" title="Vegetarian">V</abbr> <span class="menu__allergens">Contains dairy, gluten</span></p>
          </li>
          <li class="menu__item">
            <div class="menu__line">
              <h4>Calamari alla griglia</h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price">$18</p>
            </div>
            <p class="menu__desc">Calabrian chilli, lemon, parsley</p>
            <p class="menu__tags"><abbr class="menu__tag" title="Gluten-free">GF</abbr> <abbr class="menu__tag" title="Dairy-free">DF</abbr> <span class="menu__spice" title="Spicy, 2 of 3" aria-label="Spicy, 2 of 3">🌶🌶</span> <span class="menu__allergens">Contains shellfish</span></p>
          </li>
        </ul>
      </div>

      <div class="menu__section">
        <h3>Pizze</h3>
        <p class="menu__section-desc">48-hour dough, baked at 480°C in our wood oven.</p>
        <ul class="menu__items">
          <li class="menu__item">
            <div class="menu__line">
              <h4>Margherita</h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price">$17</p>
            </div>
            <p class="menu__desc">San Marzano, fior di latte, basil, olive oil</p>
            <p class="menu__tags"><abbr class="menu__tag" title="Vegetarian">V</abbr> <span class="menu__allergens">Contains gluten, dairy</span></p>
          </li>
          <li class="menu__item is-unavailable">
            <div class="menu__line">
              <h4>Diavola <span class="menu__out">Sold out tonight</span></h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price">$21</p>
            </div>
            <p class="menu__desc">spicy salami, fior di latte, hot honey</p>
            <p class="menu__tags"><span class="menu__spice" title="Spicy, 2 of 3" aria-label="Spicy, 2 of 3">🌶🌶</span> <span class="menu__allergens">Contains gluten, dairy</span></p>
          </li>
        </ul>
      </div>

      <div class="menu__section">
        <h3>Pesce</h3>
        <ul class="menu__items">
          <li class="menu__item">
            <div class="menu__line">
              <h4>Whole branzino</h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price">Market price</p>
            </div>
            <p class="menu__desc">salsa verde, roasted fennel</p>
            <p class="menu__tags"><abbr class="menu__tag" title="Gluten-free">GF</abbr> <abbr class="menu__tag" title="Dairy-free">DF</abbr> <span class="menu__allergens">Contains fish</span></p>
          </li>
        </ul>
      </div>
    </div>

    <div class="menu__panel" role="tabpanel" id="menu-panel-wine" aria-labelledby="menu-tab-wine" hidden>
      <p class="menu__served">Served 12:00–23:00</p>
      <div class="menu__section">
        <h3>Rosso</h3>
        <ul class="menu__items">
          <li class="menu__item">
            <div class="menu__line">
              <h4>Nebbiolo, G.D. Vajra 2022</h4>
              <span class="menu__dots" aria-hidden="true"></span>
              <p class="menu__price menu__variants"><span>Glass $17</span> <span>Bottle $68</span></p>
            </div>
            <p class="menu__desc">Piedmont · rose petal, red cherry, fine tannin</p>
            <p class="menu__tags"><abbr class="menu__tag" title="Vegan">VG</abbr></p>
          </li>
        </ul>
      </div>
    </div>

    <div class="menu__foot">
      <dl class="menu__legend">
        <div><dt><abbr class="menu__tag" title="Vegetarian">V</abbr></dt><dd>Vegetarian</dd></div>
        <div><dt><abbr class="menu__tag" title="Vegan">VG</abbr></dt><dd>Vegan</dd></div>
        <div><dt><abbr class="menu__tag" title="Gluten-free">GF</abbr></dt><dd>Gluten-free</dd></div>
        <div><dt><abbr class="menu__tag" title="Dairy-free">DF</abbr></dt><dd>Dairy-free</dd></div>
        <div><dt><span aria-hidden="true">🌶</span></dt><dd>Spicy</dd></div>
      </dl>
      <p class="menu__footnote">Please tell your server about any allergies. A 20% service charge is added to parties of 6 or more and goes entirely to our staff.</p>
      <a class="btn btn-secondary" href="https://fiamma.co/media/menus/fiamma-mission-dinner-oct-2026.pdf" download="fiamma-mission-dinner-oct-2026.pdf">Download the menu (PDF, 412 KB)</a>
    </div>
  </div>
</section>

<style>
  .menu [hidden] {
    display: none !important;
  }

  .menu__wrap {
    max-width: 820px;
  }

  .menu__tabs {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 2rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--surface);
    width: fit-content;
    margin-inline: auto;
  }

  .menu__tabs button {
    min-height: 40px;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }

  .menu__tabs button[aria-selected="true"] {
    background: var(--ink);
    color: #fff;
  }

  .menu__served {
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .menu__section {
    margin-top: 2.5rem;
  }

  .menu__section h3 {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--ink);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu__section-desc {
    font-style: italic;
    color: var(--ink-2);
  }

  .menu__items {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .menu__line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .menu__line h4 {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .menu__dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--ink-3);
    transform: translateY(-4px);
  }

  .menu__price {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }

  .menu__variants {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .menu__desc {
    margin: 0.2rem 0 0.35rem;
    color: var(--ink-2);
  }

  .menu__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }

  .menu__tag {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 20px;
    padding: 0 0.3rem;
    border: 1px solid var(--success);
    border-radius: 4px;
    color: var(--success);
    font-size: 0.6875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .menu__spice {
    font-size: 0.8125rem;
  }

  .menu__allergens {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .menu__sig {
    margin-left: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand);
  }

  .menu__out {
    margin-left: 0.4rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--surface-2);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .is-unavailable h4,
  .is-unavailable .menu__price,
  .is-unavailable .menu__desc {
    color: var(--ink-3);
  }

  .is-unavailable h4 {
    text-decoration: line-through;
    text-decoration-color: var(--ink-3);
  }

  .menu__foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .menu__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .menu__legend div {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .menu__legend dd {
    margin: 0;
  }

  .menu__footnote {
    max-width: 60ch;
    margin-inline: auto;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  @media (max-width: 480px) {
    .menu__line {
      flex-wrap: wrap;
    }

    .menu__dots {
      display: none;
    }

    .menu__price {
      width: 100%;
    }

    .menu__variants {
      justify-content: flex-start;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("restaurant-menu");
    if (!root) return;
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const activate = (tab) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector("#" + t.getAttribute("aria-controls")).hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const n = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[n]);
        tabs[n].focus();
      });
    });
  })();
</script>
