---
---

<section id="event-detail" class="section event" data-status="scheduled" data-attendance="hybrid" data-timezone="America/Los_Angeles">
  <!-- kit: event-detail -->
  <header class="event__hero">
    <img class="event__cover" src="https://picsum.photos/seed/signal-summit-stage/1600/1000" alt="A packed auditorium facing a stage lit in teal, a speaker mid-talk" width="3200" height="2000" />
    <div class="event__hero-overlay"></div>
    <div class="container event__hero-inner">
      <p class="event__status"><span class="badge">Scheduled</span> Hybrid · San Francisco &amp; online</p>
      <h1>Signal Summit 2027</h1>
      <p class="event__tagline">Two days on building and scaling real-time products.</p>
      <p class="event__dates">
        <time datetime="2027-04-14T09:00:00-07:00">14</time>–<time datetime="2027-04-15T18:00:00-07:00">15 April 2027</time> · 9:00am–6:00pm PT
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#event-tickets">Get tickets</a>
        <a class="btn btn-secondary event__hero-btn" href="#event-schedule">See the schedule</a>
      </div>
    </div>
  </header>

  <section class="section event__about">
    <div class="container event__about-grid">
      <div>
        <span class="eyebrow">About</span>
        <div class="event__prose">
          <p>Signal Summit brings 1,200 engineers and product leaders to San Francisco for two days of talks, workshops and hallway conversations about real-time systems.</p>
        </div>
      </div>
      <div>
        <h2 class="event__h3">Featured speakers</h2>
        <ul class="event__speakers">
          <li>
            <img src="https://picsum.photos/seed/signal-speaker-kelsey/240/240" alt="Portrait of Kelsey Hart" width="240" height="240" loading="lazy" />
            <div><strong>Kelsey Hart</strong><span>Principal Engineer, Cloudline</span></div>
          </li>
          <li>
            <img src="https://picsum.photos/seed/signal-speaker-mira/240/240" alt="Portrait of Mira Tanaka" width="240" height="240" loading="lazy" />
            <div><strong>Mira Tanaka</strong><span>VP Engineering, Relay</span></div>
          </li>
          <li>
            <img src="https://picsum.photos/seed/signal-speaker-dev/240/240" alt="Portrait of Dev Patel" width="240" height="240" loading="lazy" />
            <div><strong>Dev Patel</strong><span>Staff Engineer, Quill Docs</span></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--muted" id="event-schedule">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Schedule</span>
        <h2>Two days, one stage, plenty of hallway</h2>
      </div>
      <div class="event__days" role="tablist" aria-label="Conference days">
        <button type="button" role="tab" id="event-day-1" aria-controls="event-panel-1" aria-selected="true">Day 1 · Build <span>Wed 14 Apr</span></button>
        <button type="button" role="tab" id="event-day-2" aria-controls="event-panel-2" aria-selected="false" tabindex="-1">Day 2 · Scale <span>Thu 15 Apr</span></button>
      </div>

      <div role="tabpanel" id="event-panel-1" aria-labelledby="event-day-1" data-date="2027-04-14">
        <ol class="event__sessions">
          <li class="event__session is-break" data-format="meal">
            <p class="event__time">08:00–09:00</p>
            <div><h3>Registration &amp; breakfast</h3><p class="event__room">Lobby</p></div>
          </li>
          <li class="event__session" data-format="keynote">
            <p class="event__time">09:00–09:45</p>
            <div>
              <p class="event__tags"><span class="badge">Keynote</span></p>
              <h3>The latency budget nobody wrote down</h3>
              <p class="event__by">Mira Tanaka</p>
              <p>Every real-time product has a latency budget. Most teams discover theirs in an incident review.</p>
              <p class="event__room">Main stage</p>
            </div>
          </li>
          <li class="event__session" data-format="talk" data-track="build">
            <p class="event__time">10:00–10:40</p>
            <div>
              <p class="event__tags"><span class="badge">Talk</span> <span class="event__chip">Build track</span> <span class="event__chip">Advanced</span></p>
              <h3>CRDTs in production: three years in</h3>
              <p class="event__by">Dev Patel</p>
              <p>What we got wrong about merge semantics, and what we'd do again.</p>
              <p class="event__room">Hall B</p>
            </div>
          </li>
          <li class="event__session" data-format="workshop" data-track="build">
            <p class="event__time">10:00–12:00</p>
            <div>
              <p class="event__tags"><span class="badge">Workshop</span> <span class="event__chip">Build track</span> <span class="event__chip">Intermediate</span> <span class="event__chip">60 seats</span></p>
              <h3>Hands-on: a presence layer in 90 minutes</h3>
              <p class="event__by">Ana Silva, Tom Ruiz</p>
              <p class="event__room">Workshop 1</p>
            </div>
          </li>
          <li class="event__session is-break" data-format="meal">
            <p class="event__time">12:00–13:00</p>
            <div><h3>Lunch</h3><p class="event__room">Terrace</p></div>
          </li>
        </ol>
      </div>
      <div role="tabpanel" id="event-panel-2" aria-labelledby="event-day-2" data-date="2027-04-15" hidden>
        <ol class="event__sessions">
          <li class="event__session" data-format="panel" data-track="main">
            <p class="event__time">09:30–10:15</p>
            <div>
              <p class="event__tags"><span class="badge">Panel</span> <span class="event__chip">Main track</span></p>
              <h3>Panel: When to stop self-hosting</h3>
              <p class="event__by">Kelsey Hart, Mira Tanaka, Lena Fischer</p>
              <p class="event__room">Main stage</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container event__attend">
      <div class="event__venue card">
        <span class="eyebrow">In person</span>
        <h2 class="event__h3">SF Masonic Auditorium</h2>
        <address>1111 California St<br />San Francisco, CA 94108</address>
        <div class="event__prose">
          <p>Enter on California Street. BART to Montgomery, then the 1 bus. A hotel block at the Fairmont holds rates until March 15.</p>
        </div>
      </div>
      <div class="event__stream card">
        <span class="eyebrow">Online</span>
        <h2 class="event__h3">Watch the live stream</h2>
        <p>Every main-stage session streams live on YouTube, with recordings the same evening.</p>
        <a class="btn btn-secondary" href="https://www.youtube.com/live/signalsummit2027" target="_blank" rel="noopener">Open the stream on YouTube</a>
      </div>
    </div>
  </section>

  <section class="section section--muted" id="event-tickets">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Tickets</span>
        <h2>Pick your pass</h2>
      </div>
      <div class="event__tiers">
        <div class="event__tier card is-soldout">
          <h3>Early bird</h3>
          <p class="event__price">$499</p>
          <p class="event__window">Sales ended 31 January 2027</p>
          <ul>
            <li>Both days</li>
            <li>Workshops (first come)</li>
            <li>Recordings</li>
          </ul>
          <span class="btn btn-secondary" aria-disabled="true">Sold out</span>
        </div>
        <div class="event__tier card is-highlight">
          <span class="badge">Most popular</span>
          <h3>General</h3>
          <p class="event__price">$749</p>
          <p class="event__window">On sale from 1 February 2027</p>
          <ul>
            <li>Both days</li>
            <li>Workshops (first come)</li>
            <li>Recordings</li>
          </ul>
          <a class="btn btn-primary" href="https://tickets.signalsummit.com/2027/general">Get tickets</a>
        </div>
        <div class="event__tier card">
          <h3>Online</h3>
          <p class="event__price">Free</p>
          <p class="event__window">On sale now</p>
          <ul>
            <li>Live stream</li>
            <li>Recordings</li>
          </ul>
          <a class="btn btn-secondary" href="/2027/register-online">Register free</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Signal Summit 2027",
      "description": "Two days on building and scaling real-time products.",
      "startDate": "2027-04-14T09:00:00-07:00",
      "endDate": "2027-04-15T18:00:00-07:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
      "image": "https://picsum.photos/seed/signal-summit-stage/1600/1000",
      "location": [
        {
          "@type": "Place",
          "name": "SF Masonic Auditorium",
          "address": { "@type": "PostalAddress", "streetAddress": "1111 California St", "addressLocality": "San Francisco", "addressRegion": "CA", "postalCode": "94108", "addressCountry": "US" }
        },
        { "@type": "VirtualLocation", "url": "https://www.youtube.com/live/signalsummit2027" }
      ],
      "offers": [
        { "@type": "Offer", "name": "Early bird", "price": 499, "priceCurrency": "USD", "availability": "https://schema.org/SoldOut" },
        { "@type": "Offer", "name": "General", "price": 749, "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://tickets.signalsummit.com/2027/general" },
        { "@type": "Offer", "name": "Online", "price": 0, "priceCurrency": "USD", "availability": "https://schema.org/InStock" }
      ]
    }
  </script>
</section>

<style>
  .event [hidden] {
    display: none !important;
  }

  .event.section {
    padding-block: 0;
  }

  .event__hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(80px, 12vw, 160px) clamp(48px, 8vw, 96px);
    color: #fff;
    overflow: hidden;
  }

  .event__cover {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event__hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(8 20 24 / 0.35), rgb(8 20 24 / 0.85));
  }

  .event__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .event__status .badge {
    background: #12b5a6;
    color: #fff;
  }

  .event__tagline {
    max-width: 40ch;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    opacity: 0.9;
  }

  .event__dates {
    font-weight: 600;
    margin-bottom: 1.75rem;
  }

  .event__hero-btn {
    color: #fff;
    border-color: rgb(255 255 255 / 0.5);
  }

  .event__about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .event__prose {
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .event__h3 {
    font-size: 1.25rem;
  }

  .event__speakers {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event__speakers li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .event__speakers img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .event__speakers strong {
    display: block;
  }

  .event__speakers span {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .event__days {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .event__days button {
    display: grid;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    font: inherit;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .event__days button span {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-3);
  }

  .event__days button[aria-selected="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  .event__days button[aria-selected="true"] span {
    color: rgb(255 255 255 / 0.7);
  }

  .event__sessions {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event__session {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line);
  }

  .event__session.is-break {
    background: transparent;
    border-style: dashed;
  }

  .event__session h3 {
    margin: 0.2rem 0;
    font-size: 1.0625rem;
  }

  .event__session p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .event__time {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink) !important;
  }

  .event__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .event__chip {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event__by {
    font-weight: 600;
    color: var(--ink) !important;
  }

  .event__room {
    margin-top: 0.35rem !important;
    font-size: 0.8125rem !important;
    color: var(--ink-3) !important;
  }

  .event__attend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .event__venue,
  .event__stream {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .event__venue address {
    font-style: normal;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .event__venue .event__prose {
    font-size: 1rem;
  }

  .event__stream p {
    color: var(--ink-2);
  }

  .event__tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .event__tier {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.75rem;
  }

  .event__tier .badge {
    align-self: flex-start;
  }

  .event__tier.is-highlight {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .event__tier.is-soldout {
    opacity: 0.6;
  }

  .event__tier h3 {
    margin: 0.25rem 0 0;
  }

  .event__price {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .event__window {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .event__tier ul {
    flex: 1;
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }

  @media (max-width: 820px) {
    .event__about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .event__session {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("event-detail");
    if (!root) return;
    const tabs = [...root.querySelectorAll('.event__days [role="tab"]')];
    const activate = (tab) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector("#" + t.getAttribute("aria-controls")).hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const n = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[n]);
        tabs[n].focus();
      });
    });
  })();
</script>
