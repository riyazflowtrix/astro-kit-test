---
---

<section id="conversion-cta-band" class="section cta-band cta-band--split" data-variant="split" data-background="photo" data-theme="dark">
  <!-- kit: conversion-cta-band -->
  <div class="cta-band__bg" aria-hidden="true">
    <img
      src="https://picsum.photos/seed/caldera-cta-campfire-wide/2400/1000"
      alt="A campfire at dusk with a pine forest behind"
      width="2400"
      height="1000"
      loading="lazy"
    />
    <div class="cta-band__overlay" style="--overlay: 0.45"></div>
  </div>

  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <span class="eyebrow">Lifetime warranty</span>
      <h2>Cook on it for 60 days. Keep it for life.</h2>
      <p class="lead">If it isn't the best pan you own, send it back — seasoning and all.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/products" title="Shop">
          Shop cookware
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn-secondary cta-band__outline" href="/warranty">Read the warranty</a>
      </div>
    </div>
    <figure class="cta-band__media">
      <img
        src="https://picsum.photos/seed/caldera-cta-skillet-eggs/1400/1050"
        alt="Eggs frying in a cast iron skillet on a camp stove at sunrise"
        width="1400"
        height="1050"
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #1e1b18;
    color: var(--dark-ink);
  }

  .cta-band__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-band__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-band__overlay {
    position: absolute;
    inset: 0;
    background: rgb(20 17 15 / var(--overlay));
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cta-band__copy h2 {
    color: #fff;
  }

  .cta-band__copy .eyebrow {
    color: #f3b19f;
  }

  .cta-band__copy .lead {
    color: rgb(255 255 255 / 0.82);
    margin-bottom: 1.75rem;
  }

  .cta-band__outline {
    border-color: rgb(255 255 255 / 0.5);
    color: #fff;
  }

  .cta-band__outline:hover {
    border-color: #fff;
  }

  .cta-band__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
  }

  .cta-band__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
