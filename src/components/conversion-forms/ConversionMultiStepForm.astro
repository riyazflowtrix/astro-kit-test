---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="conversion-multi-step-form" class="section section--muted msf" data-progress="steps">
  <!-- kit: conversion-multi-step-form -->
  <div class="container msf__wrap">
    <div class="section-head section-head--center">
      <h2>Book your first visit</h2>
      <p class="lead">Three short steps, about two minutes. Your physio reads this before you arrive, so the first session is all treatment.</p>
    </div>

    <div class="msf__card card">
      <ol class="msf__progress" aria-label="Progress">
        <li class="is-current" aria-current="step"><span>1</span> About you</li>
        <li><span>2</span> What brings you in</li>
        <li><span>3</span> Paying for care</li>
      </ol>

      <form class="msf__form" action={bcmsFormAction("Book your first visit")} method={bcmsFormMethod("Book your first visit")} data-form="form_contact" novalidate data-bcms-form={bcmsFormId("Book your first visit")} data-bcms-form-success="Thank you for your submission!">
        <fieldset class="msf__step" data-step="1">
          <legend>About you</legend>
          <p class="msf__desc">So we can confirm your appointment.</p>
          <div class="msf__grid">
            <div class="field" data-bcms-form-field="full_name">
              <label for="msf-full_name" data-bcms-form-part="label">Full name</label>
              <input id="msf-full_name" name="full_name" type="text" autocomplete="name" required />
            </div>
            <div class="field" data-bcms-form-field="email">
              <label for="msf-email" data-bcms-form-part="label">Email</label>
              <input id="msf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field" data-bcms-form-field="phone">
              <label for="msf-phone" data-bcms-form-part="label">Mobile number</label>
              <input id="msf-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
            <div class="field" data-bcms-form-field="date_of_birth">
              <label for="msf-dob" data-bcms-form-part="label">Date of birth</label>
              <input id="msf-dob" name="date_of_birth" type="date" autocomplete="bday" required />
            </div>
          </div>
        </fieldset>

        <fieldset class="msf__step" data-step="2" hidden>
          <legend>What brings you in</legend>
          <fieldset class="msf__group">
            <legend>Where does it hurt?</legend>
            <div class="msf__options">
              <label class="msf__option" data-bcms-form-field="area"><input type="checkbox" name="area" value="neck" /> Neck</label>
              <label class="msf__option"><input type="checkbox" name="area" value="shoulder" /> Shoulder</label>
              <label class="msf__option"><input type="checkbox" name="area" value="lower-back" /> Lower back</label>
              <label class="msf__option"><input type="checkbox" name="area" value="hip" /> Hip</label>
              <label class="msf__option"><input type="checkbox" name="area" value="knee" /> Knee</label>
              <label class="msf__option"><input type="checkbox" name="area" value="ankle-foot" /> Ankle or foot</label>
            </div>
          </fieldset>

          <div class="field msf__scale" data-bcms-form-field="pain_level">
            <label for="msf-pain" data-bcms-form-part="label">How bad is it on a typical day? <output for="msf-pain" class="msf__pain-value">5</output></label>
            <input id="msf-pain" name="pain_level" type="range" min="0" max="10" step="1" value="5" />
            <div class="msf__scale-labels"><span>No pain</span><span>Worst pain imaginable</span></div>
          </div>

          <fieldset class="msf__group">
            <legend>Have you had surgery for this?</legend>
            <div class="msf__options">
              <label class="msf__option" data-bcms-form-field="had_surgery"><input type="radio" name="had_surgery" value="yes" required /> Yes</label>
              <label class="msf__option"><input type="radio" name="had_surgery" value="no" /> No</label>
            </div>
          </fieldset>

          <div class="field" data-show-if="had_surgery" data-show-op="equals" data-show-value="yes" hidden data-bcms-form-field="surgery_date">
            <label for="msf-surgery_date" data-bcms-form-part="label">When was the surgery?</label>
            <input id="msf-surgery_date" name="surgery_date" type="date" required disabled />
          </div>
        </fieldset>

        <fieldset class="msf__step" data-step="3" hidden>
          <legend>Paying for care</legend>
          <div class="field" data-bcms-form-field="insurer">
            <label for="msf-insurer" data-bcms-form-part="label">How will you pay?</label>
            <select id="msf-insurer" name="insurer" required>
              <option value="">Choose one</option>
              <option value="aetna">Aetna</option>
              <option value="bcbs">Blue Cross Blue Shield</option>
              <option value="uhc">UnitedHealthcare</option>
              <option value="self-pay">Self-pay</option>
            </select>
          </div>
          <div class="field" data-show-if="insurer" data-show-op="not" data-show-value="self-pay" hidden data-bcms-form-field="member_id">
            <label for="msf-member_id" data-bcms-form-part="label">Member ID</label>
            <input id="msf-member_id" name="member_id" type="text" required disabled />
          </div>
          <label class="msf__consent" data-bcms-form-field="privacy_consent">
            <input type="checkbox" name="privacy_consent" required />
            <span>I've read the <a href="/privacy-practices">Notice of Privacy Practices</a> and agree to Juniper Physio storing this information for my care.</span>
          </label>
        </fieldset>

        <p class="msf__error" role="alert" hidden>Please fill in the required fields to continue.</p>

        <div class="msf__nav">
          <button type="button" class="btn btn-secondary" data-action="back" hidden>Back</button>
          <button type="button" class="btn btn-primary" data-action="next">Continue</button>
          <button type="submit" class="btn btn-primary" data-action="submit" hidden data-bcms-form-part="submit">Request appointment</button>
        </div>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

      <div class="msf__success" role="status" hidden>
        <p>Thanks — we'll text you within one business day with two appointment times to choose from.</p>
      </div>
    </div>
  </div>
</section>

<style>
  #conversion-multi-step-form [hidden] {
    display: none !important;
  }

  .msf__wrap {
    max-width: 760px;
  }

  .msf__card {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    box-shadow: var(--shadow);
  }

  .msf__progress {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .msf__progress li {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 3px solid var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .msf__progress li span {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 0.75rem;
  }

  .msf__progress li.is-current,
  .msf__progress li.is-done {
    border-color: var(--brand);
    color: var(--ink);
  }

  .msf__progress li.is-current span,
  .msf__progress li.is-done span {
    background: var(--brand);
    color: var(--brand-ink);
  }

  .msf__step {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .msf__step > legend {
    padding: 0;
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .msf__step[hidden],
  .msf__step [hidden] {
    display: none;
  }

  .msf__desc {
    margin: -0.75rem 0 0;
    color: var(--ink-2);
  }

  .msf__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .msf__group {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .msf__group legend {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .msf__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .msf__option {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .msf__option:has(input:checked) {
    border-color: var(--brand);
    background: var(--brand-soft);
  }

  .msf__scale input {
    min-height: auto;
    padding: 0;
    border: 0;
    accent-color: var(--brand);
  }

  .msf__pain-value {
    display: inline-block;
    min-width: 2ch;
    margin-left: 0.25rem;
    color: var(--brand);
  }

  .msf__scale-labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .msf__consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .msf__consent input {
    margin-top: 0.3rem;
  }

  .msf__error {
    margin: 1rem 0 0;
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .msf__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .msf__nav [hidden] {
    display: none;
  }

  .msf__success {
    padding: 1.25rem;
    border-radius: var(--radius);
    background: #e8f4ec;
    color: var(--success);
    font-weight: 500;
  }

  .msf__success p {
    margin: 0;
  }

  @media (max-width: 560px) {
    .msf__progress li {
      font-size: 0;
      gap: 0;
    }

    .msf__progress li span {
      font-size: 0.75rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("conversion-multi-step-form");
    if (!root) return;
    const form = root.querySelector("form");
    const steps = [...root.querySelectorAll(".msf__step")];
    const marks = [...root.querySelectorAll(".msf__progress li")];
    const back = root.querySelector('[data-action="back"]');
    const next = root.querySelector('[data-action="next"]');
    const submit = root.querySelector('[data-action="submit"]');
    const error = root.querySelector(".msf__error");
    const success = root.querySelector(".msf__success");
    const pain = root.querySelector("#msf-pain");
    const painOut = root.querySelector(".msf__pain-value");
    let current = 0;

    pain.addEventListener("input", () => (painOut.textContent = pain.value));

    const valueOf = (name) => {
      const el = form.elements.namedItem(name);
      if (!el) return "";
      return el.value || "";
    };

    const applyShowIf = () => {
      root.querySelectorAll("[data-show-if]").forEach((wrap) => {
        const v = valueOf(wrap.dataset.showIf);
        const show = wrap.dataset.showOp === "equals" ? v === wrap.dataset.showValue : v !== "" && v !== wrap.dataset.showValue;
        wrap.hidden = !show;
        wrap.querySelectorAll("input, select, textarea").forEach((i) => (i.disabled = !show));
      });
    };
    form.addEventListener("change", applyShowIf);

    const valid = () => {
      const step = steps[current];
      let ok = true;
      step.querySelectorAll("input, select, textarea").forEach((el) => {
        if (!el.disabled && !el.checkValidity()) ok = false;
      });
      if (current === 1 && !step.querySelector('input[name="area"]:checked')) ok = false;
      error.hidden = ok;
      return ok;
    };

    const show = (i) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      marks.forEach((m, n) => {
        m.classList.toggle("is-current", n === i);
        m.classList.toggle("is-done", n < i);
        if (n === i) m.setAttribute("aria-current", "step");
        else m.removeAttribute("aria-current");
      });
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      error.hidden = true;
    };

    next.addEventListener("click", () => {
      if (valid()) show(current + 1);
    });
    back.addEventListener("click", () => show(current - 1));
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!valid()) return;
      form.hidden = true;
      root.querySelector(".msf__progress").hidden = true;
      success.hidden = false;
    });
  })();
</script>
