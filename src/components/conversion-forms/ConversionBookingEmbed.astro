---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="conversion-booking-embed" class="section booking" data-provider="resy" data-resy-venue-id="58421" data-display="inline">
  <!-- kit: conversion-booking-embed -->
  <div class="container">
    <div class="section-head">
      <h2>Reserve a table</h2>
      <p class="lead">Bookings open 30 days ahead at 10am. A few seats at the counter are always kept for walk-ins.</p>
    </div>

    <div class="booking__grid">
      <article class="booking__exp card" data-booking-type="resy-dining">
        <img src="https://picsum.photos/seed/hearthash-dining-room/1200/900" alt="A candlelit dining room with an open wood fire at the back" width="1200" height="900" loading="lazy" />
        <div class="booking__exp-body">
          <h3>Dining room</h3>
          <p>The full à la carte menu from the wood-fired hearth.</p>
          <ul class="booking__facts">
            <li>2 hours</li>
            <li>1–6 guests</li>
            <li>No deposit</li>
          </ul>
        </div>
      </article>
      <article class="booking__exp card" data-booking-type="resy-counter">
        <img src="https://picsum.photos/seed/hearthash-chefs-counter/1200/900" alt="Chef plating a course at a counter facing the hearth" width="1200" height="900" loading="lazy" />
        <div class="booking__exp-body">
          <h3>Chef's counter</h3>
          <p>Nine courses cooked in front of you by Chef Amara Osei and the team.</p>
          <ul class="booking__facts">
            <li>3 hours</li>
            <li>1–4 guests</li>
            <li>$165 per person</li>
            <li>Deposit required</li>
          </ul>
        </div>
      </article>

      <div class="booking__widget card">
        <form class="booking__form" action={bcmsFormAction("Find a table")} method={bcmsFormMethod("Find a table")} data-bcms-form={bcmsFormId("Find a table")} data-bcms-form-success="Thank you for your submission!">
          <h3>Find a table</h3>
          <div class="field" data-bcms-form-field="experience">
            <label for="bk-exp" data-bcms-form-part="label">Experience</label>
            <select id="bk-exp" name="experience">
              <option value="resy-dining">Dining room</option>
              <option value="resy-counter">Chef's counter</option>
            </select>
          </div>
          <div class="booking__row">
            <div class="field" data-bcms-form-field="date">
              <label for="bk-date" data-bcms-form-part="label">Date</label>
              <input id="bk-date" name="date" type="date" required />
            </div>
            <div class="field" data-bcms-form-field="party">
              <label for="bk-party" data-bcms-form-part="label">Guests</label>
              <select id="bk-party" name="party">
                <option>1</option>
                <option selected>2</option>
                <option>3</option>
                <option>4</option>
                <option>5</option>
                <option>6</option>
                <option value="7">7 or more</option>
              </select>
            </div>
          </div>
          <div class="field" data-bcms-form-field="time">
            <label for="bk-time" data-bcms-form-part="label">Time</label>
            <select id="bk-time" name="time">
              <option>5:30 pm</option>
              <option>6:00 pm</option>
              <option selected>7:00 pm</option>
              <option>8:15 pm</option>
              <option>9:00 pm</option>
            </select>
          </div>
          <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Check availability</button>
          <p class="booking__large" hidden>For 7 or more guests, plan a private dinner with our events team.</p>
          <p class="booking__powered">Reservations by Resy</p>
        <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
        <p class="bcms-form-msg" hidden></p>
        </form>
        <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
        <div class="booking__private">
          <p>Seven or more?</p>
          <a class="btn btn-secondary" href="/private-dining">Plan a private dinner</a>
        </div>
      </div>
    </div>

    <div class="booking__foot">
      <div class="booking__policy">
        <p>Cancel up to 24 hours ahead at no charge. Chef's counter bookings take a $50 per person deposit, credited to your bill. Tell us about allergies when you book — the kitchen cooks without nuts on request.</p>
      </div>
      <p class="booking__phone">Prefer to call? <a href="tel:+15035550199">(503) 555-0199</a></p>
    </div>
  </div>
</section>

<style>
  #conversion-booking-embed [hidden] {
    display: none !important;
  }

  .booking__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .booking__exp img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .booking__exp-body {
    padding: 1.25rem;
  }

  .booking__exp-body p {
    color: var(--ink-2);
  }

  .booking__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .booking__facts li {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .booking__widget {
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .booking__form {
    display: grid;
    gap: 1rem;
  }

  .booking__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0.75rem;
  }

  .booking__large {
    margin: 0;
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .booking__powered {
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .booking__private {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .booking__private p {
    margin: 0;
    font-weight: 600;
  }

  .booking__foot {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .booking__phone a {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .booking__grid {
      grid-template-columns: 1fr 1fr;
    }

    .booking__widget {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .booking__grid,
    .booking__foot {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("conversion-booking-embed");
    if (!root) return;
    const party = root.querySelector("#bk-party");
    const note = root.querySelector(".booking__large");
    party.addEventListener("change", () => (note.hidden = Number(party.value) < 7));
    root.querySelector("form").addEventListener("submit", (e) => e.preventDefault());
  })();
</script>
