---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="conversion-waitlist-referral" class="section section--dark waitlist" data-list-tag="ember-oven-waitlist" data-counter-min="500">
  <!-- kit: conversion-waitlist-referral -->
  <div class="container waitlist__grid">
    <div class="waitlist__copy">
      <span class="eyebrow">Coming spring 2027</span>
      <h2>The Ember Pizza Oven</h2>
      <p class="lead">A cast iron pizza oven that sits on any fire ring and hits 900°F in twenty minutes. The first run is 1,500 ovens, and the waitlist gets first access and launch pricing.</p>
      <p class="waitlist__launch">Launching <strong>Spring 2027</strong></p>

      <form class="waitlist__form" action={bcmsFormAction("The Ember Pizza Oven")} method={bcmsFormMethod("The Ember Pizza Oven")} data-form="form_newsletter" data-bcms-form={bcmsFormId("The Ember Pizza Oven")} data-bcms-form-success="Thank you for your submission!">
        <input type="hidden" name="list_tag" value="ember-oven-waitlist" data-bcms-form-field="list_tag" />
        <label class="visually-hidden" for="wl-email" data-bcms-form-part="label">Email address</label>
        <input id="wl-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required data-bcms-form-field="email" />
        <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Join the waitlist</button>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
      <p class="waitlist__counter"><strong>1,284</strong> people already on the list</p>

      <div class="waitlist__success" role="status" hidden>
        <p>You're number <strong class="waitlist__position">1,285</strong>. Share your link — every friend who joins moves you up.</p>
        <div class="waitlist__share" data-share-message="I'm on the list for Caldera's new pizza oven — 900°F over a campfire. Join with my link and we both move up: {{link}}">
          <label class="visually-hidden" for="wl-link">Your referral link</label>
          <input id="wl-link" type="text" readonly value="https://caldera.com/ember?ref=fire1285" />
          <div class="waitlist__channels">
            <button type="button" class="btn btn-secondary" data-channel="copy">Copy link</button>
            <a class="btn btn-secondary" data-channel="email" href="mailto:?subject=Caldera%20Ember%20Pizza%20Oven">Email</a>
            <a class="btn btn-secondary" data-channel="sms" href="sms:">SMS</a>
            <a class="btn btn-secondary" data-channel="whatsapp" href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
      </div>
    </div>

    <div class="waitlist__side">
      <img src="https://picsum.photos/seed/caldera-pizza-oven-teaser/1600/1200" alt="A cast iron dome oven glowing over a campfire with a blistered pizza inside" width="1600" height="1200" loading="lazy" />
      <div class="waitlist__rewards">
        <h3>Invite friends, move up</h3>
        <ol>
          <li><span class="waitlist__friends">1 friend</span> Move up 100 places</li>
          <li><span class="waitlist__friends">3 friends</span> A free pizza peel ($45)</li>
          <li><span class="waitlist__friends">10 friends</span> Your oven ships in the first week</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  #conversion-waitlist-referral [hidden] {
    display: none !important;
  }

  .waitlist__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .waitlist__launch {
    color: rgb(255 255 255 / 0.7);
  }

  .waitlist__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .waitlist__form input,
  .waitlist__share input {
    flex: 1 1 220px;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
  }

  .waitlist__counter {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.7);
  }

  .waitlist__counter strong {
    color: #fff;
  }

  .waitlist__success {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: var(--radius);
  }

  .waitlist__share {
    display: grid;
    gap: 0.75rem;
  }

  .waitlist__share input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .waitlist__channels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .waitlist__channels .btn {
    border-color: rgb(255 255 255 / 0.25);
    color: #fff;
    min-height: 38px;
    font-size: 0.875rem;
  }

  .waitlist__side img {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .waitlist__rewards {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
  }

  .waitlist__rewards ol {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .waitlist__rewards li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .waitlist__friends {
    flex: none;
    min-width: 6.5rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 860px) {
    .waitlist__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("conversion-waitlist-referral");
    if (!root) return;
    const form = root.querySelector(".waitlist__form");
    const success = root.querySelector(".waitlist__success");
    const share = root.querySelector(".waitlist__share");
    const link = root.querySelector("#wl-link");
    const msg = share.dataset.shareMessage.replace("{{link}}", link.value);
    root.querySelector('[data-channel="email"]').href = "mailto:?subject=Caldera%20Ember%20Pizza%20Oven&body=" + encodeURIComponent(msg);
    root.querySelector('[data-channel="sms"]').href = "sms:?&body=" + encodeURIComponent(msg);
    root.querySelector('[data-channel="whatsapp"]').href = "https://wa.me/?text=" + encodeURIComponent(msg);
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      success.hidden = false;
    });
    root.querySelector('[data-channel="copy"]').addEventListener("click", (e) => {
      const btn = e.currentTarget;
      if (navigator.clipboard) navigator.clipboard.writeText(link.value).catch(() => {});
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy link"), 1600);
    });
  })();
</script>
