---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="conversion-contact-section" class="section contact" data-variant="form-right">
  <!-- kit: conversion-contact-section -->
  <div class="container contact__grid">
    <div class="contact__info">
      <h2>Talk to a person</h2>
      <p class="lead">Our customer team works from the Bend foundry. We answer every email ourselves, usually the same day.</p>

      <ul class="contact__channels">
        <li class="contact__channel" data-kind="email">
          <span class="contact__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
          <div>
            <h3>Orders and returns</h3>
            <a href="mailto:help@caldera.com">help@caldera.com</a>
            <p>Mon–Fri, 8am–5pm PT · Replies within a day</p>
          </div>
        </li>
        <li class="contact__channel" data-kind="phone">
          <span class="contact__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg></span>
          <div>
            <h3>Call the foundry</h3>
            <a href="tel:+15415550182">(541) 555-0182</a>
            <p>Mon–Fri, 9am–4pm PT</p>
          </div>
        </li>
        <li class="contact__channel" data-kind="chat">
          <span class="contact__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /></svg></span>
          <div>
            <h3>Chat with us</h3>
            <a href="#chat">Live on weekdays</a>
            <p>Replies in a few minutes</p>
          </div>
        </li>
        <li class="contact__channel" data-kind="email">
          <span class="contact__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
          <div>
            <h3>Wholesale</h3>
            <a href="mailto:wholesale@caldera.com?subject=Wholesale%20enquiry">wholesale@caldera.com</a>
          </div>
        </li>
      </ul>

      <div class="contact__visit">
        <iframe
          title="Map showing Caldera Foundry at 1020 NW Wall St, Bend"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-121.3233%2C44.0546%2C-121.3033%2C44.0646&layer=mapnik&marker=44.0596%2C-121.3133"
          loading="lazy"
          width="600"
          height="220"></iframe>
        <address>
          Caldera Foundry &amp; Shop<br />
          1020 NW Wall St<br />
          Bend, OR 97703
        </address>
      </div>
    </div>

    <div class="contact__panel card">
      <form class="contact__form" action={bcmsFormAction("Wholesale")} method={bcmsFormMethod("Wholesale")} data-form="form_contact" data-bcms-form={bcmsFormId("Wholesale")} data-bcms-form-success="Thank you for your submission!">
        <div class="contact__two">
          <div class="field" data-bcms-form-field="name">
            <label for="ct-name" data-bcms-form-part="label">Name</label>
            <input id="ct-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field" data-bcms-form-field="email">
            <label for="ct-email" data-bcms-form-part="label">Email</label>
            <input id="ct-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field" data-bcms-form-field="phone">
          <label for="ct-phone" data-bcms-form-part="label">Phone (optional)</label>
          <input id="ct-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field" data-bcms-form-field="topic">
          <label for="ct-topic" data-bcms-form-part="label">Topic</label>
          <select id="ct-topic" name="topic">
            <option>An order</option>
            <option>Returns and warranty</option>
            <option>Care and seasoning</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field" data-bcms-form-field="message">
          <label for="ct-message" data-bcms-form-part="label">Message</label>
          <textarea id="ct-message" name="message" rows="5" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit" data-bcms-form-part="submit">Send message</button>
      <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
      <p class="bcms-form-msg" hidden></p>
      </form>
      <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
      <p class="contact__success" role="status" hidden>Thanks — your message is with the team. We'll reply by email, usually the same day.</p>
    </div>
  </div>
</section>

<style>
  #conversion-contact-section [hidden] {
    display: none !important;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .contact__channel {
    display: flex;
    gap: 0.875rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .contact__channel h3 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
  }

  .contact__channel a {
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__channel p {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .contact__icon svg {
    width: 20px;
    height: 20px;
  }

  .contact__visit {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1rem;
    align-items: center;
  }

  .contact__visit iframe {
    width: 100%;
    height: 200px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .contact__visit address {
    font-style: normal;
    color: var(--ink-2);
  }

  .contact__panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }

  .contact__form {
    display: grid;
    gap: 1rem;
  }

  .contact__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .contact__success {
    margin: 0;
    color: var(--success);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact__visit {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("conversion-contact-section");
    if (!root) return;
    const form = root.querySelector("form");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      root.querySelector(".contact__success").hidden = false;
    });
  })();
</script>
