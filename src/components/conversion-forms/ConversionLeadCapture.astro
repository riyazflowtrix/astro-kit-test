---
---

<section id="conversion-lead-capture" class="section lead-capture" data-variant="form-right" data-on-success="download">
  <!-- kit: conversion-lead-capture -->
  <div class="container lead-capture__grid">
    <div class="lead-capture__copy">
      <span class="eyebrow">Wholesale</span>
      <h2>Stock Caldera in your store</h2>
      <div class="lead-capture__body">
        <p>We partner with independent outfitters, kitchen shops and guiding companies. Tell us about your store and a member of our wholesale team will reply within two business days.</p>
      </div>
      <ul class="lead-capture__points">
        <li>
          <span class="lead-capture__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>
          </span>
          Free freight on orders over $2,000
        </li>
        <li>
          <span class="lead-capture__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18M12 14v4M10.5 15.5h2.5a1 1 0 0 1 0 2h-2" /></svg>
          </span>
          Net-30 terms from your second order
        </li>
        <li>
          <span class="lead-capture__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2" /><path d="M21 16l-5-5-9 9" /></svg>
          </span>
          Shelf talkers and a product photo library
        </li>
      </ul>
    </div>

    <div class="lead-capture__panel card">
      <form class="lead-capture__form" action="#" method="post" data-form="form_wholesale">
        <div class="lead-capture__two">
          <div class="field">
            <label for="lc-name">Your name</label>
            <input id="lc-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="lc-email">Work email</label>
            <input id="lc-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="lc-store">Store name</label>
          <input id="lc-store" name="store" type="text" autocomplete="organization" required />
        </div>
        <div class="lead-capture__two">
          <div class="field">
            <label for="lc-website">Website</label>
            <input id="lc-website" name="website" type="url" placeholder="https://" />
          </div>
          <div class="field">
            <label for="lc-type">Type of business</label>
            <select id="lc-type" name="business_type">
              <option>Outdoor outfitter</option>
              <option>Kitchen shop</option>
              <option>Guiding company</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="lc-message">Tell us about your store</label>
          <textarea id="lc-message" name="message" rows="4"></textarea>
        </div>
        <input type="hidden" name="lead_source" value="{{utm_source}}" />
        <input type="hidden" name="landing_page" value="{{page_url}}" />
        <button class="btn btn-primary lead-capture__submit" type="submit">Apply for wholesale</button>
        <div class="lead-capture__privacy">
          <p>We only use your details to review your application. <a href="/privacy">Privacy policy</a>.</p>
        </div>
      </form>

      <div class="lead-capture__success" role="status" hidden>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 12l3 3 5-6" /></svg>
        <p>Thanks — we've got it. Your wholesale line sheet is downloading, and Maya from our wholesale team will email you within two business days.</p>
        <a class="btn btn-secondary" href="https://cdn.bettercms.site/caldera/caldera-wholesale-line-sheet-2026.pdf" download="caldera-wholesale-line-sheet-2026.pdf">Download the line sheet again</a>
      </div>
    </div>
  </div>
</section>

<style>
  #conversion-lead-capture [hidden] {
    display: none !important;
  }

  .lead-capture__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .lead-capture__body {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  .lead-capture__points {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lead-capture__points li {
    display: flex;
    gap: 0.875rem;
    align-items: center;
    font-weight: 500;
  }

  .lead-capture__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--brand-soft);
    color: var(--brand);
  }

  .lead-capture__icon svg {
    width: 22px;
    height: 22px;
  }

  .lead-capture__panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }

  .lead-capture__form {
    display: grid;
    gap: 1rem;
  }

  .lead-capture__two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .lead-capture__submit {
    width: 100%;
  }

  .lead-capture__privacy {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .lead-capture__privacy p {
    margin: 0;
  }

  .lead-capture__success {
    display: grid;
    gap: 1rem;
    justify-items: start;
    color: var(--ink);
  }

  .lead-capture__success svg {
    color: var(--success);
  }

  .lead-capture__success[hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .lead-capture__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("conversion-lead-capture");
    if (!root) return;
    const form = root.querySelector("form");
    const success = root.querySelector(".lead-capture__success");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      form.hidden = true;
      success.hidden = false;
    });
  })();
</script>
