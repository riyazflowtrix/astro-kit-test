<section id="leadership-bios" class="section leadership-bios">
  <!-- kit: leadership-bios -->
  <div class="container">
    <header class="section-head">
      <h2>The people behind Ledgerline</h2>
      <p class="lead">Former controllers, auditors and engineers who got tired of closing the books in spreadsheets.</p>
    </header>

    <div class="lb-group">
      <h3 class="lb-group-title">Leadership</h3>
      <ul class="lb-grid" role="list">
        <li class="lb-card">
          <img src="https://i.pravatar.cc/480?img=32" alt="Amara Osei" width="480" height="480" loading="lazy" />
          <div class="lb-card-body">
            <h4>Amara Osei</h4>
            <p class="lb-title">Co-founder & CEO</p>
            <div class="lb-actions">
