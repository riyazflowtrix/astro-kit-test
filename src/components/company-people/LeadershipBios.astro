<style>
  .lb-group + .lb-group { margin-top: 3.5rem; }
  .lb-group-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .lb-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lb-card > img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: 1rem;
  }
  .lb-card h4, .lb-dialog h4 { font-size: 1.125rem; margin: 0 0 0.125rem; }
  .lb-title { margin: 0; color: var(--ink-2); }
  .lb-aff { margin: 0.125rem 0 0; font-size: 0.875rem; color: var(--ink-3); }
  .lb-actions { display: flex; align-items: center; gap: 1rem; margin-top: 0.75rem; }
  .lb-open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--brand);
    cursor: pointer;
  }
  .lb-open:hover { text-decoration: underline; }
  .lb-linkedin { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-sm); color: var(--ink-3); }
  .lb-linkedin:hover { color: #0a66c2; background: var(--surface); }
  .lb-dialog {
    width: min(92vw, 560px);
    max-height: 85vh;
    padding: 2rem;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
    color: var(--ink);
  }
  .lb-dialog::backdrop { background: rgb(20 19 23 / 0.6); }
  .lb-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .lb-dialog-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; padding-right: 2rem; }
  .lb-dialog-head img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none; }
  .lb-bio { color: var(--ink-2); }
  .lb-dialog-link { font-weight: 600; color: var(--brand); text-decoration: none; }
  @media (max-width: 900px) { .lb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .lb-grid { grid-template-columns: 1fr; } .lb-dialog { padding: 1.5rem; } }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("leadership-bios");
    if (!root) return;
    root.querySelectorAll(".lb-open").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var dialog = root.querySelector("#" + btn.getAttribute("data-dialog"));
        if (dialog && typeof dialog.showModal === "function") dialog.showModal();
      });
    });
    root.querySelectorAll(".lb-dialog").forEach(function (dialog) {
      dialog.addEventListener("click", function (e) { if (e.target === dialog) dialog.close(); });
    });
  })();
</script>
