        <li class="lb-card">
          <img src="https://i.pravatar.cc/480?img=20" alt="Helen Park" width="480" height="480" loading="lazy" />
          <div class="lb-card-body">
            <h4>Helen Park</h4>
            <p class="lb-title">Board member</p>
            <p class="lb-aff">General Partner, Foundry Ventures</p>
            <div class="lb-actions">
              <button type="button" class="lb-open" data-dialog="lb-dialog-helen-board" aria-haspopup="dialog">Read bio<span class="visually-hidden"> of Helen Park</span></button>
              <a class="lb-linkedin" href="https://www.linkedin.com/in/helen-park" target="_blank" rel="noopener" aria-label="Helen Park on LinkedIn"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg></a>
            </div>
          </div>
