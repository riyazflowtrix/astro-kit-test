            <form method="dialog"><button class="lb-close" aria-label="Close">×</button></form>
            <div class="lb-dialog-head">
              <img src="https://i.pravatar.cc/480?img=45" alt="" width="480" height="480" loading="lazy" />
              <div>
                <h4 id="lb-dialog-priya-lead-name">Priya Raman</h4>
                <p class="lb-title">Chief Accounting Officer</p>
