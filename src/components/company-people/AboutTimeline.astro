<section id="about-timeline" class="section about-timeline">
  <!-- kit: about-timeline -->
  <div class="container">
    <div class="at-intro">
      <header class="at-head">
        <span class="eyebrow">Our story</span>
        <h2>One skillet, a borrowed foundry and a lot of burnt eggs</h2>
        <p class="at-mission">We make cookware for people who cook outside, built to be repaired, re-seasoned and handed down.</p>
      </header>

      <div class="at-story">
        <p>Caldera started in 2017 with one skillet, cast on weekends in a borrowed foundry in Bend. Ana and Luis wanted a pan light enough to carry to camp and tough enough to sit in coals.</p>
        <blockquote>
          <p>We burned four hundred eggs getting the cooking surface right.</p>
          <cite>Ana Vidal, co-founder</cite>
        </blockquote>
        <p>Nine years later we cast every piece in our own foundry, two miles from where the first one was poured.</p>

        <ul class="at-founders" role="list">
          <li>
            <img src="https://i.pravatar.cc/192?img=1" alt="Ana Vidal" width="96" height="96" loading="lazy" />
            <span><strong>Ana Vidal</strong><span>Co-founder &amp; CEO</span></span>
          </li>
          <li>
            <img src="https://i.pravatar.cc/192?img=12" alt="Luis Ortega" width="96" height="96" loading="lazy" />
            <span><strong>Luis Ortega</strong><span>Co-founder &amp; head of workshop</span></span>
          </li>
        </ul>
      </div>
    </div>

    <dl class="at-stats">
      <div><dt>Pans in kitchens and camps</dt><dd>212k</dd></div>
      <div><dt>People in Bend, Oregon</dt><dd>40</dd></div>
      <div><dt>Scrap rate in 2025</dt><dd>2.1%</dd></div>
    </dl>

    <ol class="at-timeline" role="list">
      <li class="at-milestone">
        <time datetime="2017-04">April 2017</time>
        <div class="at-card">
          <h3>The first skillet</h3>
          <p>Poured on a Saturday in a borrowed foundry. It cracked. The second one didn't.</p>
          <img src="https://picsum.photos/seed/caldera-first-skillet/1200/900" alt="A rough, unfinished cast iron skillet on a workbench" width="2400" height="1800" loading="lazy" />
        </div>
      </li>
      <li class="at-milestone">
        <time datetime="2019-10">October 2019</time>
        <div class="at-card">
          <h3>Our own foundry</h3>
          <p>A 6,000 sq ft building on Empire Avenue and our first four hires.</p>
        </div>
      </li>
      <li class="at-milestone">
        <time datetime="2022-06">June 2022</time>
        <div class="at-card">
          <h3>Lifetime warranty</h3>
          <p>Every pan, forever. We replaced 31 in the first year.</p>
          <a class="at-link" href="/legal/warranty-returns">Read the warranty <span aria-hidden="true">→</span></a>
        </div>
      </li>
      <li class="at-milestone">
        <time datetime="2026-03">March 2026</time>
        <div class="at-card">
          <h3>The Cable Fold Grill</h3>
          <p>Eleven prototypes later, our first piece built for the fire itself.</p>
          <img src="https://picsum.photos/seed/cable-fold-launch/1200/900" alt="The Cable Fold grate unfolded over a campfire" width="2400" height="1800" loading="lazy" />
          <a class="at-link" href="/products/cable-fold" title="Cable Fold Grill">Cable Fold Grill <span aria-hidden="true">→</span></a>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .at-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-bottom: 3rem;
  }
  .at-mission { font-size: 1.25rem; font-weight: 500; color: var(--ink-2); }
  .at-story { color: var(--ink-2); }
  .at-story blockquote {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--brand);
  }
  .at-story blockquote p { font-size: 1.375rem; font-weight: 600; color: var(--ink); line-height: 1.35; margin-bottom: 0.375rem; }
  .at-story cite { font-style: normal; font-size: 0.875rem; color: var(--ink-3); }
  .at-founders { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .at-founders li { display: flex; align-items: center; gap: 0.75rem; }
  .at-founders img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .at-founders li > span { display: grid; line-height: 1.3; }
  .at-founders strong { color: var(--ink); }
  .at-founders li > span span { font-size: 0.875rem; }
  .at-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 4rem;
    padding: 1.75rem 0;
    border-block: 1px solid var(--line);
  }
  .at-stats div { display: flex; flex-direction: column; }
  .at-stats dd { order: -1; margin: 0; font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .at-stats dt { color: var(--ink-2); font-size: 0.9375rem; }
  .at-timeline {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .at-timeline::before {
    content: "";
    position: absolute;
    left: 8.5rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }
  .at-milestone {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 3rem;
    padding-bottom: 2.5rem;
  }
  .at-milestone:last-child { padding-bottom: 0; }
  .at-milestone::before {
    content: "";
    position: absolute;
    left: calc(8.5rem - 6px);
    top: 0.45rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .at-milestone time { font-weight: 700; color: var(--brand); text-align: right; padding-top: 0.125rem; }
  .at-card h3 { margin-bottom: 0.375rem; }
  .at-card p { color: var(--ink-2); margin-bottom: 0.75rem; }
  .at-card img { width: 100%; max-width: 480px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.75rem; }
  .at-link { font-weight: 600; color: var(--brand); text-decoration: none; }
  .at-link:hover { text-decoration: underline; }
  @media (max-width: 800px) {
    .at-intro { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 600px) {
    .at-stats { grid-template-columns: 1fr; }
    .at-timeline::before { left: 6px; }
    .at-milestone { grid-template-columns: 1fr; gap: 0.25rem; padding-left: 2rem; }
    .at-milestone::before { left: 0; }
    .at-milestone time { text-align: left; }
  }
</style>
