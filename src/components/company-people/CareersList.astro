---
---

<section id="careers-list" class="section careers-list">
  <!-- kit: careers-list -->
  <div class="container">
    <header class="section-head">
      <h2>Open roles</h2>
      <p class="lead">We hire slowly and keep people for a long time. Every role below is open today.</p>
    </header>

    <form class="cl-filters" action="#" aria-label="Filter open roles">
      <div class="field">
        <label for="cl-filter-dept">Department</label>
        <select id="cl-filter-dept" name="department" data-key="dept">
          <option value="">All departments</option>
          <option value="workshop">Workshop</option>
          <option value="design">Design</option>
          <option value="care">Customer care</option>
          <option value="operations">Operations</option>
        </select>
      </div>
      <div class="field">
        <label for="cl-filter-location">Location</label>
        <select id="cl-filter-location" name="location" data-key="location">
          <option value="">All locations</option>
          <option value="bend">Bend, Oregon</option>
          <option value="us">Remote, United States</option>
        </select>
      </div>
      <div class="field">
        <label for="cl-filter-workplace">Workplace</label>
        <select id="cl-filter-workplace" name="workplace" data-key="workplace">
          <option value="">Any workplace</option>
          <option value="onsite">On-site</option>
          <option value="hybrid">Hybrid</option>
          <option value="remote">Remote</option>
        </select>
      </div>
    </form>

    <p class="cl-count" aria-live="polite"><span class="cl-count-num">6</span> open roles</p>

    <div class="cl-groups">
      <div class="cl-group" data-dept="workshop">
        <h3 class="cl-group-title">Workshop</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="workshop" data-location="bend" data-workplace="onsite">
            <a href="/company-people/job-posting">
              <span class="cl-title">Foundry Technician (Finishing)<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Foundry, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$52,000–$61,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li class="cl-row" data-dept="workshop" data-location="bend" data-workplace="onsite">
            <a href="/careers/caster">
              <span class="cl-title">Caster<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Foundry, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$48,000–$56,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="design">
        <h3 class="cl-group-title">Design</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="design" data-location="bend" data-workplace="hybrid">
            <a href="/careers/senior-product-designer">
              <span class="cl-title">Senior Product Designer<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Hybrid</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$115,000–$135,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="care">
        <h3 class="cl-group-title">Customer care</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="care" data-location="us" data-workplace="remote">
            <a href="/careers/customer-care-specialist">
              <span class="cl-title">Customer Care Specialist<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>United States</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Remote</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$46,000–$52,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li class="cl-row" data-dept="care" data-location="us" data-workplace="remote">
            <a href="/careers/seasonal-care-associate">
              <span class="cl-title">Seasonal Care Associate<span class="cl-type">Temporary</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>United States</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Remote</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$24–$27 / hour</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="operations">
        <h3 class="cl-group-title">Operations</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="operations" data-location="bend" data-workplace="onsite">
            <a href="/careers/warehouse-lead">
              <span class="cl-title">Warehouse Lead<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Warehouse, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$27–$31 / hour</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="cl-empty" hidden>
      <h3>No open roles right now</h3>
      <p>We open roles a few times a year. Join the talent list and we'll email you first.</p>
      <a class="btn btn-secondary" href="/careers/talent-list" title="Talent list">Join the talent list</a>
    </div>
  </div>
</section>

<style>
  .cl-filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .cl-count { font-size: 0.875rem; color: var(--ink-3); margin-bottom: 1.5rem; }
  .cl-group[hidden], .cl-row[hidden] { display: none; }
  .cl-group + .cl-group { margin-top: 2.5rem; }
  .cl-group-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }
  .cl-rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .cl-row { border-bottom: 1px solid var(--line); }
  .cl-row a {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 1.4fr) 1.5rem;
    gap: 1rem;
    align-items: center;
    padding: 1.125rem 0.75rem;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .cl-row a:hover { background: var(--surface); }
  .cl-title { font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cl-type { font-size: 0.75rem; font-weight: 600; color: var(--ink-3); border: 1px solid var(--line); border-radius: 999px; padding: 0 0.5rem; }
  .cl-cell { font-size: 0.9375rem; color: var(--ink-2); }
  .cl-arrow { color: var(--brand); font-weight: 700; transition: transform 150ms ease; }
  .cl-row a:hover .cl-arrow { transform: translateX(3px); }
  .cl-empty {
    padding: 2.5rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
  }
  .cl-empty p { color: var(--ink-2); }
  @media (max-width: 760px) {
    .cl-filters { grid-template-columns: 1fr; }
    .cl-row a { grid-template-columns: 1fr auto; gap: 0.25rem 1rem; }
    .cl-title { grid-column: 1; }
    .cl-arrow { grid-column: 2; grid-row: 1 / span 4; }
    .cl-cell { grid-column: 1; font-size: 0.875rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("careers-list");
    if (!root) return;
    var selects = Array.prototype.slice.call(root.querySelectorAll(".cl-filters select"));
    var rows = Array.prototype.slice.call(root.querySelectorAll(".cl-row"));
    var groups = Array.prototype.slice.call(root.querySelectorAll(".cl-group"));
    var empty = root.querySelector(".cl-empty");
    var count = root.querySelector(".cl-count-num");
    var form = root.querySelector(".cl-filters");
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); });
    function apply() {
      var shown = 0;
      rows.forEach(function (row) {
        var ok = selects.every(function (s) {
          return !s.value || row.getAttribute("data-" + s.getAttribute("data-key")) === s.value;
        });
        row.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach(function (g) { g.hidden = !g.querySelector(".cl-row:not([hidden])"); });
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = String(shown);
    }
    selects.forEach(function (s) { s.addEventListener("change", apply); });
  })();
</script>
