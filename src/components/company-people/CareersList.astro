---
import { bcmsFormAction, bcmsFormId, bcmsFormMethod } from "../../bcms-forms";
---

<section id="careers-list" class="section careers-list">
  <!-- kit: careers-list -->
  <div class="container">
    <header class="section-head">
      <h2>Open roles</h2>
      <p class="lead">We hire slowly and keep people for a long time. Every role below is open today.</p>
    </header>

    <form class="cl-filters" action={bcmsFormAction("Filter open roles")} aria-label="Filter open roles" method={bcmsFormMethod("Filter open roles")} data-bcms-form={bcmsFormId("Filter open roles")} data-bcms-form-success="Thank you for your submission!">
      <div class="field" data-bcms-form-field="department">
        <label for="cl-filter-dept" data-bcms-form-part="label">Department</label>
        <select id="cl-filter-dept" name="department" data-key="dept">
          <option value="">All departments</option>
          <option value="workshop">Workshop</option>
          <option value="design">Design</option>
          <option value="care">Customer care</option>
          <option value="operations">Operations</option>
        </select>
      </div>
      <div class="field" data-bcms-form-field="location">
        <label for="cl-filter-location" data-bcms-form-part="label">Location</label>
        <select id="cl-filter-location" name="location" data-key="location">
          <option value="">All locations</option>
          <option value="bend">Bend, Oregon</option>
          <option value="us">Remote, United States</option>
        </select>
      </div>
      <div class="field" data-bcms-form-field="workplace">
        <label for="cl-filter-workplace" data-bcms-form-part="label">Workplace</label>
        <select id="cl-filter-workplace" name="workplace" data-key="workplace">
          <option value="">Any workplace</option>
          <option value="onsite">On-site</option>
          <option value="hybrid">Hybrid</option>
          <option value="remote">Remote</option>
        </select>
      </div>
    <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap"><input type="text" name="_bcms_hp" tabindex="-1" autocomplete="off" aria-hidden="true"></div>
    <p class="bcms-form-msg" hidden></p>
    </form>
    <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/\D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/\D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  // Once per form: a page that runs this again (a server-rendered fragment's scripts after
  // hydration, two fragments on one page) must not bind a second submit.
  if(f.hasAttribute('data-bcms-form-on'))return;f.setAttribute('data-bcms-form-on','');
  // One view per page load: the conversion rate's denominator. Only the dashboard's embed sent it,
  // so a hosted or converted form read near zero views and its rate meant nothing. Counted on the
  // live site only: never in a frame (the editor canvas) or on a preview, canvas or branch host.
  try{var sa=f.action,ss='/submissions',h=location.hostname;if(window.top===window&&h.indexOf('preview-')!==0&&h.indexOf('canvas-')!==0&&h.indexOf('--')===-1&&sa.slice(-ss.length)===ss)fetch(sa.slice(0,-ss.length)+'/view',{method:'POST',keepalive:true});}catch(x){}
  // Conditional fields. A hidden field's controls are DISABLED, not just hidden: a disabled control
  // posts nothing and is never checked by native validation, so a hidden required field cannot
  // block the submit and its stale answer never leaves the browser.
  function conds(){
    f.querySelectorAll('[data-bcms-showif]').forEach(function(w){
      var c;try{c=JSON.parse(w.getAttribute('data-bcms-showif'));}catch(x){return;}
      var vals=[];
      f.querySelectorAll('[name]').forEach(function(el){
        if(el.name!==c.field||el.disabled)return;
        if(el.type==='checkbox'&&!el.hasAttribute('value'))vals.push(el.checked?'true':'false');
        else if(el.type==='radio'||el.type==='checkbox'){if(el.checked)vals.push(el.value);}
        else vals.push(el.value);
      });
      var show=vals.indexOf(c.equals)!==-1;
      w.hidden=!show;
      w.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=!show;});
    });
  }
  f.addEventListener('input',conds);
  f.addEventListener('change',conds);
  conds();
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      if(sel.disabled)return;
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    // _bcms_t: whole ms since the page's navigation (too fast reads as a bot), not since this bound.
    data._bcms_t=Math.round(performance.now());
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      // The server names what is wrong ("Company is required"); say that rather than a shrug.
      .then(function(r){return r.json().catch(function(){return {};}).then(function(j){var e=j&&j.errors;return {ok:r.ok,why:(e&&e[Object.keys(e)[0]])||(j&&j.error)};});})
      .then(function(r){var ok=r.ok;if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):(r.why||'Sorry, something went wrong.');}if(ok){f.reset();conds();}})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>

    <p class="cl-count" aria-live="polite"><span class="cl-count-num">6</span> open roles</p>

    <div class="cl-groups">
      <div class="cl-group" data-dept="workshop">
        <h3 class="cl-group-title">Workshop</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="workshop" data-location="bend" data-workplace="onsite">
            <a href="/company-people/job-posting">
              <span class="cl-title">Foundry Technician (Finishing)<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Foundry, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$52,000–$61,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li class="cl-row" data-dept="workshop" data-location="bend" data-workplace="onsite">
            <a href="/careers/caster">
              <span class="cl-title">Caster<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Foundry, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$48,000–$56,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="design">
        <h3 class="cl-group-title">Design</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="design" data-location="bend" data-workplace="hybrid">
            <a href="/careers/senior-product-designer">
              <span class="cl-title">Senior Product Designer<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Hybrid</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$115,000–$135,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="care">
        <h3 class="cl-group-title">Customer care</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="care" data-location="us" data-workplace="remote">
            <a href="/careers/customer-care-specialist">
              <span class="cl-title">Customer Care Specialist<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>United States</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Remote</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$46,000–$52,000 / year</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li class="cl-row" data-dept="care" data-location="us" data-workplace="remote">
            <a href="/careers/seasonal-care-associate">
              <span class="cl-title">Seasonal Care Associate<span class="cl-type">Temporary</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>United States</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>Remote</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$24–$27 / hour</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="cl-group" data-dept="operations">
        <h3 class="cl-group-title">Operations</h3>
        <ul class="cl-rows" role="list">
          <li class="cl-row" data-dept="operations" data-location="bend" data-workplace="onsite">
            <a href="/careers/warehouse-lead">
              <span class="cl-title">Warehouse Lead<span class="cl-type">Full-time</span></span>
              <span class="cl-cell cl-location"><span class="visually-hidden">Location: </span>Bend Warehouse, OR</span>
              <span class="cl-cell cl-workplace"><span class="visually-hidden">Workplace: </span>On-site</span>
              <span class="cl-cell cl-salary"><span class="visually-hidden">Salary: </span>$27–$31 / hour</span>
              <span class="cl-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="cl-empty" hidden>
      <h3>No open roles right now</h3>
      <p>We open roles a few times a year. Join the talent list and we'll email you first.</p>
      <a class="btn btn-secondary" href="/careers/talent-list" title="Talent list">Join the talent list</a>
    </div>
  </div>
</section>

<style>
  .cl-filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .cl-count { font-size: 0.875rem; color: var(--ink-3); margin-bottom: 1.5rem; }
  .cl-group[hidden], .cl-row[hidden] { display: none; }
  .cl-group + .cl-group { margin-top: 2.5rem; }
  .cl-group-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }
  .cl-rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .cl-row { border-bottom: 1px solid var(--line); }
  .cl-row a {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 1.4fr) 1.5rem;
    gap: 1rem;
    align-items: center;
    padding: 1.125rem 0.75rem;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .cl-row a:hover { background: var(--surface); }
  .cl-title { font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cl-type { font-size: 0.75rem; font-weight: 600; color: var(--ink-3); border: 1px solid var(--line); border-radius: 999px; padding: 0 0.5rem; }
  .cl-cell { font-size: 0.9375rem; color: var(--ink-2); }
  .cl-arrow { color: var(--brand); font-weight: 700; transition: transform 150ms ease; }
  .cl-row a:hover .cl-arrow { transform: translateX(3px); }
  .cl-empty {
    padding: 2.5rem;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
  }
  .cl-empty p { color: var(--ink-2); }
  @media (max-width: 760px) {
    .cl-filters { grid-template-columns: 1fr; }
    .cl-row a { grid-template-columns: 1fr auto; gap: 0.25rem 1rem; }
    .cl-title { grid-column: 1; }
    .cl-arrow { grid-column: 2; grid-row: 1 / span 4; }
    .cl-cell { grid-column: 1; font-size: 0.875rem; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("careers-list");
    if (!root) return;
    var selects = Array.prototype.slice.call(root.querySelectorAll(".cl-filters select"));
    var rows = Array.prototype.slice.call(root.querySelectorAll(".cl-row"));
    var groups = Array.prototype.slice.call(root.querySelectorAll(".cl-group"));
    var empty = root.querySelector(".cl-empty");
    var count = root.querySelector(".cl-count-num");
    var form = root.querySelector(".cl-filters");
    if (form) form.addEventListener("submit", function (e) { e.preventDefault(); });
    function apply() {
      var shown = 0;
      rows.forEach(function (row) {
        var ok = selects.every(function (s) {
          return !s.value || row.getAttribute("data-" + s.getAttribute("data-key")) === s.value;
        });
        row.hidden = !ok;
        if (ok) shown++;
      });
      groups.forEach(function (g) { g.hidden = !g.querySelector(".cl-row:not([hidden])"); });
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = String(shown);
    }
    selects.forEach(function (s) { s.addEventListener("change", apply); });
  })();
</script>
