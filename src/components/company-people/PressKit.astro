---
---

<section id="press-kit" class="section section--muted press-kit">
  <!-- kit: press-kit -->
  <div class="container">
    <header class="section-head">
      <h2>Press &amp; brand assets</h2>
    </header>

    <div class="pk">
      <aside class="pk-side" aria-label="About Caldera">
        <div class="pk-panel">
          <h3>About Caldera</h3>
          <p>Caldera makes cast iron and carbon steel cookware for cooking outdoors, designed to be repaired and handed down. Founded in 2017 in Bend, Oregon, the company casts and finishes every piece in its own foundry and backs it with a lifetime warranty.</p>
          <dl class="pk-facts">
            <div><dt>Founded</dt><dd>2017, Bend, Oregon</dd></div>
            <div><dt>Founders</dt><dd>Ana Vidal and Luis Ortega</dd></div>
            <div><dt>Team</dt><dd>40 people</dd></div>
            <div><dt>Made in</dt><dd>Our own foundry, Bend, Oregon</dd></div>
          </dl>
        </div>
        <div class="pk-panel">
          <h3>Press contact</h3>
          <p class="pk-contact"><strong>Rosa Lindgren</strong><br /><a href="mailto:press@caldera.co">press@caldera.co</a></p>
        </div>
        <a class="btn btn-primary pk-all" href="https://caldera.bettercms.site/media/press/caldera-press-kit-2026.zip" download="caldera-press-kit-2026.zip">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
          Download full press kit <span class="pk-size">(ZIP, 96 MB)</span>
        </a>
      </aside>

      <div class="pk-main">
        <section class="pk-group" aria-labelledby="pk-group-logos">
          <h3 id="pk-group-logos">Logos</h3>
          <p class="pk-group-desc">Leave clear space equal to the height of the flame mark. Don't recolour, stretch or add effects.</p>
          <ul class="pk-assets" role="list">
            <li class="pk-asset">
              <div class="pk-preview pk-preview--light">
                <img src="https://picsum.photos/seed/caldera-wordmark/800/400" alt="Caldera wordmark in ember orange" width="800" height="400" loading="lazy" />
              </div>
              <div class="pk-asset-body">
                <h4>Wordmark, ember</h4>
                <ul class="pk-formats" role="list">
                  <li><a href="https://caldera.bettercms.site/media/press/caldera-wordmark-ember.svg" download="caldera-wordmark-ember.svg">SVG <span>4.2 KB</span></a></li>
                  <li><a href="https://caldera.bettercms.site/media/press/caldera-wordmark-ember.png" download="caldera-wordmark-ember.png">PNG <span>48 KB</span></a></li>
                </ul>
              </div>
            </li>
            <li class="pk-asset">
              <div class="pk-preview pk-preview--dark">
                <img src="https://picsum.photos/seed/caldera-wordmark-dark/800/400" alt="Caldera wordmark in cream on charcoal" width="800" height="400" loading="lazy" />
              </div>
              <div class="pk-asset-body">
                <h4>Wordmark, cream</h4>
                <ul class="pk-formats" role="list">
                  <li><a href="https://caldera.bettercms.site/media/press/caldera-wordmark-cream.svg" download="caldera-wordmark-cream.svg">SVG <span>4.1 KB</span></a></li>
                </ul>
              </div>
            </li>
          </ul>
        </section>

        <section class="pk-group" aria-labelledby="pk-group-photos">
          <h3 id="pk-group-photos">Product photos</h3>
          <p class="pk-group-desc">Free for editorial use with credit.</p>
          <ul class="pk-assets" role="list">
            <li class="pk-asset pk-asset--wide">
              <div class="pk-preview">
                <img src="https://picsum.photos/seed/press-ridge-coals/1200/800" alt="The Ridge Skillet searing steaks over a bed of coals" width="2400" height="1600" loading="lazy" />
              </div>
              <div class="pk-asset-body">
                <h4>Ridge Skillet over coals</h4>
                <p class="pk-credit">Photo: Tom Okafor for Caldera</p>
                <ul class="pk-formats" role="list">
                  <li><a href="https://caldera.bettercms.site/media/press/ridge-skillet-coals-6000px.jpg" download="ridge-skillet-coals-6000px.jpg">JPG <span>14.8 MB</span></a></li>
                </ul>
              </div>
            </li>
          </ul>
        </section>

        <section class="pk-group" aria-labelledby="pk-group-coverage">
          <h3 id="pk-group-coverage">Recent coverage</h3>
          <ul class="pk-coverage" role="list">
            <li>
              <a href="https://www.outsideonline.com/outdoor-gear/camping/best-camp-cookware-2026/" target="_blank" rel="noopener">
                <span class="pk-outlet">Outside</span>
                <span class="pk-title">The best camp cookware of 2026</span>
                <time datetime="2026-05-12">12 May 2026</time>
              </a>
            </li>
            <li>
              <a href="https://www.bonappetit.com/story/caldera-cast-iron-repair" target="_blank" rel="noopener">
                <span class="pk-outlet">Bon Appétit</span>
                <span class="pk-title">This foundry in Oregon wants you to fix your skillet, not replace it</span>
                <time datetime="2025-11-03">3 November 2025</time>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .pk {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .pk-side { display: grid; gap: 1rem; position: sticky; top: 1.5rem; }
  .pk-panel { padding: 1.5rem; border-radius: var(--radius-lg); background: var(--bg); border: 1px solid var(--line); }
  .pk-panel h3 { font-size: 1rem; }
  .pk-panel p { color: var(--ink-2); font-size: 0.9375rem; }
  .pk-facts { margin: 0; display: grid; gap: 0.625rem; font-size: 0.875rem; }
  .pk-facts div { display: grid; grid-template-columns: 6rem 1fr; gap: 0.5rem; }
  .pk-facts dt { color: var(--ink-3); }
  .pk-facts dd { margin: 0; font-weight: 500; }
  .pk-contact { margin: 0; }
  .pk-contact a { color: var(--brand); }
  .pk-all { width: 100%; flex-wrap: wrap; text-align: center; }
  .pk-size { font-weight: 400; opacity: 0.85; }
  .pk-group + .pk-group { margin-top: 2.5rem; }
  .pk-group > h3 { margin-bottom: 0.25rem; }
  .pk-group-desc { color: var(--ink-2); font-size: 0.9375rem; }
  .pk-assets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pk-asset { border-radius: var(--radius-lg); overflow: hidden; background: var(--bg); border: 1px solid var(--line); }
  .pk-asset--wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .pk-preview { background: var(--surface-2); }
  .pk-preview--light { background: #fff; }
  .pk-preview--dark { background: var(--dark); }
  .pk-preview img { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; }
  .pk-asset--wide .pk-preview img { aspect-ratio: 3 / 2; height: 100%; }
  .pk-asset-body { padding: 1rem 1.25rem 1.25rem; }
  .pk-asset-body h4 { font-size: 1rem; margin-bottom: 0.5rem; }
  .pk-credit { font-size: 0.8125rem; color: var(--ink-3); margin-bottom: 0.75rem; }
  .pk-formats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .pk-formats a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 36px;
    padding: 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .pk-formats a:hover { border-color: var(--ink-3); }
  .pk-formats span { font-weight: 400; color: var(--ink-3); }
  .pk-coverage { margin: 1rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .pk-coverage li { border-bottom: 1px solid var(--line); }
  .pk-coverage a {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0.25rem;
    text-decoration: none;
  }
  .pk-coverage a:hover .pk-title { text-decoration: underline; }
  .pk-outlet { font-weight: 700; }
  .pk-title { color: var(--ink-2); }
  .pk-coverage time { font-size: 0.8125rem; color: var(--ink-3); white-space: nowrap; }
  @media (max-width: 900px) {
    .pk { grid-template-columns: 1fr; }
    .pk-side { position: static; }
  }
  @media (max-width: 600px) {
    .pk-assets { grid-template-columns: 1fr; }
    .pk-asset--wide { grid-template-columns: 1fr; }
    .pk-coverage a { grid-template-columns: 1fr; gap: 0.125rem; }
  }
</style>
