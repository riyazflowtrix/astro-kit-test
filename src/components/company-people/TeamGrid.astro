---
---

<section id="team-grid" class="section team-grid">
  <!-- kit: team-grid -->
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">The crew</span>
      <h2>Forty people, one foundry</h2>
      <p class="lead">We cast, finish and ship every pan from Bend, Oregon — and answer your emails from the same building.</p>
    </header>

    <div class="tgr-tabs" role="group" aria-label="Filter by department">
      <button type="button" class="tgr-tab" data-filter="all" aria-pressed="true">Everyone</button>
      <button type="button" class="tgr-tab" data-filter="leadership" aria-pressed="false">Leadership</button>
      <button type="button" class="tgr-tab" data-filter="workshop" aria-pressed="false">Workshop</button>
      <button type="button" class="tgr-tab" data-filter="design" aria-pressed="false">Design</button>
      <button type="button" class="tgr-tab" data-filter="marketing" aria-pressed="false">Marketing</button>
      <button type="button" class="tgr-tab" data-filter="care" aria-pressed="false">Customer care</button>
    </div>

    <ul class="tgr-grid photo-mono" role="list">
      <li class="tgr-card" data-dept="leadership">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=1" alt="Ana Vidal" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Has cooked an egg on every pan we've ever cast.</p>
        </div>
        <h3>Ana Vidal</h3>
        <p class="tgr-role">Co-founder & CEO</p>
        <p class="tgr-meta"><span class="tgr-dept">Leadership</span> · Bend, OR</p>
      </li>
      <li class="tgr-card" data-dept="workshop">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=12" alt="Luis Ortega" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Restores 1940s motorcycles on weekends.</p>
        </div>
        <h3>Luis Ortega</h3>
        <p class="tgr-role">Co-founder & head of workshop</p>
        <p class="tgr-meta"><span class="tgr-dept">Workshop</span> · Bend, OR</p>
      </li>
      <li class="tgr-card" data-dept="workshop">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=9" alt="Marisol Chen" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Can tell iron temperature by colour to within 20°F.</p>
        </div>
        <h3>Marisol Chen</h3>
        <p class="tgr-role">Lead caster</p>
        <p class="tgr-meta"><span class="tgr-dept">Workshop</span> · Bend, OR</p>
      </li>
      <li class="tgr-card" data-dept="workshop">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=15" alt="Dev Patel" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Makes his own carbon steel knives.</p>
        </div>
        <h3>Dev Patel</h3>
        <p class="tgr-role">Finishing technician</p>
        <p class="tgr-meta"><span class="tgr-dept">Workshop</span> · Bend, OR</p>
      </li>
      <li class="tgr-card" data-dept="marketing">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=44" alt="Rosa Lindgren" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Ran a food truck for six years.</p>
        </div>
        <h3>Rosa Lindgren</h3>
        <p class="tgr-role">Press & community</p>
        <p class="tgr-meta"><span class="tgr-dept">Marketing</span> · Portland, OR</p>
      </li>
      <li class="tgr-card" data-dept="design">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=53" alt="Kofi Mensah" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Sketched the Cable Fold on a napkin at a trailhead.</p>
        </div>
        <h3>Kofi Mensah</h3>
        <p class="tgr-role">Product designer</p>
        <p class="tgr-meta"><span class="tgr-dept">Design</span> · Bend, OR</p>
      </li>
      <li class="tgr-card" data-dept="care">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=26" alt="Hana Sato" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Answers about 60 emails a day, all with a recipe tip.</p>
        </div>
        <h3>Hana Sato</h3>
        <p class="tgr-role">Customer care lead</p>
        <p class="tgr-meta"><span class="tgr-dept">Customer care</span> · Remote, US</p>
      </li>
      <li class="tgr-card" data-dept="care">
        <div class="tgr-photo">
          <img src="https://i.pravatar.cc/400?img=59" alt="Jake Morrison" width="400" height="400" loading="lazy" />
          <p class="tgr-fact"><span class="visually-hidden">Fun fact: </span>Packs 400 boxes on a busy day and still ties them with twine.</p>
        </div>
        <h3>Jake Morrison</h3>
        <p class="tgr-role">Warehouse & shipping</p>
        <p class="tgr-meta"><span class="tgr-dept">Customer care</span> · Bend, OR</p>
      </li>
      <li class="tgr-card tgr-hiring" data-dept="all">
        <div class="tgr-hiring-inner">
          <span class="tgr-hiring-icon" aria-hidden="true">+</span>
          <h3>This could be you</h3>
          <a class="btn btn-secondary" href="/careers" title="Careers">See open roles <span aria-hidden="true">→</span></a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .tgr-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tgr-tab {
    min-height: 38px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .tgr-tab[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .tgr-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tgr-card[hidden] { display: none; }
  .tgr-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-2);
    margin-bottom: 0.875rem;
  }
  .tgr-photo img { width: 100%; height: 100%; object-fit: cover; transition: filter 200ms ease, transform 300ms ease; }
  .photo-mono .tgr-photo img { filter: grayscale(1) contrast(1.05); }
  .tgr-fact {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 1rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #fff;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .tgr-card:hover .tgr-fact,
  .tgr-card:focus-within .tgr-fact { opacity: 1; transform: none; }
  .tgr-card:hover .tgr-photo img { filter: none; transform: scale(1.03); }
  .tgr-card h3 { font-size: 1.0625rem; margin-bottom: 0.125rem; }
  .tgr-role { margin: 0; color: var(--ink-2); font-size: 0.9375rem; }
  .tgr-meta { margin: 0.25rem 0 0; color: var(--ink-3); font-size: 0.8125rem; }
  .tgr-hiring-inner {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    aspect-ratio: 1 / 1;
    padding: 1.5rem;
    border: 2px dashed var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .tgr-hiring-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .tgr-hiring h3 { margin: 0; }
  @media (hover: none) {
    .tgr-fact { position: static; opacity: 1; transform: none; background: none; color: var(--ink-2); padding: 0.5rem 0 0; }
    .tgr-photo { overflow: visible; aspect-ratio: auto; background: none; }
    .tgr-photo img { aspect-ratio: 1 / 1; border-radius: var(--radius-lg); }
  }
  @media (max-width: 960px) { .tgr-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .tgr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 380px) { .tgr-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("team-grid");
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll(".tgr-tab"));
    var cards = Array.prototype.slice.call(root.querySelectorAll(".tgr-card"));
    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        var f = tab.getAttribute("data-filter");
        tabs.forEach(function (t) { t.setAttribute("aria-pressed", t === tab ? "true" : "false"); });
        cards.forEach(function (card) {
          var d = card.getAttribute("data-dept");
          card.hidden = !(f === "all" || d === "all" || d === f);
        });
      });
    });
  })();
</script>
