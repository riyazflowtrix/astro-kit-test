---
import Base from "../../layouts/Base.astro";
import HeroSplitMedia from "../../components/heroes/HeroSplitMedia.astro";
import HeroCenteredGradient from "../../components/heroes/HeroCenteredGradient.astro";
import HeroVideoFullbleed from "../../components/heroes/HeroVideoFullbleed.astro";
import HeroSlider from "../../components/heroes/HeroSlider.astro";
import HeroProduct from "../../components/heroes/HeroProduct.astro";
import HeroSearch from "../../components/heroes/HeroSearch.astro";
import HeroLeadForm from "../../components/heroes/HeroLeadForm.astro";
import HeroAppDownload from "../../components/heroes/HeroAppDownload.astro";
import HeroStats from "../../components/heroes/HeroStats.astro";
import HeroLogoWall from "../../components/heroes/HeroLogoWall.astro";
import HeroSplitTestimonial from "../../components/heroes/HeroSplitTestimonial.astro";
import HeroEvent from "../../components/heroes/HeroEvent.astro";
import HeroPersonalized from "../../components/heroes/HeroPersonalized.astro";
---

<Base title="Heroes" description="Split, centered, video, slider, product, search, lead-form, app, stats, logo-wall, testimonial, event and personalized heroes from the BetterCMS Kit.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kit library</span>
        <h1>Heroes</h1>
        <p class="lead">Thirteen ways to open a page, from a simple split layout to audience-targeted copy.</p>
      </div>
    </div>
  </section>

  <HeroSplitMedia />
  <HeroCenteredGradient />
  <HeroVideoFullbleed />
  <HeroSlider />
  <HeroProduct />
  <HeroSearch />
  <HeroLeadForm />
  <HeroAppDownload />
  <HeroStats />
  <HeroLogoWall />
  <HeroSplitTestimonial />
  <HeroEvent />
  <HeroPersonalized />
</Base>
