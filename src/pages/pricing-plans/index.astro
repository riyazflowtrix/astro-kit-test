---
import Base from "../../layouts/Base.astro";
import PricingTiersBillingToggle from "../../components/pricing-plans/PricingTiersBillingToggle.astro";
import PricingUsageCalculator from "../../components/pricing-plans/PricingUsageCalculator.astro";
import PricingFeatureMatrix from "../../components/pricing-plans/PricingFeatureMatrix.astro";
import PricingSinglePlanAddons from "../../components/pricing-plans/PricingSinglePlanAddons.astro";
import PricingEnterpriseCard from "../../components/pricing-plans/PricingEnterpriseCard.astro";
import PricingFaq from "../../components/pricing-plans/PricingFaq.astro";
import PricingAnnualSavingsBanner from "../../components/pricing-plans/PricingAnnualSavingsBanner.astro";
---

<Base title="Pricing & plans" description="Plan tables, calculators, feature matrices and billing FAQs from the BetterCMS Kit.">
  <section class="section kit-intro">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kit library</span>
        <h1>Pricing &amp; plans</h1>
        <p class="lead">Plan tables with billing switches, usage calculators, feature matrices, add-ons and billing FAQs.</p>
      </div>
    </div>
  </section>

  <PricingTiersBillingToggle />
  <PricingUsageCalculator />
  <PricingFeatureMatrix />
  <PricingSinglePlanAddons />
  <PricingEnterpriseCard />
  <PricingFaq />
  <PricingAnnualSavingsBanner />
</Base>

<style>
  .kit-intro { padding-bottom: 0; }
</style>
